    {
      "path": "application/artemis/artemis-blog-index.tsx",
      "type": "registry:component",
      "target": "@components/application/artemis/artemis-blog-index.tsx",
      "content": "\"use client\";\nimport { ArtemisScope } from \"./artemis-scope\";\nimport View0 from \"./components/blog-pages/variants/01-index\";\nimport View1 from \"./components/blog-pages/variants/02-rounded-index\";\nconst variants = {\"index\":View0,\"rounded-index\":View1};\nexport interface ArtemisBlogIndexProps { className?: string; variant?: \"index\" | \"rounded-index\"; }\nexport function ArtemisBlogIndex({ className, variant = \"index\" }: ArtemisBlogIndexProps) {const View = variants[variant];return <ArtemisScope className={className}><div className=\"art:flex art:w-full art:min-w-0 art:flex-col art:items-center\"><View/></div></ArtemisScope>;}\n"
    },
    {
      "path": "application/artemis/components/blog-pages/variants/01-index.tsx",
      "type": "registry:component",
      "target": "@components/application/artemis/components/blog-pages/variants/01-index.tsx",
      "content": "\"use client\";\n// @zeus-internal\nimport { motion, useReducedMotion } from \"motion/react\";\nimport { useState } from \"react\";\nimport { ArtemisSegmentedTabs } from \"../../../foundations/segmented-tabs\";\nimport { ARTEMIS_EASE_OUT, ARTEMIS_SPRING_PRESS } from \"../../../lib/ease\";\nimport { stories } from \"./01-index/stories\";\nexport default function BlogPagesIndex() {\n    const reduce = useReducedMotion();\n    const [category, setCategory] = useState(\"All\");\n    const reveal = { initial: reduce ? false as const : { opacity: 0, y: 14 }, whileInView: { opacity: 1, y: 0 }, viewport: { once: true, margin: \"-60px\" }, transition: { duration: reduce ? 0 : 0.45, ease: ARTEMIS_EASE_OUT } };\n    return (<>\n      <div className=\"art:min-h-screen art:w-full art:bg-background art:font-sans art:text-foreground\">\n        <main id=\"blog-top\">\n          <section className=\"art:mx-auto art:w-full art:max-w-6xl art:px-4 art:py-14 art:@min-[640px]/artemis:px-8 art:@min-[640px]/artemis:py-20\">\n            <motion.div className=\"art:mx-auto art:flex art:max-w-4xl art:flex-col art:items-center art:gap-5 art:text-center\" initial={reveal.initial} animate={{ opacity: 1, y: 0 }} transition={reveal.transition}>\n              <p className=\"art:font-medium art:text-muted-foreground art:text-sm\">\n                {\"Independent stories about everyday life\"}\n              </p>\n              <h1 className=\"art:text-balance art:tracking-[-0.035em] art:text-4xl art:@min-[768px]/artemis:text-5xl art:font-medium\">\n                {\"Pay attention to what stays with you.\"}\n              </h1>\n              <p className=\"art:mx-auto art:max-w-2xl art:text-pretty art:text-sm art:text-muted-foreground art:leading-7 art:@min-[640px]/artemis:text-base\">\n                {\"A quiet journal about places, people, and the small rituals that make a day feel like your own.\"}\n              </p>\n            </motion.div>\n          </section>\n          <motion.section aria-labelledby=\"featured-story\" className=\"art:px-4 art:@min-[640px]/artemis:px-8\" {...reveal}>\n            <a href=\"#article\" className=\"art:group art:mx-auto art:grid art:w-full art:max-w-6xl art:overflow-hidden art:rounded-2xl art:border art:border-border art:bg-background art:p-2 art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-foreground art:@min-[768px]/artemis:grid-cols-[0.9fr_1.1fr]\">\n              <div className=\"art:aspect-[16/10] art:overflow-hidden art:rounded-lg art:@min-[768px]/artemis:aspect-auto art:@min-[768px]/artemis:h-96\">\n                <motion.img whileHover={reduce ? undefined : { scale: 1.025 }} transition={{ duration: 0.45, ease: ARTEMIS_EASE_OUT }} src=\"/assets/artemis/16585090b4f1acf6efb9.avif\" alt=\"A quiet cafe interior lit by tall windows\" width=\"1800\" height=\"1350\" className=\"art:h-full art:w-full art:object-cover\"/>\n              </div>\n              <div className=\"art:flex art:flex-col art:justify-between art:p-7 art:@min-[640px]/artemis:p-10 art:@min-[1024px]/artemis:p-14\">\n                <div>\n                  <p className=\"art:font-medium art:text-muted-foreground art:text-xs art:uppercase art:tracking-[0.14em]\">\n                    {\"Featured / \"}\n                    {\"Places\"}\n                  </p>\n                  <h2 id=\"featured-story\" className=\"art:mt-5 art:text-balance art:leading-tight art:tracking-[-0.045em] art:text-4xl art:font-medium\">\n                    {\"A week without an itinerary\"}\n                  </h2>\n                  <p className=\"art:mt-5 art:max-w-lg art:text-pretty art:text-muted-foreground art:leading-7\">\n                    {\"What changed when we stopped collecting recommendations and started following the shape of each day.\"}\n                  </p>\n                </div>\n                <div className=\"art:mt-12 art:flex art:items-end art:justify-between art:gap-6\">\n                  <p className=\"art:text-sm\">\n                    {\"Casey Ellis\"}\n                    <span className=\"art:text-muted-foreground\">\n                      {\" \"}\n                      {\"/ \"}\n                      {\"7 min read\"}\n                    </span>\n                  </p>\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-arrow-right art:size-5 art:transition-transform art:duration-300 art:group-hover:translate-x-1\" aria-hidden=\"true\">\n                    <path d=\"M5 12h14\"/>\n                    <path d=\"m12 5 7 7-7 7\"/>\n                  </svg>\n                </div>\n              </div>\n            </a>\n          </motion.section>\n          <section id=\"stories\" className=\"art:mx-auto art:w-full art:max-w-6xl art:px-4 art:py-14 art:@min-[640px]/artemis:px-8 art:@min-[640px]/artemis:py-20\">\n            <div className=\"art:flex art:flex-col art:justify-between art:gap-6 art:@min-[640px]/artemis:flex-row art:@min-[640px]/artemis:items-end\">\n              <div>\n                <p className=\"art:text-muted-foreground art:text-sm\">\n                  {\"The latest\"}\n                </p>\n                <h2 className=\"art:mt-1 art:font-medium art:text-4xl art:tracking-[-0.035em]\">\n                  {\"Recent stories\"}\n                </h2>\n              </div>\n              <div>\n                <ArtemisSegmentedTabs items={[\"All\", \"Places\", \"Food\", \"People\"].map(value => ({ value, label: value }))} value={category} onValueChange={setCategory} ariaLabel=\"Filter stories\" listClassName=\"art:items-center art:gap-1 art:rounded-full art:flex art:flex-wrap art:bg-muted art:p-0\" buttonClassName=\"art:rounded-full art:min-h-10 art:px-4 art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-foreground art:focus-visible:ring-offset-2 art:focus-visible:ring-offset-background\"/>\n              </div>\n            </div>\n            <motion.div layout className=\"art:grid art:gap-x-6 art:gap-y-12 art:pt-8 art:@min-[768px]/artemis:grid-cols-2 art:@min-[1024px]/artemis:grid-cols-3\">\n              {stories.filter(story => category === \"All\" || category === story.category).map((story, index) => (<motion.article key={stories.indexOf(story)} layout className=\"art:group\" {...reveal} transition={{ duration: reduce ? 0 : 0.45, ease: ARTEMIS_EASE_OUT, delay: index * 0.04 }} whileHover={reduce ? undefined : { transform: \"translateY(-4px)\" }}>\n                  {story.content}\n                </motion.article>))}\n            </motion.div>\n          </section>\n          <section id=\"newsletter\" className=\"art:px-4 art:pb-16 art:@min-[640px]/artemis:px-8 art:@min-[640px]/artemis:pb-20\">\n            <div className=\"art:mx-auto art:flex art:w-full art:max-w-6xl art:flex-col art:items-start art:justify-between art:gap-7 art:rounded-2xl art:border art:border-border art:bg-background art:p-6 art:@min-[640px]/artemis:p-9 art:@min-[768px]/artemis:flex-row art:@min-[768px]/artemis:items-center\">\n              <div>\n                <p className=\"art:text-muted-foreground art:text-sm\">\n                  {\"A note on Sundays\"}\n                </p>\n                <h2 className=\"art:mt-2 art:text-balance art:font-medium art:text-4xl art:tracking-[-0.035em]\">\n                  {\"One good story, delivered quietly.\"}\n                </h2>\n              </div>\n              <motion.a whileHover={reduce ? undefined : { scale: 1.01 }} whileTap={reduce ? undefined : { scale: 0.99 }} transition={ARTEMIS_SPRING_PRESS} className=\"art:inline-flex art:items-center art:justify-center art:font-medium art:select-none art:transition-colors art:disabled:pointer-events-none art:disabled:opacity-50 art:bg-primary art:text-primary-foreground art:hover:bg-primary/90 art:h-12 art:gap-2 art:px-6 art:text-base art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-ring art:focus-visible:ring-offset-2 art:focus-visible:ring-offset-background art:rounded-full\" href=\"#blog-top\" tabIndex={0}>\n                {\"Join the journal\"}\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-mail art:size-4\" aria-hidden=\"true\">\n                  <path d=\"m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7\"/>\n                  <rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"/>\n                </svg>\n              </motion.a>\n            </div>\n          </section>\n        </main>\n      </div>\n    </>);\n}\n"
    },
    {
      "path": "application/artemis/components/blog-pages/variants/01-index/stories.tsx",
      "type": "registry:component",
      "target": "@components/application/artemis/components/blog-pages/variants/01-index/stories.tsx",
      "content": "// @zeus-internal\nimport { motion, useReducedMotion, type HTMLMotionProps } from \"motion/react\";\nimport { ARTEMIS_EASE_OUT } from \"../../../../lib/ease\";\nfunction StoryImage(props: HTMLMotionProps<\"img\">) {\n    const reduce = useReducedMotion();\n    return <motion.img {...props} whileHover={reduce ? undefined : { scale: 1.025 }} transition={{ duration: 0.45, ease: ARTEMIS_EASE_OUT }}/>;\n}\nexport const stories = [\n    { category: \"Food\", content: (<> <a href=\"#article\" className=\"art:block art:h-full art:rounded-2xl art:border art:border-border art:bg-background art:p-2 art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-foreground art:focus-visible:ring-offset-4 art:focus-visible:ring-offset-background\">\n                  <div className=\"art:aspect-[4/3] art:overflow-hidden art:rounded-lg\">\n                    <StoryImage src=\"/assets/artemis/ef091272f545f02933c6.avif\" alt=\"A warm oak kitchen prepared for afternoon service\" width=\"1200\" height=\"900\" loading=\"lazy\" className=\"art:h-full art:w-full art:object-cover\"/>\n                  </div>\n                  <div className=\"art:px-3 art:pt-5 art:pb-3\">\n                    <p className=\"art:font-medium art:text-muted-foreground art:text-xs art:uppercase art:tracking-[0.13em]\">\n                      {\"Food\"}\n                      {\" / \"}\n                      {\"5 min read\"}\n                    </p>\n                    <h3 className=\"art:mt-3 art:text-balance art:font-medium art:text-xl art:leading-tight art:tracking-[-0.035em]\">\n                      {\"The kitchen at four in the afternoon\"}\n                    </h3>\n                    <p className=\"art:mt-3 art:text-pretty art:text-muted-foreground art:leading-6\">\n                      {\"Three cooks on prep, a radio just loud enough, and the quiet work behind a busy dinner room.\"}\n                    </p>\n                    <p className=\"art:mt-5 art:flex art:items-center art:gap-2 art:font-medium art:text-sm\">\n                      {\"Read story\"}\n                      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-arrow-right art:size-4 art:transition-transform art:duration-300 art:group-hover:translate-x-1\" aria-hidden=\"true\">\n                        <path d=\"M5 12h14\"/>\n                        <path d=\"m12 5 7 7-7 7\"/>\n                      </svg>\n                    </p>\n                  </div>\n                </a> </>) },\n    { category: \"People\", content: (<> <a href=\"#article\" className=\"art:block art:h-full art:rounded-2xl art:border art:border-border art:bg-background art:p-2 art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-foreground art:focus-visible:ring-offset-4 art:focus-visible:ring-offset-background\">\n                  <div className=\"art:aspect-[4/3] art:overflow-hidden art:rounded-lg\">\n                    <StoryImage src=\"/assets/artemis/37d6ad7de3fdb7597cd1.avif\" alt=\"A warmly lit independent bookstore\" width=\"1200\" height=\"900\" loading=\"lazy\" className=\"art:h-full art:w-full art:object-cover\"/>\n                  </div>\n                  <div className=\"art:px-3 art:pt-5 art:pb-3\">\n                    <p className=\"art:font-medium art:text-muted-foreground art:text-xs art:uppercase art:tracking-[0.13em]\">\n                      {\"People\"}\n                      {\" / \"}\n                      {\"6 min read\"}\n                    </p>\n                    <h3 className=\"art:mt-3 art:text-balance art:font-medium art:text-xl art:leading-tight art:tracking-[-0.035em]\">\n                      {\"Keeping a small shop\"}\n                    </h3>\n                    <p className=\"art:mt-3 art:text-pretty art:text-muted-foreground art:leading-6\">\n                      {\"A conversation about regulars, useful objects, and knowing when the shelves have enough.\"}\n                    </p>\n                    <p className=\"art:mt-5 art:flex art:items-center art:gap-2 art:font-medium art:text-sm\">\n                      {\"Read story\"}\n                      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-arrow-right art:size-4 art:transition-transform art:duration-300 art:group-hover:translate-x-1\" aria-hidden=\"true\">\n                        <path d=\"M5 12h14\"/>\n                        <path d=\"m12 5 7 7-7 7\"/>\n                      </svg>\n                    </p>\n                  </div>\n                </a> </>) },\n    { category: \"Places\", content: (<> <a href=\"#article\" className=\"art:block art:h-full art:rounded-2xl art:border art:border-border art:bg-background art:p-2 art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-foreground art:focus-visible:ring-offset-4 art:focus-visible:ring-offset-background\">\n                  <div className=\"art:aspect-[4/3] art:overflow-hidden art:rounded-lg\">\n                    <StoryImage src=\"/assets/artemis/00f08a1b00c26bee6c90.avif\" alt=\"A sunlit room overlooking the coast\" width=\"1200\" height=\"900\" loading=\"lazy\" className=\"art:h-full art:w-full art:object-cover\"/>\n                  </div>\n                  <div className=\"art:px-3 art:pt-5 art:pb-3\">\n                    <p className=\"art:font-medium art:text-muted-foreground art:text-xs art:uppercase art:tracking-[0.13em]\">\n                      {\"Places\"}\n                      {\" / \"}\n                      {\"4 min read\"}\n                    </p>\n                    <h3 className=\"art:mt-3 art:text-balance art:font-medium art:text-xl art:leading-tight art:tracking-[-0.035em]\">\n                      {\"The long way to the water\"}\n                    </h3>\n                    <p className=\"art:mt-3 art:text-pretty art:text-muted-foreground art:leading-6\">\n                      {\"One coastal path, two wrong turns, and a late lunch worth arriving hungry for.\"}\n                    </p>\n                    <p className=\"art:mt-5 art:flex art:items-center art:gap-2 art:font-medium art:text-sm\">\n                      {\"Read story\"}\n                      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-arrow-right art:size-4 art:transition-transform art:duration-300 art:group-hover:translate-x-1\" aria-hidden=\"true\">\n                        <path d=\"M5 12h14\"/>\n                        <path d=\"m12 5 7 7-7 7\"/>\n                      </svg>\n                    </p>\n                  </div>\n                </a> </>) },\n    { category: \"Food\", content: (<> <a href=\"#article\" className=\"art:block art:h-full art:rounded-2xl art:border art:border-border art:bg-background art:p-2 art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-foreground art:focus-visible:ring-offset-4 art:focus-visible:ring-offset-background\">\n                  <div className=\"art:aspect-[4/3] art:overflow-hidden art:rounded-lg\">\n                    <StoryImage src=\"/assets/artemis/0fa3094a5a49b43eda46.avif\" alt=\"A long shared table in a quiet studio\" width=\"1200\" height=\"900\" loading=\"lazy\" className=\"art:h-full art:w-full art:object-cover\"/>\n                  </div>\n                  <div className=\"art:px-3 art:pt-5 art:pb-3\">\n                    <p className=\"art:font-medium art:text-muted-foreground art:text-xs art:uppercase art:tracking-[0.13em]\">\n                      {\"Food\"}\n                      {\" / \"}\n                      {\"8 min read\"}\n                    </p>\n                    <h3 className=\"art:mt-3 art:text-balance art:font-medium art:text-xl art:leading-tight art:tracking-[-0.035em]\">\n                      {\"Notes on a shared table\"}\n                    </h3>\n                    <p className=\"art:mt-3 art:text-pretty art:text-muted-foreground art:leading-6\">\n                      {\"Why the best meals often begin before anyone sits down and continue after the plates are cleared.\"}\n                    </p>\n                    <p className=\"art:mt-5 art:flex art:items-center art:gap-2 art:font-medium art:text-sm\">\n                      {\"Read story\"}\n                      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-arrow-right art:size-4 art:transition-transform art:duration-300 art:group-hover:translate-x-1\" aria-hidden=\"true\">\n                        <path d=\"M5 12h14\"/>\n                        <path d=\"m12 5 7 7-7 7\"/>\n                      </svg>\n                    </p>\n                  </div>\n                </a> </>) },\n    { category: \"People\", content: (<> <a href=\"#article\" className=\"art:block art:h-full art:rounded-2xl art:border art:border-border art:bg-background art:p-2 art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-foreground art:focus-visible:ring-offset-4 art:focus-visible:ring-offset-background\">\n                  <div className=\"art:aspect-[4/3] art:overflow-hidden art:rounded-lg\">\n                    <StoryImage src=\"/assets/artemis/030144853a0cfe1b7112.avif\" alt=\"A florist arranging bouquets at a market stall\" width=\"1200\" height=\"900\" loading=\"lazy\" className=\"art:h-full art:w-full art:object-cover\"/>\n                  </div>\n                  <div className=\"art:px-3 art:pt-5 art:pb-3\">\n                    <p className=\"art:font-medium art:text-muted-foreground art:text-xs art:uppercase art:tracking-[0.13em]\">\n                      {\"People\"}\n                      {\" / \"}\n                      {\"5 min read\"}\n                    </p>\n                    <h3 className=\"art:mt-3 art:text-balance art:font-medium art:text-xl art:leading-tight art:tracking-[-0.035em]\">\n                      {\"Mornings with Sana\"}\n                    </h3>\n                    <p className=\"art:mt-3 art:text-pretty art:text-muted-foreground art:leading-6\">\n                      {\"The florist opens before the street wakes up. We joined her for the first quiet hour.\"}\n                    </p>\n                    <p className=\"art:mt-5 art:flex art:items-center art:gap-2 art:font-medium art:text-sm\">\n                      {\"Read story\"}\n                      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-arrow-right art:size-4 art:transition-transform art:duration-300 art:group-hover:translate-x-1\" aria-hidden=\"true\">\n                        <path d=\"M5 12h14\"/>\n                        <path d=\"m12 5 7 7-7 7\"/>\n                      </svg>\n                    </p>\n                  </div>\n                </a> </>) },\n    { category: \"Places\", content: (<> <a href=\"#article\" className=\"art:block art:h-full art:rounded-2xl art:border art:border-border art:bg-background art:p-2 art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-foreground art:focus-visible:ring-offset-4 art:focus-visible:ring-offset-background\">\n                  <div className=\"art:aspect-[4/3] art:overflow-hidden art:rounded-lg\">\n                    <StoryImage src=\"/assets/artemis/fbba564395c7ed7f3038.avif\" alt=\"An artisan shaping clay by hand at a worktable\" width=\"1200\" height=\"900\" loading=\"lazy\" className=\"art:h-full art:w-full art:object-cover\"/>\n                  </div>\n                  <div className=\"art:px-3 art:pt-5 art:pb-3\">\n                    <p className=\"art:font-medium art:text-muted-foreground art:text-xs art:uppercase art:tracking-[0.13em]\">\n                      {\"Places\"}\n                      {\" / \"}\n                      {\"6 min read\"}\n                    </p>\n                    <h3 className=\"art:mt-3 art:text-balance art:font-medium art:text-xl art:leading-tight art:tracking-[-0.035em]\">\n                      {\"One room, three generations\"}\n                    </h3>\n                    <p className=\"art:mt-3 art:text-pretty art:text-muted-foreground art:leading-6\">\n                      {\"Inside a family workshop where every tool has a place and every mark carries a memory.\"}\n                    </p>\n                    <p className=\"art:mt-5 art:flex art:items-center art:gap-2 art:font-medium art:text-sm\">\n                      {\"Read story\"}\n                      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-arrow-right art:size-4 art:transition-transform art:duration-300 art:group-hover:translate-x-1\" aria-hidden=\"true\">\n                        <path d=\"M5 12h14\"/>\n                        <path d=\"m12 5 7 7-7 7\"/>\n                      </svg>\n                    </p>\n                  </div>\n                </a> </>) }\n];\n"
    },
    {
      "path": "application/artemis/components/blog-pages/variants/02-rounded-index.tsx",
