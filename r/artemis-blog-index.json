emis:pb-24\">\n            <motion.div className=\"art:mx-auto art:flex art:w-full art:max-w-6xl art:flex-col art:items-center art:gap-7 art:rounded-3xl art:border art:border-border/60 art:bg-background art:p-8 art:text-center art:@min-[640px]/artemis:p-12\" {...reveal}>\n              <div className=\"art:flex art:max-w-2xl art:flex-col art:items-center\">\n                <p className=\"art:text-muted-foreground art:text-sm\">\n                  {\"Every other Sunday\"}\n                </p>\n                <h2 className=\"art:mt-2 art:text-balance art:font-medium art:text-4xl art:tracking-[-0.035em]\">\n                  {\"One thoughtful story for your morning.\"}\n                </h2>\n              </div>\n              <form className=\"art:flex art:w-full art:max-w-xl art:flex-col art:gap-3 art:@min-[640px]/artemis:flex-row\" onSubmit={event => event.preventDefault()}>\n                <div className=\"art:flex art:flex-col art:gap-1.5 art:w-full art:flex-1\">\n                  <div data-state={focused ? \"focused\" : \"idle\"} className={`art:relative art:h-10 art:overflow-hidden art:rounded-full art:border art:bg-background art:transition-colors art:duration-200 ${focused ? \"art:border-foreground/60\" : \"art:border-border\"}`}>\n                    <input id={`${artemisInstanceId}-R_3a9bsnpfdb_`} type=\"email\" aria-label=\"Email address\" required autoComplete=\"email\" placeholder=\"Email address\" className=\"art:peer art:h-full art:w-full art:bg-transparent art:text-foreground art:caret-foreground art:outline-none art:px-5 art:text-base art:placeholder:text-muted-foreground\" name=\"email\" value={email} onChange={event => setEmail(event.currentTarget.value)} onFocus={() => setFocused(true)} onBlur={() => setFocused(false)}/>\n                  </div>\n                  <div className=\"art:contents\"/>\n                </div>\n                <ArtemisButton whileTap={reduce ? undefined : { scale: 0.96 }} type=\"submit\" size=\"lg\" className=\"ar