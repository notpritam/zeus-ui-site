      "target": "@components/application/artemis/artemis-changelog.tsx",
      "content": "\"use client\";\nimport { ArtemisScope } from \"./artemis-scope\";\nimport View2 from \"./components/changelog-pages/variants/03-simple\";\nconst variants = {\"simple\":View2};\nexport interface ArtemisChangelogProps { className?: string; variant?: \"simple\"; }\nexport function ArtemisChangelog({ className, variant = \"simple\" }: ArtemisChangelogProps) {const View = variants[variant];return <ArtemisScope className={className}><div className=\"art:flex art:w-full art:min-w-0 art:flex-col art:items-center\"><View/></div></ArtemisScope>;}\n"
    },
    {
      "path": "application/artemis/components/changelog-pages/variants/03-simple.tsx",
      "type": "registry:component",
      "target": "@components/application/artemis/components/changelog-pages/variants/03-simple.tsx",
      "content": "\"use client\";\n// @zeus-internal\nimport { motion, type Transition, useReducedMotion } from \"motion/react\";\nimport { ARTEMIS_SPRING_LAYOUT, ARTEMIS_SPRING_PANEL, ARTEMIS_SPRING_PRESS } from \"../../../lib/ease\";\ntype Reveal = {\n    initial: {\n        opacity: number;\n        y: number;\n        filter?: string;\n    } | false;\n    animate: {\n        opacity: number;\n        y: number;\n        filter?: string;\n    };\n    transition: Transition;\n};\nconst D = {\n    eyebrow: 0.08,\n    title: 0.17,\n    lede: 0.28,\n    latest: 0.42,\n    previously: 0.62,\n    update: 0.73,\n    updateStep: 0.07,\n} as const;\nfunction useReveal() {\n    const reduce = useReducedMotion();\n    return (y: number, delay: number, spring: Transition, blur?: number): Reveal => ({\n        initial: reduce\n            ? false\n            : blur === undefined\n                ? { opacity: 0, y }\n                : { opacity: 0, y, filter: `blur(${blur}px)` },\n        animate: blur === undefined ? { opacity: 1, y: 0 } : { opacity: 1, y: 0, filter: \"blur(0px)\" },\n        transition: { ...spring, delay },\n    });\n}\nexport default function ChangelogPagesSimple() {\n    const reveal = useReveal();\n    const reduce = useReducedMotion();\n    return (<>\n      <div className=\"art:min-h-screen art:w-full art:bg-background art:font-sans art:text-foreground\">\n        <main id=\"simple-updates-top\">\n          <section className=\"art:mx-auto art:w-full art:max-w-5xl art:px-4 art:pt-16 art:pb-12 art:@min-[640px]/artemis:px-8 art:@min-[640px]/artemis:pt-24 art:@min-[640px]/artemis:pb-16\">\n            <motion.p className=\"art:font-medium art:text-muted-foreground art:text-sm\" {...reveal(10, D.eyebrow, ARTEMIS_SPRING_PANEL)}>\n              {\"What\\u2019s new\"}\n            </motion.p>\n            <motion.h1 className=\"art:mt-4 art:max-w-3xl art:text-balance art:leading-[1.05] art:tracking-[-0.05em] art:text-4xl art:@min-[768px]/artemis:text-5xl art:font-medium\" {...reveal(14, D.title, ARTEMIS_SPRING_PANEL, 4)}>\n              {\"Small changes that make planning feel easier.\"}\n            </motion.h1>\n            <motion.p className=\"art:mt-5 art:max-w-2xl art:text-pretty art:text-muted-foreground art:leading-7\" {...reveal(12, D.lede, ARTEMIS_SPRING_PANEL)}>\n              {\"New ways to plan together, keep the details close, and look back on the moments you shared.\"}\n            </motion.p>\n          </section>\n          <section className=\"art:mx-auto art:w-full art:max-w-5xl art:px-4 art:pb-14 art:@min-[640px]/artemis:px-8 art:@min-[640px]/artemis:pb-20\">\n            <motion.article className=\"art:grid art:gap-2 art:rounded-3xl art:bg-background art:p-2 art:@min-[768px]/artemis:grid-cols-[1.05fr_0.95fr]\" {...reveal(20, D.latest, ARTEMIS_SPRING_LAYOUT)}>\n              <div className=\"art:rounded-3xl art:bg-background art:p-5 art:@min-[640px]/artemis:p-8 art:@min-[1024px]/artemis:p-9\">\n                <div className=\"art:flex art:flex-wrap art:items-center art:gap-3\">\n                  <span className=\"art:rounded-full art:bg-muted art:px-3 art:py-1 art:font-medium art:text-xs\">\n                    {\"Latest update\"}\n                  </span>\n                  <p className=\"art:text-muted-foreground art:text-sm\">\n                    {\"July 8, 2026\"}\n                  </p>\n                </div>\n                <h2 className=\"art:mt-4 art:max-w-xl art:text-balance art:leading-tight art:tracking-[-0.04em] art:text-4xl art:font-medium\">\n                  {\"Monthly memories are ready when you are\"}\n                </h2>\n                <p className=\"art:mt-5 art:max-w-xl art:text-pretty art:text-muted-foreground art:leading-7\">\n                  {\"Morrow now gathers the photos and notes from your shared plans at the end of each month. Keep them private, make a few edits, or share the collection with everyone who was there.\"}\n                </p>\n                <ul className=\"art:mt-7 art:space-y-3 art:text-sm\">\n                  <li className=\"art:flex art:items-center art:gap-3\">\n                    <span className=\"art:grid art:size-5 art:shrink-0 art:place-items-center art:rounded-full art:bg-muted\">\n                      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-check art:size-3\" aria-hidden=\"true\">\n                        <path d=\"M20 6 9 17l-5-5\"/>\n                      </svg>\n                    </span>\n                    {\"Created from the plans you shared\"}\n                  </li>\n                  <li className=\"art:flex art:items-center art:gap-3\">\n                    <span className=\"art:grid art:size-5 art:shrink-0 art:place-items-center art:rounded-full art:bg-muted\">\n                      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-check art:size-3\" aria-hidden=\"true\">\n                        <path d=\"M20 6 9 17l-5-5\"/>\n                      </svg>\n                    </span>\n                    {\"Private until you decide otherwise\"}\n                  </li>\n                  <li className=\"art:flex art:items-center art:gap-3\">\n                    <span className=\"art:grid art:size-5 art:shrink-0 art:place-items-center art:rounded-full art:bg-muted\">\n                      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-check art:size-3\" aria-hidden=\"true\">\n                        <path d=\"M20 6 9 17l-5-5\"/>\n                      </svg>\n                    </span>\n                    {\"Easy to revisit and add to later\"}\n                  </li>\n                </ul>\n              </div>\n              <div className=\"art:grid art:min-h-80 art:place-items-center art:rounded-3xl art:bg-background art:p-5 art:@min-[640px]/artemis:p-8\">\n                <div className=\"art:w-full art:max-w-sm\">\n                  <div className=\"art:flex art:items-center art:justify-between\">\n                    <div>\n                      <p className=\"art:font-medium\">\n                        {\"June, together\"}\n                      </p>\n                      <p className=\"art:mt-1 art:text-muted-foreground art:text-sm\">\n                        {\"A month worth keeping\"}\n                      </p>\n                    </div>\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-heart art:size-5 art:text-muted-foreground\" aria-hidden=\"true\">\n                      <path d=\"M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5\"/>\n                    </svg>\n                  </div>\n                  <div className=\"art:mt-5 art:grid art:grid-cols-2 art:gap-3\">\n                    <span className=\"art:grid art:aspect-[4/3] art:place-items-center art:rounded-2xl art:bg-muted art:text-muted-foreground\">\n                      <span className=\"art:grid art:size-10 art:place-items-center art:rounded-full art:bg-background\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-map-pin art:size-5\" aria-hidden=\"true\">\n                          <path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"/>\n                          <circle cx=\"12\" cy=\"10\" r=\"3\"/>\n                        </svg>\n                      </span>\n                    </span>\n                    <span className=\"art:grid art:aspect-[4/3] art:place-items-center art:rounded-2xl art:bg-muted art:text-muted-foreground\">\n                      <span className=\"art:grid art:size-10 art:place-items-center art:rounded-full art:bg-background\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-users art:size-5\" aria-hidden=\"true\">\n                          <path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"/>\n                          <path d=\"M16 3.128a4 4 0 0 1 0 7.744\"/>\n                          <path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"/>\n                          <circle cx=\"9\" cy=\"7\" r=\"4\"/>\n                        </svg>\n                      </span>\n                    </span>\n                    <span className=\"art:col-span-2 art:grid art:aspect-[2/0.72] art:place-items-center art:rounded-2xl art:bg-muted art:text-muted-foreground\">\n                      <span className=\"art:grid art:size-10 art:place-items-center art:rounded-full art:bg-background\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-images art:size-5\" aria-hidden=\"true\">\n                          <path d=\"m22 11-1.296-1.296a2.4 2.4 0 0 0-3.408 0L11 16\"/>\n                          <path d=\"M4 8a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2\"/>\n                          <circle cx=\"13\" cy=\"7\" r=\"1\" fill=\"currentColor\"/>\n                          <rect x=\"8\" y=\"2\" width=\"14\" height=\"14\" rx=\"2\"/>\n                        </svg>\n                      </span>\n                    </span>\n                  </div>\n                </div>\n              </div>\n            </motion.article>\n          </section>\n          <section className=\"art:mx-auto art:w-full art:max-w-5xl art:px-4 art:pb-16 art:@min-[640px]/artemis:px-8 art:@min-[640px]/artemis:pb-24\">\n            <motion.div className=\"art:flex art:items-end art:justify-between art:gap-6 art:pb-5\" {...reveal(12, D.previously, ARTEMIS_SPRING_PANEL)}>\n              <div>\n                <p className=\"art:text-muted-foreground art:text-sm\">\n                  {\"Previously\"}\n                </p>\n                <h2 className=\"art:mt-1 art:tracking-[-0.03em] art:text-4xl art:font-medium\">\n                  {\"More useful changes\"}\n                </h2>\n              </div>\n            </motion.div>\n            <div className=\"art:space-y-2 art:rounded-3xl art:bg-background art:p-2\">\n              <motion.article className=\"art:grid art:gap-5 art:rounded-3xl art:bg-background art:p-5 art:@min-[640px]/artemis:grid-cols-[auto_8rem_1fr] art:@min-[640px]/artemis:items-start art:@min-[640px]/artemis:p-6\" {...reveal(14, D.update + 0 * D.updateStep, ARTEMIS_SPRING_LAYOUT)}>\n                <span className=\"art:grid art:size-10 art:place-items-center art:rounded-full art:bg-muted art:text-muted-foreground\">\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-calendar-days art:size-4\" aria-hidden=\"true\">\n                    <path d=\"M8 2v3\"/>\n                    <path d=\"M16 2v3\"/>\n                    <rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/>\n                    <path d=\"M3 9h18\"/>\n                    <path d=\"M8 13h.01\"/>\n                    <path d=\"M12 13h.01\"/>\n                    <path d=\"M16 13h.01\"/>\n                    <path d=\"M8 17h.01\"/>\n                    <path d=\"M12 17h.01\"/>\n                    <path d=\"M16 17h.01\"/>\n                  </svg>\n                </span>\n                <p className=\"art:pt-2 art:text-muted-foreground art:text-sm\">\n                  {\"June 26, 2026\"}\n                </p>\n                <div>\n                  <h3 className=\"art:tracking-[-0.025em] art:text-xl art:font-medium\">\n                    {\"Plans are easier to move\"}\n                  </h3>\n                  <p className=\"art:mt-2 art:max-w-2xl art:text-pretty art:text-muted-foreground art:text-sm art:leading-6\">\n                    {\"Change the time or place once and everyone sees the latest details. No need to send another message to the group.\"}\n                  </p>\n                </div>\n              </motion.article>\n              <motion.article className=\"art:grid art:gap-5 art:rounded-3xl art:bg-background art:p-5 art:@min-[640px]/artemis:grid-cols-[auto_8rem_1fr] art:@min-[640px]/artemis:items-start art:@min-[640px]/artemis:p-6\" {...reveal(14, D.update + 1 * D.updateStep, ARTEMIS_SPRING_LAYOUT)}>\n                <span className=\"art:grid art:size-10 art:place-items-center art:rounded-full art:bg-muted art:text-muted-foreground\">\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-users art:size-4\" aria-hidden=\"true\">\n                    <path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"/>\n                    <path d=\"M16 3.128a4 4 0 0 1 0 7.744\"/>\n                    <path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"/>\n                    <circle cx=\"9\" cy=\"7\" r=\"4\"/>\n                  </svg>\n                </span>\n                <p className=\"art:pt-2 art:text-muted-foreground art:text-sm\">\n                  {\"June 12, 2026\"}\n                </p>\n                <div>\n                  <h3 className=\"art:tracking-[-0.025em] art:text-xl art:font-medium\">\n                    {\"Shared lists feel more personal\"}\n                  </h3>\n                  <p className=\"art:mt-2 art:max-w-2xl art:text-pretty art:text-muted-foreground art:text-sm art:leading-6\">\n                    {\"Add a quick reaction to any item and see who added each note. Small details now stay with the list instead of getting lost in chat.\"}\n                  </p>\n                </div>\n              </motion.article>\n              <motion.article className=\"art:grid art:gap-5 art:rounded-3xl art:bg-background art:p-5 art:@min-[640px]/artemis:grid-cols-[auto_8rem_1fr] art:@min-[640px]/artemis:items-start art:@min-[640px]/artemis:p-6\" {...reveal(14, D.update + 2 * D.updateStep, ARTEMIS_SPRING_LAYOUT)}>\n                <span className=\"art:grid art:size-10 art:place-items-center art:rounded-full art:bg-muted art:text-muted-foreground\">\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-images art:size-4\" aria-hidden=\"true\">\n                    <path d=\"m22 11-1.296-1.296a2.4 2.4 0 0 0-3.408 0L11 16\"/>\n                    <path d=\"M4 8a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2\"/>\n                    <circle cx=\"13\" cy=\"7\" r=\"1\" fill=\"currentColor\"/>\n                    <rect x=\"8\" y=\"2\" width=\"14\" height=\"14\" rx=\"2\"/>\n                  </svg>\n                </span>\n                <p className=\"art:pt-2 art:text-muted-foreground art:text-sm\">\n                  {\"May 29, 2026\"}\n                </p>\n                <div>\n                  <h3 className=\"art:tracking-[-0.025em] art:text-xl art:font-medium\">\n                    {\"Your recent photos, in one place\"}\n                  </h3>\n                  <p className=\"art:mt-2 art:max-w-2xl art:text-pretty art:text-muted-foreground art:text-sm art:leading-6\">\n                    {\"Photos from shared plans are now collected automatically, so everyone can revisit and add to the same set afterward.\"}\n                  </p>\n                </div>\n              </motion.article>\n            </div>\n          </section>\n          <section id=\"simple-updates-mail\" className=\"art:px-4 art:pb-16 art:@min-[640px]/artemis:px-8 art:@min-[640px]/artemis:pb-24\">\n            <div className=\"art:mx-auto art:w-full art:max-w-5xl art:rounded-3xl art:bg-background art:p-2\">\n              <div className=\"art:flex art:flex-col art:items-start art:justify-between art:gap-7 art:rounded-3xl art:bg-background art:p-6 art:@min-[640px]/artemis:p-9 art:@min-[768px]/artemis:flex-row art:@min-[768px]/artemis:items-center\">\n                <div>\n                  <p className=\"art:text-muted-foreground art:text-sm\">\n                    {\"A note when it matters\"}\n                  </p>\n                  <h2 className=\"art:mt-2 art:text-balance art:tracking-[-0.03em] art:text-4xl art:font-medium\">\n                    {\"Get the next useful update by email.\"}\n                  </h2>\n                </div>\n                <motion.a className=\"art:inline-flex art:items-center art:justify-center art:font-medium art:select-none art:transition-colors art:disabled:pointer-events-none art:disabled:opacity-50 art:bg-primary art:text-primary-foreground art:hover:bg-primary/90 art:h-12 art:gap-2 art:px-6 art:text-base art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-ring art:focus-visible:ring-offset-2 art:focus-visible:ring-offset-background art:rounded-full\" href=\"#simple-updates-top\" tabIndex={0} whileHover={reduce ? undefined : { scale: 1.01 }} whileTap={reduce ? undefined : { scale: 0.99 }} transition={ARTEMIS_SPRING_PRESS}>\n                  {\"Subscribe\"}\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-arrow-right art:size-4\" aria-hidden=\"true\">\n                    <path d=\"M5 12h14\"/>\n                    <path d=\"m12 5 7 7-7 7\"/>\n                  </svg>\n                </motion.a>\n              </div>\n            </div>\n          </section>\n        </main>\n      </div>\n    </>);\n}\n"
    }
