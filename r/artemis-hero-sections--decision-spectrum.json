  "files": [
    {
      "path": "application/artemis/artemis-hero-sections.tsx",
      "type": "registry:component",
      "target": "@components/application/artemis/artemis-hero-sections.tsx",
      "content": "\"use client\";\nimport {ArtemisScope} from \"./artemis-scope\";\nimport type { ArtemisHeroContent } from \"./components/hero-sections/content\";\nimport View3 from \"./components/hero-sections/variants/04-decision-spectrum\";\nconst views={\"decision-spectrum\":View3};\nexport type { ArtemisHeroContent, ArtemisHeroCta, ArtemisHeroForm, ArtemisHeroImage, ArtemisHeroLink, ArtemisHeroLogo, ArtemisHeroNav, ArtemisHeroPrompt } from \"./components/hero-sections/content\";\nexport interface ArtemisHeroSectionsProps {className?:string;variant?:\"decision-spectrum\"; /** The words on the hero; anything left out keeps the layout's own copy. */ content?: Partial<ArtemisHeroContent>;}\nexport function ArtemisHeroSections({className,variant=\"decision-spectrum\",content}:ArtemisHeroSectionsProps){const View=views[variant];return <ArtemisScope className={`art:[&>*]:mx-auto ${className??\"\"}`}><View content={content}/></ArtemisScope>;}\n"
    },
    {
      "path": "application/artemis/components/hero-sections/content.ts",
      "type": "registry:component",
      "target": "@components/application/artemis/components/hero-sections/content.ts",
      "content": "// @zeus-internal\n\n/** The words on a link, and where it goes. */\nexport interface ArtemisHeroLink {\n  label: string;\n  href: string;\n}\n\n/** The words on a button, and where it links. */\nexport interface ArtemisHeroCta {\n  label: string;\n  /** Where it links. analytics-flow and ai-teammates use only the label: their buttons scroll to the demo and open its brief. */\n  href?: string;\n}\n\n/** An image, and the words that stand in for it (empty when it only decorates). */\nexport interface ArtemisHeroImage {\n  src: string;\n  alt: string;\n}\n\n/** A customer or partner, shown by name. */\nexport interface ArtemisHeroLogo {\n  name: string;\n}\n\n/** The bar across the top of the layouts that have their own. */\nexport interface ArtemisHeroNav {\n  /** The name beside the logo mark, and where it links. Every layout with a bar. */\n  brand: ArtemisHeroLink;\n  /** Links in the bar and its mobile menu. Every layout with a bar. */\n  links: ArtemisHeroLink[];\n  /** The sign-in link. decision-spectrum, ai-marketplace and signal-aurora; left out, they show none. */\n  login?: ArtemisHeroLink;\n  /** The button at the end of the bar. voice-mobile, decision-spectrum, defi-routing and ai-marketplace; left out, they show none. */\n  cta?: ArtemisHeroLink;\n  /** The button in the open mobile menu, where its words differ from `cta`. voice-mobile, decision-spectrum, defi-routing and ai-marketplace; left out, the menu shows `cta`. */\n  menuCta?: ArtemisHeroLink;\n}\n\n/** An email field and its button. */\nexport interface ArtemisHeroForm {\n  /** The field's label, read by screen readers. */\n  label: string;\n  /** The hint in the empty field. */\n  placeholder: string;\n  /** The button's words. */\n  submit: string;\n}\n\n/** A box where visitors describe what they need. */\nexport interface ArtemisHeroPrompt {\n  /** The small title over the box. */\n  title: string;\n  /** The field's name, read by screen readers. */\n  label: string;\n  /** Example requests that take turns in the empty box. */\n  examples: string[];\n  /** The send button's name, read by screen readers. */\n  submit: string;\n  /** The line shown once a request is sent. */\n  confirmation: string;\n  /** Requests under the box; choosing one fills it in. */\n  suggestions: string[];\n}\n\n/** The words on an Artemis hero. Every layout reads this shape, so you can switch layouts and keep them. */\nexport interface ArtemisHeroContent {\n  /** The hero's own bar with the brand, links and buttons. voice-mobile, decision-spectrum, defi-routing, ai-marketplace and signal-aurora. */\n  nav?: ArtemisHeroNav;\n  /** A short line over the headline. All layouts but decision-spectrum. */\n  badge?: string;\n  /** Small faces beside the badge; screen readers skip them. split-demo. */\n  avatars?: ArtemisHeroImage[];\n  /** The headline, or its first part where a layout splits it. All layouts. */\n  headline: string;\n  /** The rest of the headline. analytics-flow mutes it and decision-spectrum sets it bolder; ai-teammates, voice-mobile, defi-routing and ai-marketplace start it on a new line; signal-aurora and split-demo run it on after the headline. It goes with `headline`: give a headline without it and the headline shows on its own; leave both out to keep the layout's own. */\n  headlineAccent?: string;\n  /** The paragraph under the headline. All layouts. */\n  subhead: string;\n  /** The main button. analytics-flow, ai-teammates, voice-mobile, decision-spectrum, signal-aurora and split-demo. */\n  cta?: ArtemisHeroCta;\n  /** The second button. analytics-flow, ai-teammates, voice-mobile, decision-spectrum and split-demo. */\n  secondaryCta?: ArtemisHeroCta;\n  /** An email field and its button, in place of buttons. defi-routing. */\n  form?: ArtemisHeroForm;\n  /** A box for describing what you need, in place of buttons. ai-marketplace. */\n  prompt?: ArtemisHeroPrompt;\n  /** A short line under the buttons. analytics-flow, ai-teammates and defi-routing. */\n  note?: string;\n  /** Short points with a check mark, under the buttons; two look best. voice-mobile. */\n  points?: string[];\n  /** A line under the picture beside the words. ai-teammates. */\n  caption?: string;\n  /** The line over the logos. decision-spectrum and split-demo. */\n  logosTitle?: string;\n  /** Customers or partners, shown by name. decision-spectrum, signal-aurora and split-demo. */\n  logos?: ArtemisHeroLogo[];\n}\n"
    },
    {
      "path": "application/artemis/components/hero-sections/variants/04-decision-spectrum.tsx",
      "type": "registry:component",
      "target": "@components/application/artemis/components/hero-sections/variants/04-decision-spectrum.tsx",
      "content": "\"use client\";\nimport {useId} from \"react\";\n// @zeus-internal\nimport { AnimatePresence, motion, useReducedMotion } from \"motion/react\";\nimport {useState} from \"react\";\nimport { ArtemisSharedLayoutBg } from \"../../../foundations/shared-layout-bg\";\nimport { ARTEMIS_EASE_OUT, ARTEMIS_SPRING_PANEL } from \"../../../lib/ease\";\nimport { useArtemisDark } from \"../../../lib/use-dark\";\nimport type { ArtemisHeroContent, ArtemisHeroNav } from \"../content\";\nconst DEFAULT = {\n    nav: {\n        brand: { label: \"Workspace\", href: \"/\" },\n        links: [{ label: \"Product\", href: \"#product\" }, { label: \"Automations\", href: \"#automations\" }, { label: \"Customers\", href: \"#customers\" }, { label: \"Pricing\", href: \"#pricing\" }],\n        login: { label: \"Log in\", href: \"#login\" },\n        cta: { label: \"Start for free\", href: \"#product\" },\n    },\n    headline: \"Projects move faster.\",\n    headlineAccent: \"Teams stay in sync.\",\n    subhead: \"Workspace brings projects, docs, and automated handoffs into one shared workspace, so every team knows what is moving and what needs attention.\",\n    cta: { label: \"Start for free\", href: \"#product\" },\n    secondaryCta: { label: \"Watch product tour\", href: \"#product-tour\" },\n    logosTitle: \"Trusted by teams that ship every week\",\n    logos: [{ name: \"NORTH/CO\" }, { name: \"Team C\" }, { name: \"Team B\" }, { name: \"FORM\" }, { name: \"Team A\" }],\n} satisfies ArtemisHeroContent;\nconst AURORA = {\n    dark: { top: [\"oklch(0.82 0.16 155)\", \"0.94\"], mid: [\"oklch(0.58 0.1 158)\", \"0.48\"], edge: [\"oklch(0.12 0.02 155)\", \"0.2\"] },\n    light: { top: [\"oklch(0.74 0.14 155)\", \"0.88\"], mid: [\"oklch(0.7 0.11 158)\", \"0.7\"], edge: [\"oklch(0.35 0.06 155)\", \"0.12\"] },\n} as const;\nfunction rise(reduce: boolean | null, y: number, delay: number) {\n    return {\n        initial: reduce ? false : { opacity: 0, transform: `translateY(${y}px)` },\n        animate: { opacity: 1, transform: \"translateY(0px)\" },\n        transition: { duration: 0.7, delay, ease: ARTEMIS_EASE_OUT },\n    } as const;\n}\nexport default function HeroSectionsDecisionSpectrum({ content }: { content?: Partial<ArtemisHeroContent> } = {}) {\nconst copy = { ...DEFAULT, ...content };\nconst accent = content?.headline === undefined ? copy.headlineAccent : content.headlineAccent;\nconst nav: ArtemisHeroNav = copy.nav;\nconst menuCta = nav.menuCta ?? nav.cta;\nconst artemisInstanceId=useId();\n\n    const reduce = useReducedMotion();\n    const aurora = AURORA[useArtemisDark() ? \"dark\" : \"light\"];\n    const [open, setOpen] = useState(false);\n    return (<>\n      <section className=\"art:relative art:isolate art:min-h-[48rem] art:w-full art:overflow-hidden art:bg-background art:text-foreground art:@min-[640px]/artemis:min-h-[52rem]\">\n        <div className=\"art:pointer-events-none art:absolute art:inset-0 art:overflow-hidden\" aria-hidden=\"true\">\n          <svg className=\"art:absolute art:inset-x-0 art:bottom-0 art:h-[66%] art:w-full\" viewBox=\"0 0 20 1\" preserveAspectRatio=\"none\">\n            <title>\n              {\"Decorative aurora light field\"}\n            </title>\n            <defs>\n              <linearGradient id={`${artemisInstanceId}-gradient`} x1=\"0\" y1=\"1\" x2=\"0\" y2=\"0\">\n                <stop offset=\"0%\" stopColor={aurora.top[0]} stopOpacity={aurora.top[1]}/>\n                <stop offset=\"48%\" stopColor={aurora.mid[0]} stopOpacity={aurora.mid[1]}/>\n                <stop offset=\"100%\" stopColor=\"transparent\" stopOpacity=\"0\"/>\n              </linearGradient>\n              <linearGradient id={`${artemisInstanceId}-fade`} x1=\"0\" y1=\"1\" x2=\"0\" y2=\"0\">\n                <stop offset=\"0%\" stopColor=\"white\"/>\n                <stop offset=\"58%\" stopColor=\"white\" stopOpacity=\"0.9\"/>\n                <stop offset=\"100%\" stopColor=\"white\" stopOpacity=\"0\"/>\n              </linearGradient>\n              <linearGradient id={`${artemisInstanceId}-edge`} x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">\n                <stop offset=\"0%\" stopColor={aurora.edge[0]} stopOpacity={aurora.edge[1]}/>\n                <stop offset=\"100%\" stopColor=\"transparent\" stopOpacity=\"0\"/>\n              </linearGradient>\n              <mask id={`${artemisInstanceId}-mask`} x=\"0\" y=\"0\" width=\"20\" height=\"1\" maskUnits=\"userSpaceOnUse\" maskContentUnits=\"userSpaceOnUse\">\n                <rect x=\"0\" y=\"0.040000000000000036\" width=\"1\" height=\"0.96\" fill={`url(#${artemisInstanceId}-fade)`} shapeRendering=\"crispEdges\"/>\n                <rect x=\"1\" y=\"0.14500000000000002\" width=\"1\" height=\"0.855\" fill={`url(#${artemisInstanceId}-fade)`} shapeRendering=\"crispEdges\"/>\n                <rect x=\"2\" y=\"0.242\" width=\"1\" height=\"0.758\" fill={`url(#${artemisInstanceId}-fade)`} shapeRendering=\"crispEdges\"/>\n                <rect x=\"3\" y=\"0.33299999999999996\" width=\"1\" height=\"0.667\" fill={`url(#${artemisInstanceId}-fade)`} shapeRendering=\"crispEdges\"/>\n                <rect x=\"4\" y=\"0.41700000000000004\" width=\"1\" height=\"0.583\" fill={`url(#${artemisInstanceId}-fade)`} shapeRendering=\"crispEdges\"/>\n                <rect x=\"5\" y=\"0.493\" width=\"1\" height=\"0.507\" fill={`url(#${artemisInstanceId}-fade)`} shapeRendering=\"crispEdges\"/>\n                <rect x=\"6\" y=\"0.56\" width=\"1\" height=\"0.44\" fill={`url(#${artemisInstanceId}-fade)`} shapeRendering=\"crispEdges\"/>\n                <rect x=\"7\" y=\"0.617\" width=\"1\" height=\"0.383\" fill={`url(#${artemisInstanceId}-fade)`} shapeRendering=\"crispEdges\"/>\n                <rect x=\"8\" y=\"0.6619999999999999\" width=\"1\" height=\"0.338\" fill={`url(#${artemisInstanceId}-fade)`} shapeRendering=\"crispEdges\"/>\n                <rect x=\"9\" y=\"0.6930000000000001\" width=\"1\" height=\"0.307\" fill={`url(#${artemisInstanceId}-fade)`} shapeRendering=\"crispEdges\"/>\n                <rect x=\"10\" y=\"0.6930000000000001\" width=\"1\" height=\"0.307\" fill={`url(#${artemisInstanceId}-fade)`} shapeRendering=\"crispEdges\"/>\n                <rect x=\"11\" y=\"0.6619999999999999\" width=\"1\" height=\"0.338\" fill={`url(#${artemisInstanceId}-fade)`} shapeRendering=\"crispEdges\"/>\n                <rect x=\"12\" y=\"0.617\" width=\"1\" height=\"0.383\" fill={`url(#${artemisInstanceId}-fade)`} shapeRendering=\"crispEdges\"/>\n                <rect x=\"13\" y=\"0.56\" width=\"1\" height=\"0.44\" fill={`url(#${artemisInstanceId}-fade)`} shapeRendering=\"crispEdges\"/>\n                <rect x=\"14\" y=\"0.493\" width=\"1\" height=\"0.507\" fill={`url(#${artemisInstanceId}-fade)`} shapeRendering=\"crispEdges\"/>\n                <rect x=\"15\" y=\"0.41700000000000004\" width=\"1\" height=\"0.583\" fill={`url(#${artemisInstanceId}-fade)`} shapeRendering=\"crispEdges\"/>\n                <rect x=\"16\" y=\"0.33299999999999996\" width=\"1\" height=\"0.667\" fill={`url(#${artemisInstanceId}-fade)`} shapeRendering=\"crispEdges\"/>\n                <rect x=\"17\" y=\"0.242\" width=\"1\" height=\"0.758\" fill={`url(#${artemisInstanceId}-fade)`} shapeRendering=\"crispEdges\"/>\n                <rect x=\"18\" y=\"0.14500000000000002\" width=\"1\" height=\"0.855\" fill={`url(#${artemisInstanceId}-fade)`} shapeRendering=\"crispEdges\"/>\n                <rect x=\"19\" y=\"0.040000000000000036\" width=\"1\" height=\"0.96\" fill={`url(#${artemisInstanceId}-fade)`} shapeRendering=\"crispEdges\"/>\n              </mask>\n            </defs>\n            <rect width=\"20\" height=\"1\" fill={`url(#${artemisInstanceId}-gradient)`} mask={`url(#${artemisInstanceId}-mask)`}/>\n            <g mask={`url(#${artemisInstanceId}-mask)`}>\n              <rect x=\"1\" width=\"0.12\" height=\"1\" fill={`url(#${artemisInstanceId}-edge)`}/>\n              <rect x=\"2\" width=\"0.12\" height=\"1\" fill={`url(#${artemisInstanceId}-edge)`}/>\n              <rect x=\"3\" width=\"0.12\" height=\"1\" fill={`url(#${artemisInstanceId}-edge)`}/>\n              <rect x=\"4\" width=\"0.12\" height=\"1\" fill={`url(#${artemisInstanceId}-edge)`}/>\n              <rect x=\"5\" width=\"0.12\" height=\"1\" fill={`url(#${artemisInstanceId}-edge)`}/>\n              <rect x=\"6\" width=\"0.12\" height=\"1\" fill={`url(#${artemisInstanceId}-edge)`}/>\n              <rect x=\"7\" width=\"0.12\" height=\"1\" fill={`url(#${artemisInstanceId}-edge)`}/>\n              <rect x=\"8\" width=\"0.12\" height=\"1\" fill={`url(#${artemisInstanceId}-edge)`}/>\n              <rect x=\"9\" width=\"0.12\" height=\"1\" fill={`url(#${artemisInstanceId}-edge)`}/>\n              <rect x=\"10\" width=\"0.12\" height=\"1\" fill={`url(#${artemisInstanceId}-edge)`}/>\n              <rect x=\"11\" width=\"0.12\" height=\"1\" fill={`url(#${artemisInstanceId}-edge)`}/>\n              <rect x=\"12\" width=\"0.12\" height=\"1\" fill={`url(#${artemisInstanceId}-edge)`}/>\n              <rect x=\"13\" width=\"0.12\" height=\"1\" fill={`url(#${artemisInstanceId}-edge)`}/>\n              <rect x=\"14\" width=\"0.12\" height=\"1\" fill={`url(#${artemisInstanceId}-edge)`}/>\n              <rect x=\"15\" width=\"0.12\" height=\"1\" fill={`url(#${artemisInstanceId}-edge)`}/>\n              <rect x=\"16\" width=\"0.12\" height=\"1\" fill={`url(#${artemisInstanceId}-edge)`}/>\n              <rect x=\"17\" width=\"0.12\" height=\"1\" fill={`url(#${artemisInstanceId}-edge)`}/>\n              <rect x=\"18\" width=\"0.12\" height=\"1\" fill={`url(#${artemisInstanceId}-edge)`}/>\n              <rect x=\"19\" width=\"0.12\" height=\"1\" fill={`url(#${artemisInstanceId}-edge)`}/>\n            </g>\n          </svg>\n          <div className=\"art:absolute art:inset-x-0 art:top-0 art:h-[70%] art:bg-gradient-to-b art:from-background art:via-background/96 art:to-transparent\"/>\n        </div>\n        <nav className=\"art:relative art:z-30 art:mx-auto art:flex art:h-20 art:w-full art:max-w-7xl art:items-center art:justify-between art:px-5 art:@min-[640px]/artemis:h-24 art:@min-[640px]/artemis:px-8\">\n          <a href={nav.brand.href} className=\"art:flex art:min-h-10 art:items-center art:gap-2.5 art:rounded-full art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-current/30\" aria-label={`${nav.brand.label} home`}>\n            <span className=\"art:grid art:size-8 art:place-items-center art:rounded-full art:border art:border-border art:bg-muted\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-panels-top-left art:size-4\" aria-hidden=\"true\">\n                <rect width=\"18\" height=\"18\" x=\"3\" y=\"3\" rx=\"2\"/>\n                <path d=\"M3 9h18\"/>\n                <path d=\"M9 21V9\"/>\n              </svg>\n            </span>\n            <span className=\"art:font-semibold art:tracking-[-0.04em]\">\n              {nav.brand.label}\n            </span>\n          </a>\n          <div className=\"art:hidden art:@min-[768px]/artemis:block\">\n            <ArtemisSharedLayoutBg className=\"art:w-auto art:flex-row art:items-center art:gap-0.5\" inset={0} pillClassName=\"art:rounded-full art:bg-muted\">\n              {nav.links.map(link => <a key={link.href} href={link.href} className=\"art:rounded-full art:px-3.5 art:py-2 art:text-sm art:text-muted-foreground art:transition-colors art:hover:text-foreground art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-ring/30\">\n                {link.label}\n              </a>)}\n            </ArtemisSharedLayoutBg>\n          </div>\n          <div className=\"art:flex art:items-center art:gap-2\">\n            {nav.login ? <a href={nav.login.href} className=\"art:hidden art:min-h-10 art:items-center art:gap-1.5 art:rounded-full art:px-3 art:text-sm art:text-muted-foreground art:transition-colors art:hover:text-foreground art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-ring/30 art:@min-[640px]/artemis:inline-flex\">\n              {nav.login.label}\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-arrow-up-right art:size-3.5\" aria-hidden=\"true\">\n                <path d=\"M7 7h10v10\"/>\n                <path d=\"M7 17 17 7\"/>\n              </svg>\n            </a> : null}\n            {nav.cta ? <motion.a whileHover={reduce ? undefined : { scale: 1.01 }} className=\"art:items-center art:justify-center art:font-medium art:select-none art:transition-colors art:disabled:pointer-events-none art:disabled:opacity-50 art:bg-primary art:text-primary-foreground art:hover:bg-primary/90 art:gap-1.5 art:px-3 art:text-xs art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-ring art:focus-visible:ring-offset-2 art:focus-visible:ring-offset-background art:hidden art:@min-[640px]/artemis:inline-flex art:h-9 art:rounded-full\" href={nav.cta.href} tabIndex={0}>\n              {nav.cta.label}\n            </motion.a> : null}\n            <motion.button type=\"button\" className=\"art:items-center art:justify-center art:select-none art:disabled:pointer-events-none art:disabled:opacity-50 art:gap-2 art:text-sm art:focus-visible:ring-offset-2 art:focus-visible:ring-offset-background art:p-0 art:font-normal art:text-inherit art:hover:text-inherit art:grid art:size-10 art:place-items-center art:border art:border-border art:transition-colors art:hover:bg-muted art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-ring/30 art:@min-[768px]/artemis:hidden art:rounded-full\" aria-label={open ? \"Close navigation\" : \"Open navigation\"} aria-expanded={open} aria-controls=\"daymark-mobile-navigation\" tabIndex={0} whileHover={reduce ? undefined : { scale: 1.01 }} onClick={() => setOpen((o) => !o)}>\n              {open ? (<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-x art:size-4\" aria-hidden=\"true\">\n                  <path d=\"M18 6 6 18\"/>\n                  <path d=\"m6 6 12 12\"/>\n                </svg>) : (<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-menu art:size-4\" aria-hidden=\"true\">\n                  <path d=\"M4 5h16\"/>\n                  <path d=\"M4 12h16\"/>\n                  <path d=\"M4 19h16\"/>\n                </svg>)}\n            </motion.button>\n          </div>\n          <AnimatePresence>\n            {open && (<motion.div id={`${artemisInstanceId}-daymark-mobile-navigation`} className=\"art:absolute art:top-[calc(100%-2px)] art:right-5 art:left-5 art:origin-top art:rounded-2xl art:border art:border-border art:bg-background/92 art:p-2 art:backdrop-blur-2xl art:@min-[768px]/artemis:hidden\" initial={{ opacity: 0, transform: \"translateY(-8px) scale(0.98)\" }} animate={{ opacity: 1, transform: \"translateY(0px) scale(1)\" }} exit={{ opacity: 0, transform: \"translateY(-6px) scale(0.98)\" }} transition={reduce ? { duration: 0 } : ARTEMIS_SPRING_PANEL}>\n                {nav.links.map(link => (<a key={link.href} href={link.href} className=\"art:flex art:min-h-11 art:items-center art:rounded-xl art:px-4 art:text-sm art:text-muted-foreground art:transition-colors art:hover:bg-muted art:hover:text-foreground art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-ring/30\" onClick={() => setOpen(false)}>\n                    {link.label}\n                  </a>))}\n                {menuCta ? <a className=\"art:inline-flex art:items-center art:justify-center art:font-medium art:select-none art:transition-colors art:disabled:pointer-events-none art:disabled:opacity-50 art:bg-primary art:text-primary-foreground art:hover:bg-primary/90 art:gap-2 art:px-5 art:text-sm art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-ring art:focus-visible:ring-offset-2 art:focus-visible:ring-offset-background art:mt-1 art:w-full art:h-9 art:rounded-full\" href={menuCta.href} tabIndex={0} onClick={() => setOpen(false)}>\n                  {menuCta.label}\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-arrow-up-right art:size-4\" aria-hidden=\"true\">\n                    <path d=\"M7 7h10v10\"/>\n                    <path d=\"M7 17 17 7\"/>\n                  </svg>\n                </a> : null}\n              </motion.div>)}\n          </AnimatePresence>\n        </nav>\n        <div className=\"art:relative art:z-10 art:mx-auto art:flex art:min-h-[calc(48rem-5rem)] art:w-full art:max-w-6xl art:flex-col art:items-center art:px-5 art:pt-24 art:pb-12 art:text-center art:@min-[640px]/artemis:min-h-[calc(52rem-6rem)] art:@min-[640px]/artemis:px-8 art:@min-[640px]/artemis:pt-28 art:@min-[640px]/artemis:pb-14\">\n          <motion.h1 className=\"art:text-balance art:font-sans art:font-medium art:text-5xl art:@min-[768px]/artemis:text-6xl art:leading-[0.94] art:tracking-[-0.055em] art:max-w-5xl\" {...rise(reduce, 24, 0)}>\n            <span className=\"art:block art:font-normal\">\n              {copy.headline}\n            </span>\n            {accent ? <span className=\"art:block art:font-semibold\">\n              {accent}\n            </span> :