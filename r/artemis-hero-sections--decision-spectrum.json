  ],
  "description": "Hero sections, Workflow aurora layout only",
  "dependencies": [
    "clsx@^2.1.1",
    "motion@^12.42.2",
    "tailwind-merge@^3.6.0"
  ],
  "registryDependencies": [
    "https://myzeusui.com/r/artemis-controls.json",
