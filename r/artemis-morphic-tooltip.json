      "content": "\"use client\";\nimport { ArtemisScope } from \"./artemis-scope\";\nimport Variant0 from \"./components/morphic-tooltip/variants/01-morphic-tooltip\";\nexport interface ArtemisMorphicTooltipShowcaseProps {\n  className?: string;\n}\nexport function ArtemisMorphicTooltipShowcase({ className }: ArtemisMorphicTooltipShowcaseProps) {\n  return (\n    <ArtemisScope className={`art:[&>*]:mx-auto ${className ?? \"\"}`}>\n      <Variant0 />\n    </ArtemisScope>\n  );\n}\n"
    },
    {
      "path": "application/artemis/components/morphic-tooltip/variants/01-morphic-tooltip.tsx",
      "type": "registry:component",
      "target": "@components/application/artemis/components/morphic-tooltip/variants/01-morphic-tooltip.tsx",
      "content": "\"use client\";\n// @zeus-internal\nimport { ArtemisMorphicTooltip, ArtemisMorphicTooltipProvider } from \"../../../foundations/morphic-tooltip\";\nconst SPARKLES = (<span className=\"art:inline-flex art:items-center art:gap-1.5\">\n    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-sparkles art:size-3.5 art:text-accent\" aria-hidden=\"true\">\n      <path d=\"M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z\"/>\n      <path d=\"M20 2v4\"/>\n      <path d=\"M22 4h-4\"/>\n      <circle cx=\"4\" cy=\"20\" r=\"2\"/>\n    </svg>\n    Shared surface follows focus and hover\n  </span>);\nexport default function MorphicTooltipMorphicTooltip() {\n    return (<ArtemisMorphicTooltipProvider>\n      <div className=\"art:flex art:w-full art:max-w-xl art:flex-col art:items-center art:gap-8 art:px-4\">\n        <div className=\"art:flex art:items-center art:gap-2 art:rounded-xl art:border art:border-border art:bg-card/60 art:p-1 art:shadow-[inset_0_1px_0_rgb(255_255_255_/_0.06),inset_0_0_22px_-18px_color-mix(in_oklch,var(--artemis-foreground)_28%,transparent)]\">\n          <ArtemisMorphicTooltip content={\"Switch to a deeper reasoning pass\"}>\n            <button type=\"button\" className=\"art:grid art:size-10 art:place-items-center art:rounded-2xl art:text-muted-foreground art:transition-colors art:hover:bg-primary/5 art:hover:text-foreground art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-ring\" aria-label=\"Think\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-brain art:size-4\" aria-hidden=\"true\">\n                <path d=\"M12 18V5\"/>\n                <path d=\"M15 13a4.17 4.17 0 0 1-3-4 4.17 4.17 0 0 1-3 4\"/>\n                <path d=\"M17.598 6.5A3 3 0 1 0 12 5a3 3 0 1 0-5.598 1.5\"/>\n                <path d=\"M17.997 5.125a4 4 0 0 1 2.526 5.77\"/>\n                <path d=\"M18 18a4 4 0 0 0 2-7.464\"/>\n                <path d=\"M19.967 17.483A4 4 0 1 1 12 18a4 4 0 1 1-7.967-.517\"/>\n                <path d=\"M6 18a4 4 0 0 1-2-7.464\"/>\n                <path d=\"M6.003 5.125a4 4 0 0 0-2.526 5.77\"/>\n              </svg>\n            </button>\n          </ArtemisMorphicTooltip>\n          <ArtemisMorphicTooltip content={\"Review queued\"}>\n            <button type=\"button\" className=\"art:grid art:size-10 art:place-items-center art:rounded-2xl art:text-muted-foreground art:transition-colors art:hover:bg-primary/5 art:hover:text-foreground art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-ring\" aria-label=\"Review\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-circle-check art:size-4\" aria-hidden=\"true\">\n                <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                <path d=\"m9 12 2 2 4-4\"/>\n              </svg>\n            </button>\n          </ArtemisMorphicTooltip>\n          <ArtemisMorphicTooltip content={\"Ask the coding agent to implement the change\"}>\n            <button type=\"button\" className=\"art:grid art:size-10 art:place-items-center art:rounded-2xl art:text-muted-foreground art:transition-colors art:hover:bg-primary/5 art:hover:text-foreground art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-ring\" aria-label=\"Code\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-code-xml art:size-4\" aria-hidden=\"true\">\n                <path d=\"m18 16 4-4-4-4\"/>\n                <path d=\"m6 8-4 4 4 4\"/>\n                <path d=\"m14.5 4-5 16\"/>\n              </svg>\n            </button>\n          </ArtemisMorphicTooltip>\n          <ArtemisMorphicTooltip content={\"Open the active\"}>\n            <button type=\"button\" className=\"art:grid art:size-10 art:place-items-center art:rounded-2xl art:text-muted-foreground art:transition-colors art:hover:bg-primary/5 art:hover:text-foreground art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-ring\" aria-label=\"Message\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-message-square-text art:size-4\" aria-hidden=\"true\">\n                <path d=\"M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z\"/>\n                <path d=\"M7 11h10\"/>\n                <path d=\"M7 15h6\"/>\n                <path d=\"M7 7h8\"/>\n              </svg>\n            </button>\n          </ArtemisMorphicTooltip>\n        </div>\n        <ArtemisMorphicTooltip content={SPARKLES} side=\"bottom\">\n          <button type=\"button\" className=\"art:inline-flex art:h-10 art:items-center art:gap-2 art:rounded-full art:border art:border-border art:bg-background art:px-4 art:font-medium art:text-sm art:transition-colors art:hover:border-border-strong art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-ring\">\n            {\"Hover the toolbar\"}\n          </button>\n        </ArtemisMorphicTooltip>\n      </div>\n    </ArtemisMorphicTooltipProvider>);\n}\n"
