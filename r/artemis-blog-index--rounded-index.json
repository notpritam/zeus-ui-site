      "target": "@components/application/artemis/components/blog-pages/variants/02-rounded-index.tsx",
      "content": "\"use client\";\n// @zeus-internal\nimport { useId as useArtemisInstanceId } from \"react\";\nimport { motion, useReducedMotion } from \"motion/react\";\nimport { useState } from \"react\";\nimport { ArtemisButton } from \"../../../foundations/button\";\nimport { ARTEMIS_EASE_OUT } from \"../../../lib/ease\";\nexport default function BlogPagesRoundedIndex() {\nconst artemisInstanceId = useArtemisInstanceId();\n\n\n    const reduce = useReducedMotion();\n    const [email, setEmail] = useState(\"\");\n    const [focused, setFocused] = useState(false);\n    const reveal = { initial: { opacity: 0, y: 16 }, whileInView: { opacity: 1, y: 0 }, viewport: { once: true }, transition: { duration: reduce ? 0 : 0.45, ease: ARTEMIS_EASE_OUT } };\n    return (<>\n      <div className=\"art:min-h-screen art:w-full art:bg-background art:font-sans art:text-foreground\">\n        <main id=\"rounded-blog-top\">\n          <section className=\"art:mx-auto art:w-full art:max-w-6xl art:px-4 art:pt-14 art:pb-10 art:@min-[640px]/artemis:px-8 art:@min-[640px]/artemis:pt-20 art:@min-[640px]/artemis:pb-14\">\n            <motion.div className=\"art:mx-auto art:flex art:max-w-4xl art:flex-col art:items-center art:pb-10 art:text-center art:@min-[640px]/artemis:pb-12\" {...reveal}>\n              <p className=\"art:font-medium art:text-muted-foreground art:text-sm art:uppercase art:tracking-[0.12em]\">\n                {\"Journal / Issue 04\"}\n              </p>\n              <div className=\"art:mt-8 art:flex art:flex-col art:items-center art:gap-6\">\n                <h1 className=\"art:max-w-3xl art:text-balance art:tracking-[-0.035em] art:text-4xl art:@min-[768px]/artemis:text-5xl art:font-medium\">\n                  {\"Stories for slower attention.\"}\n                </h1>\n                <p className=\"art:max-w-md art:text-pretty art:text-sm art:text-muted-foreground art:leading-7 art:@min-[640px]/artemis:text-base\">\n                  {\"Field reports about thoughtful work, familiar places, and the people who notice what others pass by.\"}\n                </p>\n              </div>\n            </motion.div>\n          </section>\n          <section className=\"art:mx-auto art:w-full art:max-w-6xl art:px-4 art:@min-[640px]/artemis:px-8\">\n            <motion.article {...reveal}>\n              <a href=\"#rounded-article\" className=\"art:group art:block art:rounded-3xl art:border art:border-border/60 art:bg-background art:p-2 art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-ring\">\n                <div className=\"art:aspect-[16/10] art:overflow-hidden art:rounded-2xl art:@min-[640px]/artemis:aspect-[3/1]\">\n                  <motion.img whileHover={reduce ? undefined : { scale: 1.025 }} transition={{ duration: 0.45, ease: ARTEMIS_EASE_OUT }} src=\"/assets/artemis/16585090b4f1acf6efb9.avif\" alt=\"A quiet cafe interior lit by tall windows\" width=\"1800\" height=\"1350\" className=\"art:h-full art:w-full art:object-cover\"/>\n                </div>\n                <div className=\"art:grid art:gap-8 art:p-5 art:@min-[640px]/artemis:p-8 art:@min-[768px]/artemis:grid-cols-[minmax(0,1fr)_auto] art:@min-[768px]/artemis:items-end\">\n                  <div className=\"art:max-w-2xl\">\n                    <p className=\"art:font-medium art:text-muted-foreground art:text-xs art:uppercase art:tracking-[0.14em]\">\n                      {\"Featured / \"}\n                      {\"Places\"}\n                    </p>\n                    <h2 className=\"art:mt-5 art:text-balance art:leading-tight art:tracking-[-0.045em] art:text-4xl art:font-medium\">\n                      {\"The room before opening\"}\n                    </h2>\n                    <p className=\"art:mt-4 art:max-w-md art:text-pretty art:text-muted-foreground art:leading-7\">\n                      {\"A cafe has a different rhythm before the first order. We spent a morning with the people who prepare that quiet hour.\"}\n                    </p>\n                  </div>\n                  <div className=\"art:flex art:items-center art:gap-4\">\n                    <span className=\"art:text-muted-foreground art:text-sm\">\n                      {\"7 min read\"}\n                    </span>\n                    <span className=\"art:grid art:size-10 art:place-items-center art:rounded-full art:bg-muted art:text-foreground\">\n                      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-arrow-right art:size-4\" aria-hidden=\"true\">\n                        <path d=\"M5 12h14\"/>\n                        <path d=\"m12 5 7 7-7 7\"/>\n                      </svg>\n                    </span>\n                  </div>\n                </div>\n              </a>\n            </motion.article>\n          </section>\n          <section className=\"art:mx-auto art:w-full art:max-w-6xl art:px-4 art:py-14 art:@min-[640px]/artemis:px-8 art:@min-[640px]/artemis:py-20\">\n            <div className=\"art:flex art:items-end art:justify-between art:gap-5\">\n              <div>\n                <p className=\"art:text-muted-foreground art:text-sm\">\n                  {\"New this week\"}\n                </p>\n                <h2 className=\"art:mt-1 art:font-medium art:text-4xl art:tracking-[-0.035em]\">\n                  {\"Recent stories\"}\n                </h2>\n              </div>\n              <a href=\"#rounded-blog-top\" className=\"art:hidden art:min-h-10 art:items-center art:gap-2 art:font-medium art:text-sm art:focus-visible:outline-none art:focus-visible:ring-1 art:focus-visible:ring-ring art:@min-[640px]/artemis:inline-flex\">\n                {\"Browse archive\"}\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-arrow-right art:size-4\" aria-hidden=\"true\">\n                  <path d=\"M5 12h14\"/>\n                  <path d=\"m12 5 7 7-7 7\"/>\n                </svg>\n              </a>\n            </div>\n            <div className=\"art:mt-8 art:overflow-hidden art:rounded-3xl art:border art:border-border/60\">\n              <motion.article className=\"\" {...reveal} transition={{ ...reveal.transition, delay: 0 }}>\n                <a href=\"#rounded-article\" className=\"art:group art:grid art:gap-5 art:p-4 art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-inset art:focus-visible:ring-ring art:@min-[640px]/artemis:grid-cols-[10rem_minmax(0,1fr)_2.5rem] art:@min-[640px]/artemis:items-center\">\n                  <div className=\"art:aspect-[4/3] art:overflow-hidden art:rounded-lg\">\n                    <motion.img whileHover={reduce ? undefined : { scale: 1.025 }} transition={{ duration: 0.45, ease: ARTEMIS_EASE_OUT }} src=\"/assets/artemis/030144853a0cfe1b7112.avif\" alt=\"A florist arranging bouquets at a market stall\" width=\"1200\" height=\"900\" loading=\"lazy\" className=\"art:h-full art:w-full art:object-cover\"/>\n                  </div>\n                  <div className=\"art:py-1\">\n                    <p className=\"art:font-medium art:text-muted-foreground art:text-xs art:uppercase art:tracking-[0.13em]\">\n                      {\"People\"}\n                      {\" / \"}\n                      {\"5 min read\"}\n                    </p>\n                    <h3 className=\"art:mt-3 art:text-balance art:font-medium art:text-xl art:leading-tight art:tracking-[-0.03em]\">\n                      {\"A market wakes in color\"}\n                    </h3>\n                    <p className=\"art:mt-3 art:text-pretty art:text-muted-foreground art:text-sm art:leading-6\">\n                      {\"Following the small decisions behind a flower stall, from the first bucket to the final bouquet.\"}\n                    </p>\n                  </div>\n                  <span className=\"art:grid art:size-10 art:place-items-center art:rounded-full art:bg-muted art:text-foreground art:transition-transform art:duration-300 art:group-hover:translate-x-1 art:@min-[640px]/artemis:justify-self-end\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-arrow-right art:size-4\" aria-hidden=\"true\">\n                      <path d=\"M5 12h14\"/>\n                      <path d=\"m12 5 7 7-7 7\"/>\n                    </svg>\n                  </span>\n                </a>\n              </motion.article>\n              <motion.article className=\"art:border-border/60 art:border-t\" {...reveal} transition={{ ...reveal.transition, delay: 0.05 }}>\n                <a href=\"#rounded-article\" className=\"art:group art:grid art:gap-5 art:p-4 art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-inset art:focus-visible:ring-ring art:@min-[640px]/artemis:grid-cols-[10rem_minmax(0,1fr)_2.5rem] art:@min-[640px]/artemis:items-center\">\n                  <div className=\"art:aspect-[4/3] art:overflow-hidden art:rounded-lg\">\n                    <motion.img whileHover={reduce ? undefined : { scale: 1.025 }} transition={{ duration: 0.45, ease: ARTEMIS_EASE_OUT }} src=\"/assets/artemis/fbba564395c7ed7f3038.avif\" alt=\"An artisan shaping clay by hand at a worktable\" width=\"1200\" height=\"900\" loading=\"lazy\" className=\"art:h-full art:w-full art:object-cover\"/>\n                  </div>\n                  <div className=\"art:py-1\">\n                    <p className=\"art:font-medium art:text-muted-foreground art:text-xs art:uppercase art:tracking-[0.13em]\">\n                      {\"Craft\"}\n                      {\" / \"}\n                      {\"6 min read\"}\n                    </p>\n                    <h3 className=\"art:mt-3 art:text-balance art:font-medium art:text-xl art:leading-tight art:tracking-[-0.03em]\">\n                      {\"What the hands remember\"}\n                    </h3>\n                    <p className=\"art:mt-3 art:text-pretty art:text-muted-foreground art:text-sm art:leading-6\">\n                      {\"Inside a pottery practice shaped by repetition, useful mistakes, and knowing when to stop.\"}\n                    </p>\n                  </div>\n                  <span className=\"art:grid art:size-10 art:place-items-center art:rounded-full art:bg-muted art:text-foreground art:transition-transform art:duration-300 art:group-hover:translate-x-1 art:@min-[640px]/artemis:justify-self-end\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-arrow-right art:size-4\" aria-hidden=\"true\">\n                      <path d=\"M5 12h14\"/>\n                      <path d=\"m12 5 7 7-7 7\"/>\n                    </svg>\n                  </span>\n                </a>\n              </motion.article>\n              <motion.article className=\"art:border-border/60 art:border-t\" {...reveal} transition={{ ...reveal.transition, delay: 0.1 }}>\n                <a href=\"#rounded-article\" className=\"art:group art:grid art:gap-5 art:p-4 art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-inset art:focus-visible:ring-ring art:@min-[640px]/artemis:grid-cols-[10rem_minmax(0,1fr)_2.5rem] art:@min-[640px]/artemis:items-center\">\n                  <div className=\"art:aspect-[4/3] art:overflow-hidden art:rounded-lg\">\n                    <motion.img whileHover={reduce ? undefined : { scale: 1.025 }} transition={{ duration: 0.45, ease: ARTEMIS_EASE_OUT }} src=\"/assets/artemis/37d6ad7de3fdb7597cd1.avif\" alt=\"A warmly lit independent bookstore in Lisbon\" width=\"1200\" height=\"900\" loading=\"lazy\" className=\"art:h-full art:w-full art:object-cover\"/>\n                  </div>\n                  <div className=\"art:py-1\">\n                    <p className=\"art:font-medium art:text-muted-foreground art:text-xs art:uppercase art:tracking-[0.13em]\">\n                      {\"Places\"}\n                      {\" / \"}\n                      {\"4 min read\"}\n                    </p>\n                    <h3 className=\"art:mt-3 art:text-balance art:font-medium art:text-xl art:leading-tight art:tracking-[-0.03em]\">\n                      {\"The shelf that finds you\"}\n                    </h3>\n                    <p className=\"art:mt-3 art:text-pretty art:text-muted-foreground art:text-sm art:leading-6\">\n                      {\"A Lisbon bookseller on arranging a room for wandering rather than searching.\"}\n                    </p>\n                  </div>\n                  <span className=\"art:grid art:size-10 art:place-items-center art:rounded-full art:bg-muted art:text-foreground art:transition-transform art:duration-300 art:group-hover:translate-x-1 art:@min-[640px]/artemis:justify-self-end\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-arrow-right art:size-4\" aria-hidden=\"true\">\n                      <path d=\"M5 12h14\"/>\n                      <path d=\"m12 5 7 7-7 7\"/>\n                    </svg>\n                  </span>\n                </a>\n              </motion.article>\n            </div>\n          </section>\n          <section id=\"rounded-newsletter\" className=\"art:px-4 art:pb-16 art:@min-[640px]/artemis:px-8 art:@min-[640px]/artemis:pb-24\">\n            <motion.div className=\"art:mx-auto art:flex art:w-full art:max-w-6xl art:flex-col art:items-center art:gap-7 art:rounded-3xl art:border art:border-border/60 art:bg-background art:p-8 art:text-center art:@min-[640px]/artemis:p-12\" {...reveal}>\n              <div className=\"art:flex art:max-w-2xl art:flex-col art:items-center\">\n                <p className=\"art:text-muted-foreground art:text-sm\">\n                  {\"Every other Sunday\"}\n                </p>\n                <h2 className=\"art:mt-2 art:text-balance art:font-medium art:text-4xl art:tracking-[-0.035em]\">\n                  {\"One thoughtful story for your morning.\"}\n                </h2>\n              </div>\n              <form className=\"art:flex art:w-full art:max-w-xl art:flex-col art:gap-3 art:@min-[640px]/artemis:flex-row\" onSubmit={event => event.preventDefault()}>\n                <div className=\"art:flex art:flex-col art:gap-1.5 art:w-full art:flex-1\">\n                  <div data-state={focused ? \"focused\" : \"idle\"} className={`art:relative art:h-10 art:overflow-hidden art:rounded-full art:border art:bg-background art:transition-colors art:duration-200 ${focused ? \"art:border-foreground/60\" : \"art:border-border\"}`}>\n                    <input id={`${artemisInstanceId}-R_3a9bsnpfdb_`} type=\"email\" aria-label=\"Email address\" required autoComplete=\"email\" placeholder=\"Email address\" className=\"art:peer art:h-full art:w-full art:bg-transparent art:text-foreground art:caret-foreground art:outline-none art:px-5 art:text-base art:placeholder:text-muted-foreground\" name=\"email\" value={email} onChange={event => setEmail(event.currentTarget.value)} onFocus={() => setFocused(true)} onBlur={() => setFocused(false)}/>\n                  </div>\n                  <div className=\"art:contents\"/>\n                </div>\n                <ArtemisButton whileTap={reduce ? undefined : { scale: 0.96 }} type=\"submit\" size=\"lg\" className=\"art:w-full art:@min-[640px]/artemis:w-auto art:h-9\" tabIndex={0}>\n                  {\"Join the journal\"}\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-mail art:size-4\" aria-hidden=\"true\">\n                    <path d=\"m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7\"/>\n                    <rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"/>\n                  </svg>\n                </ArtemisButton>\n              </form>\n            </motion.div>\n          </section>\n          <span id=\"rounded-article\" className=\"art:sr-only\">\n            {\"Article preview\"}\n          </span>\n        </main>\n      </div>\n    </>);\n}\n"
