      "content": "\"use client\";\nimport { ArtemisScope } from \"./artemis-scope\";\nimport View1 from \"./components/blog-pages/variants/02-rounded-index\";\nconst variants = {\"rounded-index\":View1};\nexport interface ArtemisBlogIndexProps { className?: string; variant?: \"rounded-index\"; }\nexport function ArtemisBlogIndex({ className, variant = \"rounded-index\" }: ArtemisBlogIndexProps) {const View = variants[variant];return <ArtemisScope className={className}><div className=\"art:flex art:w-full art:min-w-0 art:flex-col art:items-center\"><View/></div></ArtemisScope>;}\n"
    },
    {
