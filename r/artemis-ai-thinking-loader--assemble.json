      "content": "// @zeus-internal\nexport default function AiThinkingLoaderAssemble() {\n    return (<>\n      <output aria-live=\"polite\" aria-atomic=\"true\" data-variant=\"assemble\" data-paused=\"false\" className=\"art:artemis-ai-loader art:inline-flex art:shrink-0 art:items-center art:gap-3 art:whitespace-nowrap art:text-sm art:font-medium art:text-muted-foreground\">\n        <style>\n          {\"\\n@keyframes artemis-ffe6944-artemis-ai-pixel { 0%, 65%, 100% { opacity: .12; } 22%, 34% { opacity: 1; } }\\n@keyframes artemis-ffe6944-artemis-ai-tile { 0%, 100% { opacity: .18; transform: translateY(2px); } 35%, 65% { opacity: 1; transform: translateY(0); } }\\n@keyframes artemis-ffe6944-artemis-ai-node { 0%, 100% { opacity: 1; } 18%, 82% { opacity: .35; } }\\n@keyframes artemis-ffe6944-artemis-ai-signal {\\n  0%, 100% { transform: translate(7px, 22px); }\\n  33.333% { transform: translate(18px, 5px); }\\n  66.667% { transform: translate(27px, 25px); }\\n}\\n.art\\\\:artemis-ai-loader .art\\\\:artemis-ffe6944-artemis-ai-pixel { animation: artemis-ffe6944-artemis-ai-pixel 1.8s linear infinite; }\\n.art\\\\:artemis-ai-loader[data-variant=\\\"assemble\\\"] .art\\\\:artemis-ffe6944-artemis-ai-pixel { animation-name: artemis-ffe6944-artemis-ai-tile; animation-duration: 2.4s; }\\n.art\\\\:artemis-ai-loader .art\\\\:artemis-ffe6944-artemis-ai-node { animation: artemis-ffe6944-artemis-ai-node 2.4s linear infinite; }\\n.art\\\\:artemis-ai-loader .art\\\\:artemis-ffe6944-artemis-ai-signal { animation: artemis-ffe6944-artemis-ai-signal 2.4s linear infinite; }\\n.art\\\\:artemis-ai-loader[data-paused=\\\"true\\\"] .art\\\\:artemis-ffe6944-artemis-ai-pixel,\\n.art\\\\:artemis-ai-loader[data-paused=\\\"true\\\"] .art\\\\:artemis-ffe6944-artemis-ai-node,\\n.art\\\\:artemis-ai-loader[data-paused=\\\"true\\\"] .art\\\\:artemis-ffe6944-artemis-ai-signal { animation-play-state: paused; }\\n@media (prefers-reduced-motion: reduce) {\\n  .art\\\\:artemis-ai-loader .art\\\\:artemis-ffe6944-artemis-ai-pixel, .art\\\\:artemis-ai-loader .art\\\\:artemis-ffe6944-artemis-ai-node { animation: none; opacity: .7; transform: none; }\\n  .art\\\\:artemis-ai-loader .art\\\\:artemis-ffe6944-artemis-ai-signal { animation: none; display: none; }\\n}\\n\"}\n        </style>\n        <svg aria-hidden=\"true\" viewBox=\"0 0 32 32\" className=\"art:size-7 art:shrink-0 art:overflow-visible art:text-orange-600 art:dark:text-orange-400\" fill=\"currentColor\">\n          <rect x=\"8\" y=\"8\" width=\"4\" height=\"4\" rx=\"1\" className=\"art:artemis-ffe6944-artemis-ai-pixel\" style={{ animationDelay: \"0s\" }}/>\n          <rect x=\"14\" y=\"8\" width=\"4\" height=\"4\" rx=\"1\" className=\"art:artemis-ffe6944-artemis-ai-pixel\" style={{ animationDelay: \"-0.16s\" }}/>\n          <rect x=\"20\" y=\"8\" width=\"4\" height=\"4\" rx=\"1\" className=\"art:artemis-ffe6944-artemis-ai-pixel\" style={{ animationDelay: \"-0.32s\" }}/>\n          <rect x=\"8\" y=\"14\" width=\"4\" height=\"4\" rx=\"1\" className=\"art:artemis-ffe6944-artemis-ai-pixel\" style={{ animationDelay: \"-0.48s\" }}/>\n          <rect x=\"14\" y=\"14\" width=\"4\" height=\"4\" rx=\"1\" className=\"art:artemis-ffe6944-artemis-ai-pixel\" style={{ animationDelay: \"-0.64s\" }}/>\n          <rect x=\"20\" y=\"14\" width=\"4\" height=\"4\" rx=\"1\" className=\"art:artemis-ffe6944-artemis-ai-pixel\" style={{ animationDelay: \"-0.8s\" }}/>\n          <rect x=\"8\" y=\"20\" width=\"4\" height=\"4\" rx=\"1\" className=\"art:artemis-ffe6944-artemis-ai-pixel\" style={{ animationDelay: \"-0.96s\" }}/>\n          <rect x=\"14\" y=\"20\" width=\"4\" height=\"4\" rx=\"1\" className=\"art:artemis-ffe6944-artemis-ai-pixel\" style={{ animationDelay: \"-1.12s\" }}/>\n          <rect x=\"20\" y=\"20\" width=\"4\" height=\"4\" rx=\"1\" className=\"art:artemis-ffe6944-artemis-ai-pixel\" style={{ animationDelay: \"-1.28s\" }}/>\n        </svg>\n        <span>\n          {\"Processing\"}\n          <span aria-hidden=\"true\">\n            {\"\\u2026\"}\n          </span>\n        </span>\n      </output>\n    </>);\n}\n"
