      "target": "@components/application/artemis/artemis-feature-sections.tsx",
      "content": "\"use client\";\nimport { ArtemisScope } from \"./artemis-scope\";\nimport type { ArtemisFeatureContent } from \"./components/feature-sections/content\";\nimport View1 from \"./components/feature-sections/variants/02-alternating-rows\";\nconst variants = {\"alternating-rows\":View1};\nexport type { ArtemisFeatureContent, ArtemisFeatureImage, ArtemisFeatureItem, ArtemisFeatureLink } from \"./components/feature-sections/content\";\nexport interface ArtemisFeatureSectionsProps { className?: string; variant?: \"alternating-rows\"; /** The words on the feature section; anything left out keeps the layout's own copy. */ content?: Partial<ArtemisFeatureContent>; }\nexport function ArtemisFeatureSections({ className, variant = \"alternating-rows\", content }: ArtemisFeatureSectionsProps) {const View = variants[variant];return <ArtemisScope className={className}><div className=\"art:flex art:w-full art:min-w-0 art:flex-col art:items-center\"><View content={content}/></div></ArtemisScope>;}\n"
    },
    {
      "path": "application/artemis/components/feature-sections/content.ts",
      "type": "registry:component",
      "target": "@components/application/artemis/components/feature-sections/content.ts",
      "content": "// @zeus-internal\nimport type { ComponentType } from \"react\";\n\n/** The words on a link or button, and where it goes. */\nexport interface ArtemisFeatureLink {\n  label: string;\n  href: string;\n}\n\n/** A picture shown as content, and the words that stand in for it. */\nexport interface ArtemisFeatureImage {\n  src: string;\n  alt: string;\n}\n\n/** One feature: a row, card, step or tab, depending on the layout. */\nexport interface ArtemisFeatureItem {\n  /** The feature's name. All layouts; signal-grid puts its first word on a line of its own. */\n  title: string;\n  /** A sentence or two about the feature. All layouts; product-hotspots, steps, tabs and stage-tabs show it for the chosen feature only. */\n  description: string;\n  /** A short name: the tab in tabs and stage-tabs (which show the title when you leave this out), and the words after the number in alternating-rows. */\n  label?: string;\n  /** Short points under the description. alternating-rows, product-hotspots and tabs. */\n  bullets?: string[];\n  /** A figure shown large. voice-ai (first card) and control-deck (third and fourth cards; on the third, a trailing % is set small and fills the bar). */\n  stat?: string;\n  /** The feature's icon. visual-benefits, signal-grid, voice-ai (first card), control-deck (fourth and fifth cards) and tabs, which keep their own icon for that slot when you leave this out. */\n  icon?: ComponentType<{ className?: string }>;\n  /** A product picture. tabs, which shows its own picture for that slot when you leave this out. */\n  image?: ArtemisFeatureImage;\n}\n\n/**\n * The words on an Artemis feature section. Every layout reads this shape, so you can switch layouts and keep them.\n * An empty `badge`, `headlineAccent` or `subhead` leaves that line out.\n */\nexport interface ArtemisFeatureContent {\n  /** A short line above the headline. All layouts except visual-benefits, alternating-rows and stage-tabs. */\n  badge?: string;\n  /** The section heading. All layouts except stage-tabs. */\n  headline?: string;\n  /**\n   * The second part of the heading. showcase, signal-grid, control-deck, voice-ai, list, bento and tabs put it on a\n   * line of its own, steps sets it in the accent color, and the other layouts with a heading run it on after the\n   * headline. It goes with `headline`: give a headline without it and the heading has no second part.\n   */\n  headlineAccent?: string;\n  /** A sentence or two under the heading. All layouts except visual-benefits, tabs and stage-tabs. */\n  subhead?: string;\n  /**\n   * The features. All layouts. Today's counts look best: three in visual-benefits, alternating-rows, showcase,\n   * benefits-triptych and steps; four in product-hotspots, voice-ai, list, tabs and stage-tabs; five in control-deck\n   * (which shows no more than five) and bento; six in signal-grid.\n   */\n  items: ArtemisFeatureItem[];\n  /** The button under the features. visual-benefits. */\n  cta?: ArtemisFeatureLink;\n}\n"
    },
    {
      "path": "application/artemis/components/feature-sections/variants/02-alternating-rows.tsx",
      "type": "registry:component",
      "target": "@components/application/artemis/components/feature-sections/variants/02-alternating-rows.tsx",
      "content": "\"use client\";\n// @zeus-internal\nimport type { Variants } from \"motion/react\";\nimport { MotionConfig, motion, useReducedMotion } from \"motion/react\";\nimport { ARTEMIS_EASE_OUT } from \"../../../lib/ease\";\nimport type { ArtemisFeatureContent, ArtemisFeatureItem } from \"../content\";\nconst DEFAULT = {\n    headline: \"From a first thought to a finished thing.\",\n    subhead: \"One connected space for the way good work actually happens.\",\n    items: [\n        {\n            label: \"Make space\",\n            title: \"Give every idea a place to grow.\",\n            description: \"Catch the rough sketch, the quick note, and the what-if. Bring them into one space that makes it easy to pick up where you left off.\",\n            bullets: [\"Notes and files, right where you need them\", \"A little structure without the extra work\"],\n        },\n        {\n            label: \"Find your rhythm\",\n            title: \"Good work is a conversation.\",\n            description: \"Keep feedback close to the work. Share a first draft, work through the details, and move forward with everyone on the same page.\",\n            bullets: [\"Feedback with the full picture\", \"Fewer handoffs, clearer next steps\"],\n        },\n        {\n            label: \"Put it out there\",\n            title: \"From almost there to out in the world.\",\n            description: \"Turn the finishing touches into a fresh start. Keep track of the details so you can spend less time checking and more time creating.\",\n            bullets: [\"A shared view of what is ready\", \"A clear path to your next milestone\"],\n        },\n    ],\n} satisfies ArtemisFeatureContent;\nconst VISUAL_VIEWPORT = { once: true, amount: 0.35 } as const;\nconst TEXT_VIEWPORT = { once: true, amount: 0.3 } as const;\nconst TEXT_HIDDEN = { opacity: 0, y: 20 };\nconst TEXT_SHOWN = { opacity: 1, y: 0 };\nconst TEXT_TRANSITION = { duration: 0.6, ease: ARTEMIS_EASE_OUT };\nconst INSTANT = { duration: 0.01 };\nfunction popIn(reduce: boolean, delay: number, duration = 0.6): Variants {\n    return {\n        hidden: { opacity: 0, y: 22, scale: 0.96 },\n        shown: { opacity: 1, y: 0, scale: 1, transition: reduce ? INSTANT : { duration, delay, ease: ARTEMIS_EASE_OUT } },\n    };\n}\nfunction growLine(reduce: boolean): Variants {\n    return {\n        hidden: { scaleX: 0 },\n        shown: { scaleX: 1, transition: reduce ? INSTANT : { duration: 0.9, delay: 0.3, ease: ARTEMIS_EASE_OUT } },\n    };\n}\nfunction DraftArt({ reduce }: { reduce: boolean }) {\n    const pop = (delay: number, duration?: number) => popIn(reduce, delay, duration);\n    return (<div aria-hidden=\"true\" className=\"art:relative art:isolate art:flex art:h-112 art:items-center art:justify-center art:overflow-hidden art:rounded-3xl art:border art:border-border/50 art:px-6 art:pb-6 art:pt-12 art:@min-[640px]/artemis:p-10\">\n      <div className=\"art:absolute art:inset-0 art:-z-10 art:opacity-65 art:dark:opacity-15\" style={{ background: \"radial-gradient(ellipse at 15% 90%, #f5d2aa, transparent 70%), linear-gradient(135deg, #faf4e9, #dceaf3)\" }}/>\n      <div className=\"art:pointer-events-none art:absolute art:inset-0 art:-z-10 art:opacity-10\" style={{ backgroundImage: \"radial-gradient(var(--artemis-foreground) 0.6px, transparent 0.6px)\", backgroundSize: \"18px 18px\" }}/>\n      <div className=\"art:absolute art:left-6 art:top-5 art:flex art:items-center art:gap-2 art:font-mono art:text-xs art:text-muted-foreground\">\n        <span className=\"art:size-1.5 art:rounded-full art:bg-current\"/>\n        {\"THE FIRST DRAFT\"}\n      </div>\n      <div className=\"art:relative art:w-full art:max-w-72\">\n        <motion.div className=\"art:absolute art:-inset-x-2 art:-top-4 art:bottom-4 art:rotate-6 art:rounded-2xl art:border art:border-border art:bg-background/80\" variants={pop(0)}/>\n        <motion.div className=\"art:absolute art:-inset-x-1 art:-top-2 art:bottom-2 art:-rotate-3 art:rounded-2xl art:border art:border-border art:bg-background/90\" variants={pop(0.15)}/>\n        <motion.div className=\"art:relative art:rounded-2xl art:border art:border-border art:bg-background art:p-5\" variants={pop(0.3)}>\n          <div className=\"art:flex art:items-center art:justify-between\">\n            <span className=\"art:grid art:size-9 art:place-items-center art:rounded-full art:border art:border-border\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-file-text art:size-4\" aria-hidden=\"true\">\n                <path d=\"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z\"/>\n                <path d=\"M14 2v5a1 1 0 0 0 1 1h5\"/>\n                <path d=\"M10 9H8\"/>\n                <path d=\"M16 13H8\"/>\n                <path d=\"M16 17H8\"/>\n              </svg>\n            </span>\n            <span className=\"art:font-mono art:text-xs art:text-muted-foreground\">\n              {\"DRAFT 001\"}\n            </span>\n          </div>\n          <p className=\"art:mt-5 art:text-xl art:font-medium art:tracking-tight\">\n            {\"What if we made\"}\n            <br />\n            {\"room for a little more?\"}\n          </p>\n          <div className=\"art:my-4 art:space-y-2\">\n            <div className=\"art:h-1.5 art:w-full art:rounded-full art:bg-foreground/10\"/>\n            <div className=\"art:h-1.5 art:w-5/6 art:rounded-full art:bg-foreground/10\"/>\n            <div className=\"art:h-1.5 art:w-2/3 art:rounded-full art:bg-foreground/10\"/>\n          </div>\n          <div className=\"art:flex art:flex-wrap art:gap-2\">\n            <span className=\"art:rounded-full art:border art:border-border art:px-2.5 art:py-1 art:text-xs art:text-muted-foreground\">\n              {\"An idea\"}\n            </span>\n            <span className=\"art:rounded-full art:border art:border-border art:px-2.5 art:py-1 art:text-xs art:text-muted-foreground\">\n              {\"Worth exploring\"}\n            </span>\n          </div>\n          <div className=\"art:mt-5 art:flex art:items-center art:gap-2 art:border-t art:border-border art:pt-4 art:text-xs art:text-muted-foreground\">\n            <span className=\"art:size-1.5 art:rounded-full art:bg-primary\"/>\n            {\"Saved to your space\"}\n          </div>\n        </motion.div>\n        <motion.div className=\"art:absolute art:-bottom-5 art:-right-3 art:flex art:items-center art:gap-2 art:rounded-full art:border art:border-border art:bg-background art:px-4 art:py-2.5 art:text-xs art:@min-[640px]/artemis:-right-6\" variants={pop(0.45)}>\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-check art:size-3.5\" aria-hidden=\"true\">\n            <path d=\"M20 6 9 17l-5-5\"/>\n          </svg>\n          {\"Nothing slips away.\"}\n        </motion.div>\n      </div>\n    </div>);\n}\nfunction TeamArt({ reduce }: { reduce: boolean }) {\n    const pop = (delay: number, duration?: number) => popIn(reduce, delay, duration);\n    return (<div aria-hidden=\"true\" className=\"art:relative art:isolate art:flex art:h-112 art:items-center art:justify-center art:overflow-hidden art:rounded-3xl art:border art:border-border/50 art:px-6 art:pb-6 art:pt-12 art:@min-[640px]/artemis:p-10\">\n      <div className=\"art:absolute art:inset-0 art:-z-10 art:opacity-65 art:dark:opacity-15\" style={{ background: \"radial-gradient(ellipse at 90% 10%, #aeddd5, transparent 70%), linear-gradient(135deg, #e5eef1, #f7efdf)\" }}/>\n      <div className=\"art:pointer-events-none art:absolute art:inset-0 art:-z-10 art:opacity-10\" style={{ backgroundImage: \"radial-gradient(var(--artemis-foreground) 0.6px, transparent 0.6px)\", backgroundSize: \"18px 18px\" }}/>\n      <div className=\"art:absolute art:left-6 art:top-5 art:flex art:items-center art:gap-2 art:font-mono art:text-xs art:text-muted-foreground\">\n        <span className=\"art:size-1.5 art:rounded-full art:bg-current\"/>\n        {\"IN GOOD COMPANY\"}\n      </div>\n      <div className=\"art:relative art:w-full art:max-w-xs art:pt-3\">\n        <motion.div className=\"art:mr-8 art:rounded-2xl art:border art:border-border art:bg-background art:p-5\" variants={pop(0)}>\n          <div className=\"art:mb-4 art:flex art:items-center art:justify-between\">\n            <span className=\"art:text-xs art:font-medium\">\n              {\"Homepage / First look\"}\n            </span>\n            <span className=\"art:text-xs art:text-muted-foreground\">\n              {\"v.02\"}\n            </span>\n          </div>\n          <div className=\"art:relative art:flex art:h-20 art:items-center art:justify-center art:overflow-hidden art:rounded-xl art:border art:border-border\">\n            <div className=\"art:absolute art:inset-0 art:opacity-50 art:dark:opacity-20\" style={{ background: \"linear-gradient(120deg, #d7e6e3, #f3dfc1)\" }}/>\n            <div className=\"art:relative art:flex art:gap-2\">\n              <div className=\"art:self-end art:rounded-t-full art:border art:border-foreground/20 art:bg-background/60 art:w-8 art:h-10\" style={{ transform: \"rotate(-12deg)\" }}/>\n              <div className=\"art:self-end art:rounded-t-full art:border art:border-foreground/20 art:bg-background/60 art:w-10 art:h-16\" style={{ transform: \"rotate(0deg)\" }}/>\n              <div className=\"art:self-end art:rounded-t-full art:border art:border-foreground/20 art:bg-background/60 art:w-8 art:h-12\" style={{ transform: \"rotate(12deg)\" }}/>\n            </div>\n            <span className=\"art:absolute art:bottom-2 art:right-3 art:grid art:size-6 art:place-items-center art:rounded-full art:bg-primary art:text-primary-foreground\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-message-circle art:size-3\" aria-hidden=\"true\">\n                <path d=\"M2.992 16.342a2 2 0 0 1 .094 1.167l-1.065 3.29a1 1 0 0 0 1.236 1.168l3.413-.998a2 2 0 0 1 1.099.092 10 10 0 1 0-4.777-4.719\"/>\n              </svg>\n            </span>\n          </div>\n          <div className=\"art:mt-4 art:flex art:items-center art:justify-between art:text-xs art:text-muted-foreground\">\n            <span>\n              {\"Shared with the team\"}\n            </span>\n            <div className=\"art:flex art:-space-x-1.5\">\n              <span className=\"art:grid art:size-6 art:place-items-center art:rounded-full art:border art:border-border art:bg-background art:text-xs art:text-foreground\">\n                {\"J\"}\n              </span>\n              <span className=\"art:grid art:size-6 art:place-items-center art:rounded-full art:border art:border-border art:bg-background art:text-xs art:text-foreground\">\n                {\"A\"}\n              </span>\n              <span className=\"art:grid art:size-6 art:place-items-center art:rounded-full art:border art:border-border art:bg-background art:text-xs art:text-foreground\">\n                {\"M\"}\n              </span>\n            </div>\n          </div>\n        </motion.div>\n        <motion.div className=\"art:relative art:-mt-3 art:ml-7 art:rounded-2xl art:border art:border-border art:bg-background art:p-4 art:@min-[640px]/artemis:ml-12\" variants={pop(0.15)}>\n          <div className=\"art:flex art:items-center art:gap-2\">\n            <span className=\"art:grid art:size-7 art:place-items-center art:rounded-full art:border art:border-border art:text-xs\">\n              {\"JL\"}\n            </span>\n            <span className=\"art:text-xs art:font-medium\">\n              {\"Jamie\"}\n            </span>\n            <span className=\"art:ml-auto art:text-xs art:text-muted-foreground\">\n              {\"Now\"}\n            </span>\n          </div>\n          <p className=\"art:mt-3 art:text-sm art:leading-6\">\n            {\"This feels like us. Let\\u2019s give the opening a little more room.\"}\n          </p>\n          <motion.div className=\"art:mt-3 art:flex art:items-center art:gap-2 art:border-t art:border-border art:pt-3 art:text-xs art:text-muted-foreground\" variants={pop(0.15, 0.4)}>\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-check art:size-3.5\" aria-hidden=\"true\">\n              <path d=\"M20 6 9 17l-5-5\"/>\n            </svg>\n            {\"Alex updated the design\"}\n          </motion.div>\n        </motion.div>\n      </div>\n    </div>);\n}\nfunction LaunchArt({ reduce }: { reduce: boolean }) {\n    const pop = (delay: number, duration?: number) => popIn(reduce, delay, duration);\n    const BAR = growLine(reduce);\n    return (<div aria-hidden=\"true\" className=\"art:relative art:isolate art:flex art:h-112 art:items-center art:justify-center art:overflow-hidden art:rounded-3xl art:border art:border-border/50 art:px-6 art:pb-6 art:pt-12 art:@min-[640px]/artemis:p-10\">\n      <div className=\"art:absolute art:inset-0 art:-z-10 art:opacity-65 art:dark:opacity-15\" style={{ background: \"radial-gradient(ellipse at 10% 90%, #f4ccb7, transparent 70%), linear-gradient(135deg, #f8eee3, #d7e8f1)\" }}/>\n      <div className=\"art:pointer-events-none art:absolute art:inset-0 art:-z-10 art:opacity-10\" style={{ backgroundImage: \"radial-gradient(var(--artemis-foreground) 0.6px, transparent 0.6px)\", backgroundSize: \"18px 18px\" }}/>\n      <div className=\"art:absolute art:left-6 art:top-5 art:flex art:items-center art:gap-2 art:font-mono art:text-xs art:text-muted-foreground\">\n        <span className=\"art:size-1.5 art:rounded-full art:bg-current\"/>\n        {\"THE FINISHING TOUCH\"}\n      </div>\n      <div className=\"art:relative art:w-full art:max-w-xs\">\n        <motion.div className=\"art:rounded-2xl art:border art:border-border art:bg-background art:p-4 art:@min-[640px]/artemis:p-5\" variants={pop(0)}>\n          <div className=\"art:flex art:items-center art:justify-between\">\n            <span className=\"art:text-sm art:font-medium\">\n              {\"A new beginning\"}\n            </span>\n            <span className=\"art:rounded-full art:border art:border-border art:px-2.5 art:py-1 art:text-xs art:text-muted-foreground\">\n              {\"Release 1.0\"}\n            </span>\n          </div>\n          <div className=\"art:relative art:my-5 art:flex art:justify-between\">\n            <div className=\"art:absolute art:left-5 art:right-5 art:top-4 art:h-px art:bg-border\">\n              <motion.div className=\"art:h-full art:origin-left art:bg-primary\" variants={BAR}/>\n            </div>\n            <motion.div className=\"art:relative art:flex art:flex-col art:items-center art:gap-2\" variants={pop(0, 0.5)}>\n              <span className=\"art:grid art:size-8 art:place-items-center art:rounded-full art:border art:border-border art:bg-background\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-check art:size-3.5 art:text-primary\" aria-hidden=\"true\">\n                  <path d=\"M20 6 9 17l-5-5\"/>\n                </svg>\n              </span>\n              <span className=\"art:text-xs art:text-muted-foreground\">\n                {\"Create\"}\n              </span>\n            </motion.div>\n            <motion.div className=\"art:relative art:flex art:flex-col art:items-center art:gap-2\" variants={pop(0.15, 0.5)}>\n              <span className=\"art:grid art:size-8 art:place-items-center art:rounded-full art:border art:border-border art:bg-background\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-check art:size-3.5 art:text-primary\" aria-hidden=\"true\">\n                  <path d=\"M20 6 9 17l-5-5\"/>\n                </svg>\n              </span>\n              <span className=\"art:text-xs art:text-muted-foreground\">\n                {\"Review\"}\n              </span>\n            </motion.div>\n            <motion.div className=\"art:relative art:flex art:flex-col art:items-center art:gap-2\" variants={pop(0.3, 0.5)}>\n              <span className=\"art:grid art:size-8 art:place-items-center art:rounded-full art:border art:border-border art:bg-background\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-check art:size-3.5 art:text-primary\" aria-hidden=\"true\">\n                  <path d=\"M20 6 9 17l-5-5\"/>\n                </svg>\n              </span>\n              <span className=\"art:text-xs art:text-muted-foreground\">\n                {\"Publish\"}\n              </span>\n            </motion.div>\n          </div>\n          <div className=\"art:flex art:items-center art:gap-3 art:border-t art:border-border art:pt-5\">\n            <span className=\"art:grid art:size-10 art:shrink-0 art:place-items-center art:rounded-full art:bg-muted\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-send art:size-4\" aria-hidden=\"true\">\n                <path d=\"M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z\"/>\n                <path d=\"m21.854 2.147-10.94 10.939\"/>\n              </svg>\n            </span>\n            <div>\n              <p className=\"art:text-sm art:font-medium\">\n                {\"All the details. All done.\"}\n              </p>\n              <p className=\"art:mt-1 art:text-xs art:text-muted-foreground\">\n                {\"Made together. Ready to share.\"}\n              </p>\n            </div>\n          </div>\n        </motion.div>\n        <motion.div className=\"art:mx-4 art:-mt-px art:flex art:items-center art:justify-between art:rounded-b-2xl art:border art:border-border art:bg-background art:px-4 art:py-3 art:text-xs\" variants={pop(0.15)}>\n          <span className=\"art:flex art:items-center art:gap-2\">\n            <span className=\"art:size-1.5 art:rounded-full art:bg-primary\"/>\n            {\"Your project is live\"}\n          </span>\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-arrow-right art:size-3.5\" aria-hidden=\"true\">\n            <path d=\"M5 12h14\"/>\n            <path d=\"m12 5 7 7-7 7\"/>\n          </svg>\n        </motion.div>\n      </div>\n    </div>);\n}\nconst ARTS = [DraftArt, TeamArt, LaunchArt];\nexport default function FeatureSectionsAlternatingRows({ content }: { content?: Partial<ArtemisFeatureContent> } = {}) {\n    const copy = { ...DEFAULT, ...content };\n    const items: ArtemisFeatureItem[] = copy.items;\n    const reduce = useReducedMotion() ?? false;\n    return (<MotionConfig reducedMotion=\"user\">\n      <section className=\"art:w-full art:bg-background art:px-6 art:py-12 art:text-foreground art:@min-[640px]/artemis:px-10 art:@min-[640px]/artemis:py-16\">\n        <div className=\"art:mx-auto art:max-w-6xl\">\n          <div className=\"art:mx-auto art:mb-12 art:max-w-2xl art:text-center art:@min-[640px]/artemis:mb-16\">\n            <h2 className=\"art:text-balance art:text-4xl art:font-medium art:tracking-tight\">\n              {copy.headline}\n              {copy.headlineAccent ? ` ${copy.headlineAccent}` : null}\n            </h2>\n            {copy.subhead ? (<p className=\"art:mt-4 art:text-pretty art:text-sm art:leading-6 art:text-muted-foreground art:@min-[640px]/artemis:text-base\">\n              {copy.subhead}\n            </p>) : null}\n          </div>\n          <div className=\"art:space-y-14 art:@min-[640px]/artemis:space-y-20\">\n            {items.map((item, i) => {\n            const Art = ARTS[i % ARTS.length];\n            const flip = i % 2 === 1;\n            const number = String(i + 1).padStart(2, \"0\");\n            return (<div key={i} className=\"art:grid art:items-center art:gap-7 art:@min-[768px]/artemis:grid-cols-2 art:@min-[768px]/artemis:gap-12 art:@min-[1024px]/artemis:gap-20\">\n              <motion.div className={flip ? \"art:@min-[768px]/artemis:order-2\" : \"\"} initial=\"hidden\" whileInView=\"shown\" viewport={VISUAL_VIEWPORT}>\n                <Art reduce={reduce}/>\n              </motion.div>\n              <motion.div className={flip ? \"art:@min-[768px]/artemis:order-1\" : \"\"} initial={TEXT_HIDDEN} whileInView={TEXT_SHOWN} viewport={TEXT_VIEWPORT} transition={TEXT_TRANSITION}>\n                <p className=\"art:mb-4 art:font-mono art:text-xs art:text-muted-foreground\">\n                  {item.label ? `${number} / ${item.label}` : number}\n                </p>\n                <h3 className=\"art:text-balance art:text-xl art:font-medium art:tracking-tight\">\n                  {item.title}\n                </h3>\n                <p className=\"art:mt-3 art:text-pretty art:text-sm art:leading-7 art:text-muted-foreground art:@min-[640px]/artemis:text-base\">\n                  {item.description}\n                </p>\n                {item.bullets?.length ? (<ul className=\"art:mt-6 art:space-y-3\">\n                  {item.bullets.map((bullet, j) => (<li key={j} className=\"art:flex art:gap-3 art:text-sm\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-check art:mt-0.5 art:size-4 art:shrink-0 art:text-muted-foreground\" aria-hidden=\"true\">\n                      <path d=\"M20 6 9 17l-5-5\"/>\n                    </svg>\n                    {bullet}\n                  </li>))}\n                </ul>) : null}\n              </motion.div>\n            </div>);\n        })}\n          </div>\n        </div>\n      </section>\n    </MotionConfig>);\n}\n"
