      "path": "application/artemis/artemis-flip-card.tsx",
      "type": "registry:component",
      "target": "@components/application/artemis/artemis-flip-card.tsx",
      "content": "\"use client\";\nimport { ArtemisScope } from \"./artemis-scope\";\nimport Variant0 from \"./components/flip-card/variants/01-default\";\nconst variants = { default: Variant0 };\nexport interface ArtemisFlipCardProps {\n  className?: string;\n  variant?: \"default\";\n}\nexport function ArtemisFlipCard({ className, variant = \"default\" }: ArtemisFlipCardProps) {\n  const View = variants[variant];\n  return (\n    <ArtemisScope className={`art:[&>*]:mx-auto ${className ?? \"\"}`}>\n      <View />\n    </ArtemisScope>\n  );\n}\n"
    },
    {
      "path": "application/artemis/components/flip-card/variants/01-default.tsx",
      "type": "registry:component",
      "target": "@components/application/artemis/components/flip-card/variants/01-default.tsx",
      "content": "\"use client\";\n// @zeus-internal\nimport { useRef, useState } from \"react\";\nimport { motion, useReducedMotion } from \"motion/react\";\nimport { ARTEMIS_EASE_IN_OUT } from \"../../../lib/ease\";\nexport default function FlipCardDefault() {\n    const [flipped, setFlipped] = useState(false);\n    const buttons = useRef<Array<HTMLButtonElement | null>>([]);\n    const reduce = useReducedMotion() === true;\n    const flip = (back: boolean) => {\n        setFlipped(back);\n        requestAnimationFrame(() => buttons.current[back ? 1 : 0]?.focus({ preventScroll: true }));\n    };\n    return (<>\n      <div className=\"art:w-full art:max-w-80\">\n        <div className=\"art:relative art:aspect-[4/5] art:w-full art:[perspective:1400px]\" data-flipped={flipped}>\n          <motion.div className=\"art:absolute art:inset-0 art:[transform-style:preserve-3d] art:will-change-transform\" initial={false} animate={{ transform: flipped ? \"rotateY(180deg)\" : \"rotateY(0deg)\" }} transition={{ duration: reduce ? 0 : 0.48, ease: ARTEMIS_EASE_IN_OUT }}>\n            <div aria-hidden={flipped} inert={flipped} className=\"art:absolute art:inset-0 art:overflow-hidden art:border art:border-border art:bg-background art:[backface-visibility:hidden] art:[transform:translateZ(1px)] art:rounded-[1.75rem]\">\n              <button ref={(node) => { buttons.current[0] = node; }} onClick={() => flip(true)} type=\"button\" aria-label=\"Show the back of this card\" className=\"art:absolute art:inset-0 art:z-10 art:cursor-pointer art:outline-none art:focus-visible:ring-2 art:focus-visible:ring-ring art:focus-visible:ring-inset\"/>\n              <div className=\"art:pointer-events-none art:relative art:z-20 art:h-full art:w-full art:[&_a]:pointer-events-auto art:[&_button]:pointer-events-auto\">\n                <div className=\"art:relative art:h-full art:w-full\">\n                  <img src=\"/assets/artemis/00f08a1b00c26bee6c90.avif\" alt=\"Sunlit living room overlooking the coast\" width=\"900\" height=\"1200\" loading=\"lazy\" className=\"art:h-full art:w-full art:object-cover\"/>\n                  <span className=\"art:absolute art:top-4 art:right-4 art:grid art:size-10 art:place-items-center art:rounded-full art:border art:border-border/60 art:bg-background/55 art:text-foreground art:backdrop-blur-xl art:backdrop-saturate-150\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-rotate-ccw art:size-4\" aria-hidden=\"true\">\n                      <path d=\"M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8\"/>\n                      <path d=\"M3 3v5h5\"/>\n                    </svg>\n                  </span>\n                  <span className=\"art:absolute art:right-4 art:bottom-4 art:left-4 art:rounded-2xl art:border art:border-border/60 art:bg-background/55 art:p-4 art:text-foreground art:backdrop-blur-xl art:backdrop-saturate-150\">\n                    <span className=\"art:block art:font-medium art:text-muted-foreground art:text-sm\">\n                      {\"Residence\"}\n                    </span>\n                    <span className=\"art:mt-2 art:block art:font-medium art:text-xl\">\n                      {\"Coastal house\"}\n                    </span>\n                  </span>\n                </div>\n              </div>\n            </div>\n            <div aria-hidden={!flipped} inert={!flipped} className=\"art:absolute art:inset-0 art:overflow-hidden art:border art:border-border art:bg-background art:[backface-visibility:hidden] art:[transform:rotateY(180deg)_translateZ(1px)] art:rounded-[1.75rem]\">\n              <button ref={(node) => { buttons.current[1] = node; }} onClick={() => flip(false)} type=\"button\" aria-label=\"Show the front of this card\" className=\"art:absolute art:inset-0 art:z-10 art:cursor-pointer art:outline-none art:focus-visible:ring-2 art:focus-visible:ring-ring art:focus-visible:ring-inset\"/>\n              <div className=\"art:pointer-events-none art:relative art:z-20 art:h-full art:w-full art:[&_a]:pointer-events-auto art:[&_button]:pointer-events-auto\">\n                <div className=\"art:relative art:h-full art:w-full\">\n                  <img src=\"/assets/artemis/2ce5b4a2815dab6dd072.avif\" alt=\"Sculptural stone interior detail\" width=\"900\" height=\"1200\" loading=\"lazy\" className=\"art:h-full art:w-full art:object-cover\"/>\n                  <span className=\"art:absolute art:top-4 art:right-4 art:grid art:size-10 art:place-items-center art:rounded-full art:border art:border-border/60 art:bg-background/55 art:text-foreground art:backdrop-blur-xl art:backdrop-saturate-150\">\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-rotate-ccw art:size-4\" aria-hidden=\"true\">\n                      <path d=\"M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8\"/>\n                      <path d=\"M3 3v5h5\"/>\n                    </svg>\n                  </span>\n                  <span className=\"art:absolute art:right-4 art:bottom-4 art:left-4 art:rounded-2xl art:border art:border-border/60 art:bg-background/60 art:p-5 art:text-foreground art:backdrop-blur-xl art:backdrop-saturate-150\">\n                    <span className=\"art:block art:font-medium art:text-xl\">\n                      {\"Coastal house\"}\n                    </span>\n                    <span className=\"art:mt-2 art:block art:text-muted-foreground art:text-sm art:leading-6\">\n                      {\"A quiet home shaped around morning light and an open horizon\"}\n                    </span>\n                    <a href=\"#coastal-house\" className=\"art:mt-5 art:inline-flex art:h-10 art:items-center art:gap-2 art:rounded-full art:border art:border-border art:bg-background art:px-4 art:font-medium art:text-sm art:outline-none art:transition-colors art:hover:bg-muted art:focus-visible:ring-2 art:focus-visible:ring-ring\">\n                      {\"View project\"}\n                      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-arrow-up-right art:size-4\" aria-hidden=\"true\">\n                        <path d=\"M7 7h10v10\"/>\n                        <path d=\"M7 17 17 7\"/>\n                      </svg>\n                    </a>\n                  </span>\n                </div>\n              </div>\n            </div>\n          </motion.div>\n        </div>\n      </div>\n    </>);\n}\n"
    }
  ],
