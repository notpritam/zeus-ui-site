      "content": "\"use client\";\nimport { ArtemisScope } from \"./artemis-scope\";\nimport View0 from \"./components/ecommerce/variants/03-shopping-cart\";\nexport interface ArtemisEcommerceShoppingCartProps { className?: string;  }\nexport function ArtemisEcommerceShoppingCart({ className }: ArtemisEcommerceShoppingCartProps) {return <ArtemisScope className={className}><div className=\"art:flex art:w-full art:min-w-0 art:flex-col art:items-center\"><View0/></div></ArtemisScope>;}\n"
    },
    {
      "path": "application/artemis/components/ecommerce/variants/03-shopping-cart.tsx",
      "type": "registry:component",
      "target": "@components/application/artemis/components/ecommerce/variants/03-shopping-cart.tsx",
      "content": "\"use client\";\n// @zeus-internal\nimport { AnimatePresence, motion, useReducedMotion } from \"motion/react\";\nimport { useState } from \"react\";\nimport { ARTEMIS_EASE_OUT, ARTEMIS_SPRING_PRESS } from \"../../../lib/ease\";\nconst money = (value: number) => `$${value.toLocaleString(\"en-US\", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;\nconst BUTTON_MOTION = { whileHover: { scale: 1.01 }, whileTap: { scale: 0.99 }, transition: ARTEMIS_SPRING_PRESS };\nexport default function EcommerceShoppingCart() {\n    const reduced = useReducedMotion();\n    const buttonMotion = reduced ? {} : BUTTON_MOTION;\n    const [headphones, setHeadphones] = useState(1);\n    const [watch, setWatch] = useState(1);\n    const [message, setMessage] = useState(\"\");\n    const count = headphones + watch;\n    const subtotal = headphones * 129 + watch * 89;\n    const remove = (item: \"headphones\" | \"watch\") => {\n        if (item === \"headphones\") {\n            setHeadphones(0);\n            setMessage(\"Studio headphones removed.\");\n        }\n        else {\n            setWatch(0);\n            setMessage(\"Everyday watch removed.\");\n        }\n    };\n    return (<>\n      <section className=\"art:w-full art:bg-background art:px-4 art:py-16 art:text-foreground art:@min-[640px]/artemis:px-8 art:@min-[640px]/artemis:py-20\">\n        <div className=\"art:mx-auto art:max-w-6xl\">\n          <div className=\"art:flex art:flex-wrap art:items-end art:justify-between art:gap-4\">\n            <div>\n              <p className=\"art:text-sm art:text-muted-foreground\">\n                {\"A few good choices\"}\n              </p>\n              <h2 className=\"art:mt-3 art:tracking-tight art:text-xl art:font-medium\">\n                {\"Your shopping bag\"}\n              </h2>\n            </div>\n            <span className=\"art:text-sm art:text-muted-foreground\">\n              {count}\n              {\" \"}\n              {count === 1 ? \"item\" : \"items\"}\n            </span>\n          </div>\n          <div className=\"art:mt-9 art:grid art:items-start art:gap-10 art:@min-[1024px]/artemis:grid-cols-[minmax(0,1fr)_22rem] art:@min-[1024px]/artemis:gap-16\">\n            <div>\n              <AnimatePresence initial={false}>\n              {headphones > 0 && <motion.article key=\"headphones\" className=\"art:flex art:gap-4 art:border-b art:border-border art:py-6 art:first:pt-0 art:@min-[640px]/artemis:gap-6\" style={{ opacity: 1 }} exit={reduced ? { opacity: 0 } : { opacity: 0, x: -8 }} transition={{ duration: reduced ? 0 : 0.18, ease: ARTEMIS_EASE_OUT }}>\n                <div className=\"art:size-24 art:shrink-0 art:overflow-hidden art:rounded-2xl art:bg-muted art:@min-[640px]/artemis:size-32\">\n                  <img src=\"/assets/artemis/edca6a91e5cbdf9f7f6d.avif\" alt=\"Over-ear headphones against a warm yellow background\" width=\"256\" height=\"256\" loading=\"lazy\" className=\"art:size-full art:object-cover\"/>\n                </div>\n                <div className=\"art:min-w-0 art:flex-1\">\n                  <div className=\"art:flex art:items-start art:justify-between art:gap-3\">\n                    <div>\n                      <h3 className=\"art:text-xl art:font-medium\">\n                        {\"Studio headphones\"}\n                      </h3>\n                      <p className=\"art:mt-1 art:text-xs art:text-muted-foreground\">\n                        {\"Standard\"}\n                      </p>\n                    </div>\n                    <motion.button type=\"button\" className=\"art:inline-flex art:items-center art:justify-center art:font-medium art:select-none art:transition-colors art:disabled:pointer-events-none art:disabled:opacity-50 art:text-muted-foreground art:hover:bg-primary/5 art:hover:text-foreground art:focus-visible:outline-none art:focus-visible:ring-offset-2 art:focus-visible:ring-offset-background art:size-9 art:shrink-0 art:focus-visible:ring-2 art:focus-visible:ring-ring art:h-9 art:rounded-full\" aria-label=\"Remove Studio headphones\" title=\"Remove item\" tabIndex={0} {...buttonMotion} onClick={() => remove(\"headphones\")}>\n                      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-trash2 art:lucide-trash-2 art:size-4\" aria-hidden=\"true\">\n                        <path d=\"M10 11v6\"/>\n                        <path d=\"M14 11v6\"/>\n                        <path d=\"M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6\"/>\n                        <path d=\"M3 6h18\"/>\n                        <path d=\"M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\"/>\n                      </svg>\n                    </motion.button>\n                  </div>\n                  <div className=\"art:mt-4 art:flex art:flex-wrap art:items-center art:justify-between art:gap-3\">\n                    <div className=\"art:inline-flex art:items-center art:rounded-full art:bg-muted/60\">\n                      <motion.button type=\"button\" className=\"art:inline-flex art:items-center art:justify-center art:font-medium art:select-none art:transition-colors art:disabled:pointer-events-none art:disabled:opacity-50 art:text-muted-foreground art:hover:bg-primary/5 art:hover:text-foreground art:focus-visible:outline-none art:focus-visible:ring-offset-2 art:focus-visible:ring-offset-background art:size-9 art:focus-visible:ring-2 art:focus-visible:ring-ring art:h-9 art:rounded-full\" aria-label=\"Decrease Studio headphones quantity\" disabled={headphones === 1} tabIndex={0} {...buttonMotion} onClick={() => setHeadphones(value => Math.max(1, value - 1))}>\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-minus art:size-3.5\" aria-hidden=\"true\">\n                          <path d=\"M5 12h14\"/>\n                        </svg>\n                      </motion.button>\n                      <span className=\"art:min-w-7 art:text-center art:text-sm art:tabular-nums\">\n                        <span className=\"art:sr-only\">\n                          {\"Quantity: \"}\n                        </span>\n                        {headphones}\n                      </span>\n                      <motion.button type=\"button\" className=\"art:inline-flex art:items-center art:justify-center art:font-medium art:select-none art:transition-colors art:disabled:pointer-events-none art:disabled:opacity-50 art:text-muted-foreground art:hover:bg-primary/5 art:hover:text-foreground art:focus-visible:outline-none art:focus-visible:ring-offset-2 art:focus-visible:ring-offset-background art:size-9 art:focus-visible:ring-2 art:focus-visible:ring-ring art:h-9 art:rounded-full\" aria-label=\"Increase Studio headphones quantity\" disabled={headphones === 12} tabIndex={0} {...buttonMotion} onClick={() => setHeadphones(value => Math.min(12, value + 1))}>\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-plus art:size-3.5\" aria-hidden=\"true\">\n                          <path d=\"M5 12h14\"/>\n                          <path d=\"M12 5v14\"/>\n                        </svg>\n                      </motion.button>\n                    </div>\n                    <span className=\"art:text-sm art:font-medium art:tabular-nums\">\n                      {money(headphones * 129)}\n                    </span>\n                  </div>\n                </div>\n              </motion.article>}\n              {watch > 0 && <motion.article key=\"watch\" className=\"art:flex art:gap-4 art:border-b art:border-border art:py-6 art:first:pt-0 art:@min-[640px]/artemis:gap-6\" style={{ opacity: 1 }} exit={reduced ? { opacity: 0 } : { opacity: 0, x: -8 }} transition={{ duration: reduced ? 0 : 0.18, ease: ARTEMIS_EASE_OUT }}>\n                <div className=\"art:size-24 art:shrink-0 art:overflow-hidden art:rounded-2xl art:bg-muted art:@min-[640px]/artemis:size-32\">\n                  <img src=\"/assets/artemis/52d510674e9e2f9463ad.avif\" alt=\"Minimal wristwatch on a pale background\" width=\"256\" height=\"256\" loading=\"lazy\" className=\"art:size-full art:object-cover\"/>\n                </div>\n                <div className=\"art:min-w-0 art:flex-1\">\n                  <div className=\"art:flex art:items-start art:justify-between art:gap-3\">\n                    <div>\n                      <h3 className=\"art:text-xl art:font-medium\">\n                        {\"Everyday watch\"}\n                      </h3>\n                      <p className=\"art:mt-1 art:text-xs art:text-muted-foreground\">\n                        {\"Everyday\"}\n                      </p>\n                    </div>\n                    <motion.button type=\"button\" className=\"art:inline-flex art:items-center art:justify-center art:font-medium art:select-none art:transition-colors art:disabled:pointer-events-none art:disabled:opacity-50 art:text-muted-foreground art:hover:bg-primary/5 art:hover:text-foreground art:focus-visible:outline-none art:focus-visible:ring-offset-2 art:focus-visible:ring-offset-background art:size-9 art:shrink-0 art:focus-visible:ring-2 art:focus-visible:ring-ring art:h-9 art:rounded-full\" aria-label=\"Remove Everyday watch\" title=\"Remove item\" tabIndex={0} {...buttonMotion} onClick={() => remove(\"watch\")}>\n                      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-trash2 art:lucide-trash-2 art:size-4\" aria-hidden=\"true\">\n                        <path d=\"M10 11v6\"/>\n                        <path d=\"M14 11v6\"/>\n                        <path d=\"M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6\"/>\n                        <path d=\"M3 6h18\"/>\n                        <path d=\"M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\"/>\n                      </svg>\n                    </motion.button>\n                  </div>\n                  <div className=\"art:mt-4 art:flex art:flex-wrap art:items-center art:justify-between art:gap-3\">\n                    <div className=\"art:inline-flex art:items-center art:rounded-full art:bg-muted/60\">\n                      <motion.button type=\"button\" className=\"art:inline-flex art:items-center art:justify-center art:font-medium art:select-none art:transition-colors art:disabled:pointer-events-none art:disabled:opacity-50 art:text-muted-foreground art:hover:bg-primary/5 art:hover:text-foreground art:focus-visible:outline-none art:focus-visible:ring-offset-2 art:focus-visible:ring-offset-background art:size-9 art:focus-visible:ring-2 art:focus-visible:ring-ring art:h-9 art:rounded-full\" aria-label=\"Decrease Everyday watch quantity\" disabled={watch === 1} tabIndex={0} {...buttonMotion} onClick={() => setWatch(value => Math.max(1, value - 1))}>\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-minus art:size-3.5\" aria-hidden=\"true\">\n                          <path d=\"M5 12h14\"/>\n                        </svg>\n                      </motion.button>\n                      <span className=\"art:min-w-7 art:text-center art:text-sm art:tabular-nums\">\n                        <span className=\"art:sr-only\">\n                          {\"Quantity: \"}\n                        </span>\n                        {watch}\n                      </span>\n                      <motion.button type=\"button\" className=\"art:inline-flex art:items-center art:justify-center art:font-medium art:select-none art:transition-colors art:disabled:pointer-events-none art:disabled:opacity-50 art:text-muted-foreground art:hover:bg-primary/5 art:hover:text-foreground art:focus-visible:outline-none art:focus-visible:ring-offset-2 art:focus-visible:ring-offset-background art:size-9 art:focus-visible:ring-2 art:focus-visible:ring-ring art:h-9 art:rounded-full\" aria-label=\"Increase Everyday watch quantity\" disabled={watch === 8} tabIndex={0} {...buttonMotion} onClick={() => setWatch(value => Math.min(8, value + 1))}>\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-plus art:size-3.5\" aria-hidden=\"true\">\n                          <path d=\"M5 12h14\"/>\n                          <path d=\"M12 5v14\"/>\n                        </svg>\n                      </motion.button>\n                    </div>\n                    <span className=\"art:text-sm art:font-medium art:tabular-nums\">\n                      {money(watch * 89)}\n                    </span>\n                  </div>\n                </div>\n              </motion.article>}\n              </AnimatePresence>\n              {count === 0 && <div className=\"art:flex art:min-h-72 art:flex-col art:items-center art:justify-center art:text-center\"><span className=\"art:flex art:size-14 art:items-center art:justify-center art:rounded-full art:bg-muted\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-shopping-bag art:size-6\" aria-hidden=\"true\"><path d=\"M16 10a4 4 0 0 1-8 0\"/><path d=\"M3.103 6.034h17.794\"/><path d=\"M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z\"/></svg></span><h3 className=\"art:mt-5 art:text-xl art:font-medium\">Room for something good.</h3><p className=\"art:mt-2 art:text-sm art:text-muted-foreground\">Your bag is empty. Find a new everyday favorite.</p></div>}\n            </div>\n            <aside aria-label=\"Order summary\" className=\"art:rounded-3xl art:bg-muted/40 art:p-6 art:@min-[640px]/artemis:p-7\">\n              <h3 className=\"art:text-xl art:font-medium\">\n                {\"Order summary\"}\n              </h3>\n              <dl className=\"art:mt-6 art:space-y-4 art:text-sm\">\n                <div className=\"art:flex art:justify-between art:gap-4\">\n                  <dt className=\"art:text-muted-foreground\">\n                    {\"Subtotal\"}\n                  </dt>\n                  <dd className=\"art:tabular-nums\">\n                    {money(subtotal)}\n                  </dd>\n                </div>\n                <div className=\"art:flex art:justify-between art:gap-4\">\n                  <dt className=\"art:text-muted-foreground\">\n                    {\"Estimated shipping\"}\n                  </dt>\n                  <dd>\n                    {count > 0 ? \"Free\" : \"\\u2014\"}\n                  </dd>\n                </div>\n                <div className=\"art:flex art:justify-between art:gap-4 art:border-t art:border-border art:pt-4 art:font-medium\">\n                  <dt>\n                    {\"Estimated total\"}\n                  </dt>\n                  <dd className=\"art:tabular-nums\">\n                    {money(subtotal)}\n                  </dd>\n                </div>\n              </dl>\n              <p className=\"art:mt-3 art:text-xs art:leading-5 art:text-muted-foreground\">\n                {\"Taxes and final shipping calculated at checkout.\"}\n              </p>\n              <button type=\"button\" className=\"art:inline-flex art:items-center art:justify-center art:font-medium art:select-none art:transition-colors art:disabled:pointer-events-none art:disabled:opacity-50 art:bg-primary art:text-primary-foreground art:hover:bg-primary/90 art:gap-2 art:px-5 art:text-sm art:focus-visible:outline-none art:focus-visible:ring-offset-2 art:focus-visible:ring-offset-background art:mt-6 art:w-full art:focus-visible:ring-2 art:focus-visible:ring-ring art:h-9 art:rounded-full\" disabled tabIndex={0}>\n                {\"Continue to checkout\"}\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-arrow-right art:size-4\" aria-hidden=\"true\">\n                  <path d=\"M5 12h14\"/>\n                  <path d=\"m12 5 7 7-7 7\"/>\n                </svg>\n              </button>\n              <p className=\"art:mt-3 art:text-xs art:leading-5 art:text-muted-foreground\">\n                {\"Checkout is not connected in this preview.\"}\n              </p>\n              <output className=\"art:mt-3 art:block art:min-h-5 art:text-xs art:leading-5 art:text-muted-foreground\">{message}</output>\n            </aside>\n          </div>\n        </div>\n      </section>\n    </>);\n}\n"
    }
