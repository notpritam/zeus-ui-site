      "content": "\"use client\";\n// @zeus-internal\nimport { useSyncExternalStore } from \"react\";\nimport { motion } from \"motion/react\";\nimport { ARTEMIS_EASE_OUT, ARTEMIS_SPRING_PRESS } from \"../../../lib/ease\";\nconst reducedMotionQuery = \"(prefers-reduced-motion: reduce)\";\nfunction subscribeReducedMotion(onChange: () => void) {\n    const query = window.matchMedia(reducedMotionQuery);\n    query.addEventListener(\"change\", onChange);\n    return () => query.removeEventListener(\"change\", onChange);\n}\nfunction getReducedMotion() {\n    return window.matchMedia(reducedMotionQuery).matches;\n}\nfunction ConnectorPath({ d, delay, reducedMotion }: {\n    d: string;\n    delay: number;\n    reducedMotion: boolean;\n}) {\n    const props = {\n        d,\n        fill: \"none\",\n        stroke: \"currentColor\",\n        strokeWidth: \"1\",\n        opacity: \"1\",\n        pathLength: \"1\",\n        strokeDashoffset: \"0\",\n        strokeDasharray: \"1 1\",\n    };\n    if (reducedMotion)\n        return <path {...props}/>;\n    return <motion.path {...props} initial={{ opacity: 0 }} whileInView={{ opacity: 1 }} viewport={{ once: true }} transition={{ duration: 0.8, ease: ARTEMIS_EASE_OUT, delay }}/>;\n}\nexport default function WhatWeOfferConnectedWorkflow() {\n    const reducedMotion = useSyncExternalStore(subscribeReducedMotion, getReducedMotion, () => false);\n    return (<>\n      <section className=\"art:w-full art:text-foreground\">\n        <div className=\"art:mx-auto art:w-full art:max-w-7xl\">\n          <motion.div className=\"art:mx-auto art:max-w-3xl art:text-center\" initial={{ opacity: 0, transform: \"translateY(18px)\", filter: \"blur(8px)\" }} whileInView={reducedMotion ? undefined : { opacity: 1, transform: \"translateY(0px)\", filter: \"blur(0px)\" }} viewport={{ once: true, amount: 0.1 }} transition={{ duration: 0.6, ease: ARTEMIS_EASE_OUT }}>\n            <span className=\"art:inline-flex art:rounded-full art:bg-muted art:px-3 a