</span>\n                <h3 className=\"art:mt-6 art:font-medium art:text-xl art:leading-tight\">\n                  {\"Knowledge with permissions\"}\n                </h3>\n                <p className=\"art:mt-2 art:text-pretty art:text-muted-foreground art:text-sm art:leading-6\">\n                  {\"Retrieve useful context without losing the access rules around it.\"}\n                </p>\n              </motion.article>\n              <motion.article className=\"art:flex art:min-h-52 art:flex-col art:rounded-3xl art:border art:border-border art:bg-background art:p-5 art:@min-[640px]/artemis:p-6 art:@min-[1024px]/artemis:col-start-1 art:@min-[1024px]/artemis:row-start-2\" initial={{ opacity: 0, transform: \"translateY(16px)\", filter: \"blur(6px)\" }} whileInView={reducedMotion ? undefined : { opacity: 1, transform: \"translateY(0px)\", filter: \"blur(0px)\" }} viewport={{ once: true, amount: 0.1 }} transition={{ duration: 0.5, ease: ARTEMIS_EASE_OUT, delay: 0.32 }}>\n                <span className=\"art:grid art:size-10 art:place-items-center art:rounded-full art:bg-muted art:text-foreground\">\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-route art:size-4\" aria-hidden=\"true\">\n                    <circle cx=\"6\" cy=\"19\" r=\"3\"/>\n                    <path d=\"M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15\"/>\n                    <circle cx=\"18\" cy=\"5\" r=\"3\"/>\n                  </svg>\n                </span>\n                <h3 className=\"art:mt-6 art:font-medium art:text-xl art:leading-tight\">\n                  {\"Tools with clear boundaries\"}\n                </h3>\n                <p className=\"art:mt-2 art:text-pretty art:text-muted-foreground art:text-sm art:leading-6\">\n                  {\"Let agents act through explicit operations your team can approve.\"}\n                </p>\n              </motion.article>\n              <motion.article className=\"art:flex art:min-h-52 art:flex-col art:rounded-3xl art:border art:border-border art:bg-background art:p-5 art:@min-[640px]/artemis:p-6 art:@min-[1024px]/artemis:col-start-3 art:@min-[1024px]/artemis:row-start-2\" initial={{ opacity: 0, transform: \"translateY(16px)\", filter: \"blur(6px)\" }} whileInView={reducedMotion ? undefined : { opacity: 1, transform: \"translateY(0px)\", filter: \"blur(0px)\" }} viewport={{ once: true, amount: 0.1 }} transition={{ duration: 0.5, ease: ARTEMIS_EASE_OUT, delay: 0.39 }}>\n                <span className=\"art:grid art:size-10 art:place-items-center art:rounded-full art:bg-muted art:text-foreground\">\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-shield-check art:size-4\" aria-hidden=\"true\">\n                    <path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"/>\n                    <path d=\"m9 12 2 2 4-4\"/>\n                  </svg>\n                </span>\n                <h3 className=\"art:mt-6 art:font-medium art:text-xl art:leading-tight\">\n                  {\"Oversight at every step\"}\n                </h3>\n                <p className=\"art:mt-2 art:text-pretty art:text-muted-foreground art:text-sm art:leading-6\">\n                  {\"Review traces, quality, costs, and outcomes from one shared view.\"}\n                </p>\n              </motion.article>\n            </div>\n          </div>\n          <div className=\"art:mt-8 art:flex art:justify-center\">\n            <motion.a className=\"art:inline-flex art:items-center art:justify-center art:font-m