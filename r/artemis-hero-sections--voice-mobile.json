    }
  ],
  "description": "Hero sections, Voice mobile layout only",
  "dependencies": [
    "@paper-design/shaders-react@^0.0.81",
    "clsx@^2.1.1",
    "motion@^12.42.2",
    "tailwind-merge@^3.6.0"
  ],
  "registryDependencies": [
    "https://myzeusui.com/r/artemis-controls.json",
    "https://myzeusui.com/r/artemis-tokens.json"
  ],
  "files": [
    {
      "path": "application/artemis/artemis-hero-sections.tsx",
      "type": "registry:component",
      "target": "@components/application/artemis/artemis-hero-sections.tsx",
      "content": "\"use client\";\nimport {ArtemisScope} from \"./artemis-scope\";\nimport type { ArtemisHeroContent } from \"./components/hero-sections/content\";\nimport View2 from \"./components/hero-sections/variants/03-voice-mobile\";\nconst views={\"voice-mobile\":View2};\nexport type { ArtemisHeroContent, ArtemisHeroCta, ArtemisHeroForm, ArtemisHeroImage, ArtemisHeroLink, ArtemisHeroLogo, ArtemisHeroNav, ArtemisHeroPrompt } from \"./components/hero-sections/content\";\nexport interface ArtemisHeroSectionsProps {className?:string;variant?:\"voice-mobile\"; /** The words on the hero; anything left out keeps the layout's own copy. */ content?: Partial<ArtemisHeroContent>;}\nexport function ArtemisHeroSections({className,variant=\"voice-mobile\",content}:ArtemisHeroSectionsProps){const View=views[variant];return <ArtemisScope className={`art:[&>*]:mx-auto ${className??\"\"}`}><View content={content}/></ArtemisScope>;}\n"
    },
    {
      "path": "application/artemis/components/hero-sections/content.ts",
      "type": "registry:component",
      "target": "@components/application/artemis/components/hero-sections/content.ts",
      "content": "// @zeus-internal\n\n/** The words on a link, and where it goes. */\nexport interface ArtemisHeroLink {\n  label: string;\n  href: string;\n}\n\n/** The words on a button, and where it links. */\nexport interface ArtemisHeroCta {\n  label: string;\n  /** Where it links. analytics-flow and ai-teammates use only the label: their buttons scroll to the demo and open its brief. */\n  href?: string;\n}\n\n/** An image, and the words that stand in for it (empty when it only decorates). */\nexport interface ArtemisHeroImage {\n  src: string;\n  alt: string;\n}\n\n/** A customer or partner, shown by name. */\nexport interface ArtemisHeroLogo {\n  name: string;\n}\n\n/** The bar across the top of the layouts that have their own. */\nexport interface ArtemisHeroNav {\n  /** The name beside the logo mark, and where it links. Every layout with a bar. */\n  brand: ArtemisHeroLink;\n  /** Links in the bar and its mobile menu. Every layout with a bar. */\n  links: ArtemisHeroLink[];\n  /** The sign-in link. decision-spectrum, ai-marketplace and signal-aurora; left out, they show none. */\n  login?: ArtemisHeroLink;\n  /** The button at the end of the bar. voice-mobile, decision-spectrum, defi-routing and ai-marketplace; left out, they show none. */\n  cta?: ArtemisHeroLink;\n  /** The button in the open mobile menu, where its words differ from `cta`. voice-mobile, decision-spectrum, defi-routing and ai-marketplace; left out, the menu shows `cta`. */\n  menuCta?: ArtemisHeroLink;\n}\n\n/** An email field and its button. */\nexport interface ArtemisHeroForm {\n  /** The field's label, read by screen readers. */\n  label: string;\n  /** The hint in the empty field. */\n  placeholder: string;\n  /** The button's words. */\n  submit: string;\n}\n\n/** A box where visitors describe what they need. */\nexport interface ArtemisHeroPrompt {\n  /** The small title over the box. */\n  title: string;\n  /** The field's name, read by screen readers. */\n  label: string;\n  /** Example requests that take turns in the empty box. */\n  examples: string[];\n  /** The send button's name, read by screen readers. */\n  submit: string;\n  /** The line shown once a request is sent. */\n  confirmation: string;\n  /** Requests under the box; choosing one fills it in. */\n  suggestions: string[];\n}\n\n/** The words on an Artemis hero. Every layout reads this shape, so you can switch layouts and keep them. */\nexport interface ArtemisHeroContent {\n  /** The hero's own bar with the brand, links and buttons. voice-mobile, decision-spectrum, defi-routing, ai-marketplace and signal-aurora. */\n  nav?: ArtemisHeroNav;\n  /** A short line over the headline. All layouts but decision-spectrum. */\n  badge?: string;\n  /** Small faces beside the badge; screen readers skip them. split-demo. */\n  avatars?: ArtemisHeroImage[];\n  /** The headline, or its first part where a layout splits it. All layouts. */\n  headline: string;\n  /** The rest of the headline. analytics-flow mutes it and decision-spectrum sets it bolder; ai-teammates, voice-mobile, defi-routing and ai-marketplace start it on a new line; signal-aurora and split-demo run it on after the headline. It goes with `headline`: give a headline without it and the headline shows on its own; leave both out to keep the layout's own. */\n  headlineAccent?: string;\n  /** The paragraph under the headline. All layouts. */\n  subhead: string;\n  /** The main button. analytics-flow, ai-teammates, voice-mobile, decision-spectrum, signal-aurora and split-demo. */\n  cta?: ArtemisHeroCta;\n  /** The second button. analytics-flow, ai-teammates, voice-mobile, decision-spectrum and split-demo. */\n  secondaryCta?: ArtemisHeroCta;\n  /** An email field and its button, in place of buttons. defi-routing. */\n  form?: ArtemisHeroForm;\n  /** A box for describing what you need, in place of buttons. ai-marketplace. */\n  prompt?: ArtemisHeroPrompt;\n  /** A short line under the buttons. analytics-flow, ai-teammates and defi-routing. */\n  note?: string;\n  /** Short points with a check mark, under the buttons; two look best. voice-mobile. */\n  points?: string[];\n  /** A line under the picture beside the words. ai-teammates. */\n  caption?: string;\n  /** The line over the logos. decision-spectrum and split-demo. */\n  logosTitle?: string;\n  /** Customers or partners, shown by name. decision-spectrum, signal-aurora and split-demo. */\n  logos?: ArtemisHeroLogo[];\n}\n"
    },
    {
      "path": "application/artemis/components/hero-sections/variants/03-voice-mobile.tsx",
      "type": "registry:component",
      "target": "@components/application/artemis/components/hero-sections/variants/03-voice-mobile.tsx",
      "content": "\"use client\";\nimport {useId} from \"react\";\n// @zeus-internal\nimport { AnimatePresence, motion, useReducedMotion } from \"motion/react\";\nimport { useState } from \"react\";\nimport { Dithering } from \"@paper-design/shaders-react\";\nimport { ArtemisSharedLayoutBg } from \"../../../foundations/shared-layout-bg\";\nimport { ARTEMIS_EASE_OUT, ARTEMIS_SPRING_PANEL, ARTEMIS_SPRING_PRESS } from \"../../../lib/ease\";\nimport type { ArtemisHeroContent, ArtemisHeroNav } from \"../content\";\nconst DEFAULT = {\n    nav: {\n        brand: { label: \"Notes\", href: \"/\" },\n        links: [{ label: \"Features\", href: \"#features\" }, { label: \"How it works\", href: \"#how-it-works\" }, { label: \"Pricing\", href: \"#pricing\" }],\n        cta: { label: \"Get the app\", href: \"#download\" },\n        menuCta: { label: \"Download the app\", href: \"#download\" },\n    },\n    badge: \"AI voice notes for busy days\",\n    headline: \"Say it once.\",\n    headlineAccent: \"Keep moving.\",\n    subhead: \"Notes turns loose thoughts into clear notes, follow-ups, and reminders before the moment disappears.\",\n    cta: { label: \"Download for iPhone\", href: \"#download\" },\n    secondaryCta: { label: \"See how it works\", href: \"#demo\" },\n    points: [\"No typing required\", \"Private by default\"],\n} satisfies ArtemisHeroContent;\nexport default function HeroSectionsVoiceMobile({ content }: { content?: Partial<ArtemisHeroContent> } = {}) {\nconst copy = { ...DEFAULT, ...content };\nconst accent = content?.headline === undefined ? copy.headlineAccent : content.headlineAccent;\nconst nav: ArtemisHeroNav = copy.nav;\nconst menuCta = nav.menuCta ?? nav.cta;\nconst artemisInstanceId=useId();\n\n    const reduce = useReducedMotion();\n    const [open, setOpen] = useState(false);\n    const press = { whileHover: reduce ? undefined : { scale: 1.01 }, whileTap: reduce ? undefined : { scale: 0.98 }, transition: ARTEMIS_SPRING_PRESS };\n    const reveal = (delay: number, offset = 16, duration = 0.6) => ({\n        initial: reduce ? false as const : { opacity: 0, transform: `translateY(${offset}px)` },\n        animate: { opacity: 1, transform: \"translateY(0px)\" },\n        transition: { duration: reduce ? 0 : duration, delay: reduce ? 0 : delay, ease: ARTEMIS_EASE_OUT },\n    });\n    return (<>\n      <section className=\"art:w-full art:overflow-hidden art:bg-background art:text-foreground\">\n        <nav className=\"art:relative art:z-30 art:mx-auto art:flex art:h-20 art:w-full art:max-w-7xl art:items-center art:justify-between art:px-5 art:@min-[640px]/artemis:px-8 art:@min-[1024px]/artemis:h-24\">\n          <a href={nav.brand.href} className=\"art:flex art:min-h-10 art:items-center art:gap-2.5 art:rounded-full art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-ring art:focus-visible:ring-offset-2\" aria-label={`${nav.brand.label} home`}>\n            <span className=\"art:grid art:size-8 art:place-items-center art:rounded-full art:border art:border-border art:bg-muted\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-audio-lines art:size-4\" aria-hidden=\"true\">\n                <path d=\"M2 10v3\"/>\n                <path d=\"M6 6v11\"/>\n                <path d=\"M10 3v18\"/>\n                <path d=\"M14 8v7\"/>\n                <path d=\"M18 5v13\"/>\n                <path d=\"M22 10v3\"/>\n              </svg>\n            </span>\n            <span className=\"art:font-semibold art:tracking-[-0.03em]\">\n              {nav.brand.label}\n            </span>\n          </a>\n          <div className=\"art:hidden art:@min-[768px]/artemis:block\">\n            <ArtemisSharedLayoutBg className=\"art:flex art:w-auto art:flex-row art:items-center art:gap-0.5\" inset={0} pillClassName=\"art:rounded-full art:bg-muted\">\n              {nav.links.map(link => <a key={link.href} href={link.href} className=\"art:relative art:rounded-full art:px-3.5 art:py-2 art:text-sm art:text-muted-foreground art:transition-colors art:hover:text-foreground art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-ring\">{link.label}</a>)}\n            </ArtemisSharedLayoutBg>\n          </div>\n          <div className=\"art:flex art:items-center art:gap-1\">\n            {nav.cta ? <motion.a {...press} className=\"art:items-center art:justify-center art:font-medium art:select-none art:transition-colors art:disabled:pointer-events-none art:disabled:opacity-50 art:bg-primary art:text-primary-foreground art:hover:bg-primary/90 art:gap-1.5 art:px-3 art:text-xs art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-ring art:focus-visible:ring-offset-2 art:focus-visible:ring-offset-background art:hidden art:@min-[640px]/artemis:inline-flex art:h-9 art:rounded-full\" href={nav.cta.href} tabIndex={0}>\n              {nav.cta.label}\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-arrow-up-right art:size-3.5\" aria-hidden=\"true\">\n                <path d=\"M7 7h10v10\"/>\n                <path d=\"M7 17 17 7\"/>\n              </svg>\n            </motion.a> : null}\n            <motion.button {...press} type=\"button\" className=\"art:items-center art:justify-center art:select-none art:disabled:pointer-events-none art:disabled:opacity-50 art:gap-2 art:text-sm art:focus-visible:ring-offset-2 art:focus-visible:ring-offset-background art:p-0 art:font-normal art:relative art:grid art:size-10 art:place-items-center art:text-muted-foreground art:transition-colors art:hover:bg-muted art:hover:text-foreground art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-ring art:@min-[768px]/artemis:hidden art:rounded-full\" aria-label={open ? \"Close navigation\" : \"Open navigation\"} aria-expanded={open} onClick={() => setOpen(value => !value)} aria-controls=\"sona-mobile-navigation\" tabIndex={0}>\n              <span className=\"art:relative art:block art:h-4 art:w-5\" aria-hidden=\"true\">\n                <motion.span className=\"art:absolute art:left-0 art:block art:h-px art:w-5 art:origin-center art:bg-current\" animate={{ transform: open ? \"translateY(7px) rotate(45deg)\" : \"translateY(3px) rotate(0deg)\" }} transition={reduce ? { duration: 0 } : ARTEMIS_SPRING_PANEL}/>\n                <motion.span className=\"art:absolute art:left-0 art:block art:h-px art:w-5 art:origin-center art:bg-current\" animate={{ transform: open ? \"translateY(7px) rotate(-45deg) scaleX(1)\" : \"translateY(11px) rotate(0deg) scaleX(0.7)\" }} transition={reduce ? { duration: 0 } : ARTEMIS_SPRING_PANEL}/>\n              </span>\n            </motion.button>\n          </div>\n          <AnimatePresence>\n            {open ? <motion.div id={`${artemisInstanceId}-sona-mobile-navigation`} className=\"art:absolute art:top-[calc(100%-4px)] art:right-5 art:left-5 art:origin-top art:overflow-hidden art:rounded-3xl art:border art:border-border art:bg-background/90 art:p-2 art:backdrop-blur-2xl art:@min-[640px]/artemis:right-8 art:@min-[640px]/artemis:left-8 art:@min-[768px]/artemis:hidden\" initial={reduce ? false : { opacity: 0, transform: \"translateY(-8px) scale(0.985)\", filter: \"blur(4px)\" }} animate={{ opacity: 1, transform: \"translateY(0px) scale(1)\", filter: \"blur(0px)\" }} exit={{ opacity: 0, transform: \"translateY(-6px) scale(0.985)\", filter: \"blur(3px)\" }} transition={reduce ? { duration: 0 } : ARTEMIS_SPRING_PANEL}>\n              <div className=\"art:grid\">\n                {nav.links.map(link => <a key={link.href} href={link.href} onClick={() => setOpen(false)} className=\"art:flex art:min-h-11 art:items-center art:rounded-2xl art:px-4 art:text-sm art:text-muted-foreground art:transition-colors art:hover:bg-muted art:hover:text-foreground art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-ring\">{link.label}</a>)}\n              </div>\n              {menuCta ? <motion.a {...press} className=\"art:inline-flex art:items-center art:justify-center art:font-medium art:select-none art:transition-colors art:disabled:pointer-events-none art:disabled:opacity-50 art:bg-primary art:text-primary-foreground art:hover:bg-primary/90 art:gap-2 art:px-5 art:text-sm art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-ring art:focus-visible:ring-offset-2 art:focus-visible:ring-offset-background art:mt-1 art:w-full art:h-9 art:rounded-full\" href={menuCta.href} tabIndex={0} onClick={() => setOpen(false)}>{menuCta.label}<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-arrow-up-right art:size-3.5\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"/><path d=\"M7 17 17 7\"/></svg></motion.a> : null}\n            </motion.div> : null}\n          </AnimatePresence>\n        </nav>\n        <div className=\"art:mx-auto art:grid art:w-full art:max-w-7xl art:gap-4 art:px-4 art:pb-4 art:@min-[640px]/artemis:px-6 art:@min-[640px]/artemis:pb-6 art:@min-[1024px]/artemis:grid-cols-2 art:@min-[1024px]/artemis:px-8\">\n          <div className=\"art:flex art:min-h-[34rem] art:flex-col art:justify-center art:rounded-3xl art:bg-background art:px-7 art:py-16 art:@min-[640px]/artemis:px-12 art:@min-[1024px]/artemis:h-[42rem] art:@min-[1024px]/artemis:min-h-0 art:@min-[1024px]/artemis:px-14\">\n            <motion.p className=\"art:text-sm art:font-medium art:text-muted-foreground\" {...reveal(0.02, 16, 0.6)}>\n              {copy.badge}\n            </motion.p>\n            <motion.h1 className=\"art:text-balance art:font-sans art:font-medium art:text-5xl art:@min-[768px]/artemis:text-6xl art:leading-[0.94] art:tracking-[-0.055em] art:mt-7 art:max-w-xl\" {...reveal(0.08, 22, 0.6)}>\n              <span className=\"art:block\">\n                {copy.headline}\n              </span>\n              {accent ? <span className=\"art:block\">\n                {accent}\n              </span> : null}\n            </motion.h1>\n            <motion.p className=\"art:mt-8 art:max-w-md art:text-pretty  art:leading-7 art:text-muted-foreground  art:text-sm art:@min-[640px]/artemis:text-base\" {...reveal(0.16, 16, 0.6)}>\n              {copy.subhead}\n            </motion.p>\n            <motion.div className=\"art:mt-9 art:flex art:flex-wrap art:gap-3\" {...reveal(0.24, 16, 0.6)}>\n              <motion.a {...press} className=\"art:inline-flex art:items-center art:justify-center art:font-medium art:select-none art:transition-colors art:disabled:pointer-events-none art:disabled:opacity-50 art:bg-primary art:text-primary-foreground art:hover:bg-primary/90 art:h-12 art:gap-2 art:px-6 art:text-base art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-ring art:focus-visible:ring-offset-2 art:focus-visible:ring-offset-background art:rounded-full\" href={copy.cta.href} tabIndex={0}>\n                {copy.cta.label}\n              </motion.a>\n              <motion.a {...press} className=\"art:inline-flex art:items-center art:justify-center art:font-medium art:select-none art:transition-colors art:disabled:pointer-events-none art:disabled:opacity-50 art:border art:border-border art:bg-transparent art:text-foreground art:hover:bg-primary/5 art:h-12 art:gap-2 art:px-6 art:text-base art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-ring art:focus-visible:ring-offset-2 art:focus-visible:ring-offset-background art:rounded-full\" href={copy.secondaryCta.href} tabIndex={0}>\n                {copy.secondaryCta.label}\n              </motion.a>\n            </motion.div>\n            <motion.div className=\"art:mt-12 art:flex art:items-center art:gap-5 art:border-border art:border-t art:pt-5 art:text-xs art:text-muted-foreground\" {...reveal(0.32, 16, 0.6)}>\n              {copy.points.map((point, index) => <span key={index} className=\"art:flex art:items-center art:gap-1.5\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-check art:size-3.5\" aria-hidden=\"true\">\n                  <path d=\"M20 6 9 17l-5-5\"/>\n                </svg>\n                {point}\n              </span>)}\n            </motion.div>\n          </div>\n          <motion.div className=\"art:relative art:isolate art:flex art:min-h-[38rem] art:items-center art:justify-center art:overflow-hidden art:rounded-3xl art:border art:border-border art:bg-muted art:@min-[1024px]/artemis:h-[42rem] art:@min-[1024px]/artemis:min-h-0\" {...reveal(0.12, 28, 0.6)}>\n            <div className=\"art:absolute art:inset-0\" aria-hidden=\"true\">\n              <Dithering className=\"art:size-full\" colorBack=\"#dff4ea\" colorFront=\"#f6bd9d\" shape=\"wave\" type=\"4x4\" size={3} scale={1.12} speed={reduce ? 0 : 0.12}/>\n            </div>\n            <div className=\"art:pointer-events-none art:absolute art:inset-0 art:bg-[linear-gradient(to_bottom,transparent_45%,hsl(var(--artemis-background)/0.16))]\" aria-hidden=\"true\"/>\n            <div className=\"art:relative art:z-10 art:mx-auto art:flex art:h-full art:w-full art:items-center art:justify-center art:px-5 art:@min-[640px]/artemis:px-10 art:@min-[1024px]/artemis:px-8 art:@min-[1280px]/artemis:px-14\">\n              <motion.div className=\"art:relative art:h-[36rem] art:w-full art:max-w-[21rem] art:rounded-3xl art:border-[7px] art:border-foregroun