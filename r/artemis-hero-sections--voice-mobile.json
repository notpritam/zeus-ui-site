{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "artemis-hero-sections--voice-mobile",
  "type": "registry:block",
  "title": "Hero sections: Voice mobile",
  "variants": [
    {
      "name": "voice-mobile",
