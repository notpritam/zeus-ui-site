      "target": "@components/application/artemis/artemis-feature-sections.tsx",
      "content": "\"use client\";\nimport { ArtemisScope } from \"./artemis-scope\";\nimport type { ArtemisFeatureContent } from \"./components/feature-sections/content\";\nimport View7 from \"./components/feature-sections/variants/08-voice-ai\";\nconst variants = {\"voice-ai\":View7};\nexport type { ArtemisFeatureContent, ArtemisFeatureImage, ArtemisFeatureItem, ArtemisFeatureLink } from \"./components/feature-sections/content\";\nexport interface ArtemisFeatureSectionsProps { className?: string; variant?: \"voice-ai\"; /** The words on the feature section; anything left out keeps the layout's own copy. */ content?: Partial<ArtemisFeatureContent>; }\nexport function ArtemisFeatureSections({ className, variant = \"voice-ai\", content }: ArtemisFeatureSectionsProps) {const View = variants[variant];return <ArtemisScope className={className}><div className=\"art:flex art:w-full art:min-w-0 art:flex-col art:items-center\"><View content={content}/></div></ArtemisScope>;}\n"
    },
    {
      "path": "application/artemis/components/feature-sections/content.ts",
      "type": "registry:component",
      "target": "@components/application/artemis/components/feature-sections/content.ts",
      "content": "// @zeus-internal\nimport type { ComponentType } from \"react\";\n\n/** The words on a link or button, and where it goes. */\nexport interface ArtemisFeatureLink {\n  label: string;\n  href: string;\n}\n\n/** A picture shown as content, and the words that stand in for it. */\nexport interface ArtemisFeatureImage {\n  src: string;\n  alt: string;\n}\n\n/** One feature: a row, card, step or tab, depending on the layout. */\nexport interface ArtemisFeatureItem {\n  /** The feature's name. All layouts; signal-grid puts its first word on a line of its own. */\n  title: string;\n  /** A sentence or two about the feature. All layouts; product-hotspots, steps, tabs and stage-tabs show it for the chosen feature only. */\n  description: string;\n  /** A short name: the tab in tabs and stage-tabs (which show the title when you leave this out), and the words after the number in alternating-rows. */\n  label?: string;\n  /** Short points under the description. alternating-rows, product-hotspots and tabs. */\n  bullets?: string[];\n  /** A figure shown large. voice-ai (first card) and control-deck (third and fourth cards; on the third, a trailing % is set small and fills the bar). */\n  stat?: string;\n  /** The feature's icon. visual-benefits, signal-grid, voice-ai (first card), control-deck (fourth and fifth cards) and tabs, which keep their own icon for that slot when you leave this out. */\n  icon?: ComponentType<{ className?: string }>;\n  /** A product picture. tabs, which shows its own picture for that slot when you leave this out. */\n  image?: ArtemisFeatureImage;\n}\n\n/**\n * The words on an Artemis feature section. Every layout reads this shape, so you can switch layouts and keep them.\n * An empty `badge`, `headlineAccent` or `subhead` leaves that line out.\n */\nexport interface ArtemisFeatureContent {\n  /** A short line above the headline. All layouts except visual-benefits, alternating-rows and stage-tabs. */\n  badge?: string;\n  /** The section heading. All layouts except stage-tabs. */\n  headline?: string;\n  /**\n   * The second part of the heading. showcase, signal-grid, control-deck, voice-ai, list, bento and tabs put it on a\n   * line of its own, steps sets it in the accent color, and the other layouts with a heading run it on after the\n   * headline. It goes with `headline`: give a headline without it and the heading has no second part.\n   */\n  headlineAccent?: string;\n  /** A sentence or two under the heading. All layouts except visual-benefits, tabs and stage-tabs. */\n  subhead?: string;\n  /**\n   * The features. All layouts. Today's counts look best: three in visual-benefits, alternating-rows, showcase,\n   * benefits-triptych and steps; four in product-hotspots, voice-ai, list, tabs and stage-tabs; five in control-deck\n   * (which shows no more than five) and bento; six in signal-grid.\n   */\n  items: ArtemisFeatureItem[];\n  /** The button under the features. visual-benefits. */\n  cta?: ArtemisFeatureLink;\n}\n"
    },
    {
      "path": "application/artemis/components/feature-sections/variants/08-voice-ai.tsx",
      "type": "registry:component",
      "target": "@components/application/artemis/components/feature-sections/variants/08-voice-ai.tsx",
      "content": "\"use client\";\n// @zeus-internal\nimport { motion, useReducedMotion, type HTMLMotionProps } from \"motion/react\";\nimport { ARTEMIS_EASE_IN_OUT, ARTEMIS_EASE_OUT } from \"../../../lib/ease\";\nimport type { ArtemisFeatureContent, ArtemisFeatureItem } from \"../content\";\nconst DEFAULT = {\n    badge: \"AI voice, built for service\",\n    headline: \"Every call answered.\",\n    headlineAccent: \"Every task moving.\",\n    subhead: \"Natural conversations, clear summaries, and actions that carry into the tools your team already uses.\",\n    items: [\n        { title: \"Always ready to answer\", description: \"One consistent voice across every hour, queue, and time zone.\", stat: \"24/7\" },\n        { title: \"Natural conversations\", description: \"Fast turn-taking and expressive speech keep every call moving.\" },\n        { title: \"Every call, understood\", description: \"The transcript, intent, and next step arrive together when the call ends.\" },\n        { title: \"Acts while it talks\", description: \"Book, update, and hand off work without sending the caller somewhere else.\" },\n    ],\n} satisfies ArtemisFeatureContent;\nconst HIDDEN = { opacity: 0, transform: \"translateY(18px)\", filter: \"blur(6px)\" };\nconst SHOWN = { opacity: 1, transform: \"translateY(0px)\", filter: \"blur(0px)\" };\nconst BAR_SCALE = [\"scaleY(0.55)\", \"scaleY(1)\", \"scaleY(0.55)\"];\nfunction barTransition(index: number) {\n    return { duration: 1.45 + (index % 4) * 0.17, delay: index * 0.05, repeat: Infinity, ease: ARTEMIS_EASE_IN_OUT };\n}\ntype RevealProps = HTMLMotionProps<\"article\"> & {\n    index: number;\n    reduce: boolean;\n};\nfunction Reveal({ index, reduce, ...props }: RevealProps) {\n    return (<motion.article initial={reduce ? SHOWN : HIDDEN} whileInView={SHOWN} viewport={{ once: true, margin: \"-60px\" }} transition={{ duration: 0.5, ease: ARTEMIS_EASE_OUT, delay: index * 0.07 }} {...props}/>);\n}\nfunction PhoneCallIcon({ className }: { className?: string }) {\n    return (<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className={`art:lucide art:lucide-phone-call ${className}`} aria-hidden=\"true\">\n      <path d=\"M13 2a9 9 0 0 1 9 9\"/>\n      <path d=\"M13 6a5 5 0 0 1 5 5\"/>\n      <path d=\"M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384\"/>\n    </svg>);\n}\ntype CardProps = {\n    item: ArtemisFeatureItem;\n    index: number;\n    reduce: boolean;\n};\nfunction AlwaysOnCard({ item, index, reduce }: CardProps) {\n    const Icon = item.icon ?? PhoneCallIcon;\n    return (<Reveal index={index} reduce={reduce} className=\"art:relative art:overflow-hidden art:rounded-3xl art:border art:border-border art:p-6 art:@min-[640px]/artemis:p-8 art:min-h-[22rem] art:bg-foreground art:text-background art:@min-[1024px]/artemis:col-span-5\">\n      <div className=\"art:relative art:flex art:h-full art:min-h-[18rem] art:flex-col art:justify-end art:overflow-hidden\">\n        <div aria-hidden=\"true\" className=\"art:absolute art:inset-x-0 art:top-2 art:select-none art:whitespace-nowrap art:text-left art:font-medium art:text-7xl art:text-background/10 art:leading-tight art:tracking-[-0.06em] art:@min-[640px]/artemis:text-8xl\">\n          {\"VOICE\"}\n        </div>\n        <div className=\"art:relative\">\n          <span className=\"art:grid art:size-12 art:place-items-center art:rounded-full art:bg-background/10 art:text-background\">\n            <Icon className=\"art:size-5\"/>\n          </span>\n          {item.stat ? (<p className=\"art:mt-8 art:font-medium art:text-4xl art:leading-none art:tracking-tight\">\n            {item.stat}\n          </p>) : null}\n          <h3 className=\"art:mt-4 art:font-medium art:text-xl\">\n            {item.title}\n          </h3>\n          <p className=\"art:mt-2 art:max-w-sm art:text-background/70 art:text-sm art:leading-6\">\n            {item.description}\n          </p>\n        </div>\n      </div>\n    </Reveal>);\n}\nfunction ConversationCard({ item, index, reduce }: CardProps) {\n    return (<Reveal index={index} reduce={reduce} className=\"art:relative art:overflow-hidden art:rounded-3xl art:border art:border-border art:min-h-[22rem] art:bg-background art:p-0 art:@min-[640px]/artemis:p-0 art:@min-[1024px]/artemis:col-span-7\">\n      <div className=\"art:relative art:flex art:h-full art:min-h-[22rem] art:flex-col art:overflow-hidden art:p-6 art:@min-[640px]/artemis:p-8\">\n        <div aria-hidden=\"true\" className=\"art:pointer-events-none art:absolute art:inset-0 art:overflow-hidden art:opacity-60 art:[mask-image:linear-gradient(to_left,black,transparent)]\">\n          <img src=\"/assets/artemis/19483c4839431a1235ac.webp\" alt=\"\" width=\"768\" height=\"768\" loading=\"lazy\" decoding=\"async\" className=\"art:size-full art:object-cover\" style={{ objectPosition: \"center\" }}/>\n          <div className=\"art:absolute art:inset-0 art:bg-background/10 art:dark:bg-background/65\"/>\n        </div>\n        <div className=\"art:relative art:z-10 art:max-w-xs\">\n          <h3 className=\"art:font-medium art:text-foreground art:text-xl\">\n            {item.title}\n          </h3>\n          <p className=\"art:mt-2 art:text-muted-foreground art:text-sm art:leading-6\">\n            {item.description}\n          </p>\n        </div>\n        <div className=\"art:relative art:z-10 art:mt-8 art:flex art:flex-1 art:items-end art:justify-end art:@min-[640px]/artemis:mt-2\">\n          <div className=\"art:relative art:mr-5 art:w-48 art:rounded-3xl art:border-4 art:border-foreground art:bg-background art:p-3 art:pb-5 art:@min-[640px]/artemis:mr-8 art:@min-[640px]/artemis:w-52\">\n            <div className=\"art:flex art:items-center art:justify-between art:font-mono art:text-xs art:text-muted-foreground\">\n              <span>\n                {\"9:41\"}\n              </span>\n              <span>\n                {\"AI voice\"}\n              </span>\n            </div>\n            <div className=\"art:mt-8 art:text-center\">\n              <span className=\"art:mx-auto art:grid art:size-12 art:place-items-center art:rounded-full art:bg-muted art:text-foreground\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-mic art:size-5\" aria-hidden=\"true\">\n                  <path d=\"M12 19v3\"/>\n                  <path d=\"M19 10v2a7 7 0 0 1-14 0v-2\"/>\n                  <rect x=\"9\" y=\"2\" width=\"6\" height=\"13\" rx=\"3\"/>\n                </svg>\n              </span>\n              <p className=\"art:mt-3 art:font-medium art:text-foreground art:text-sm\">\n                {\"Assistant\"}\n              </p>\n              <p className=\"art:mt-1 art:text-muted-foreground art:text-xs\">\n                {\"listening\"}\n              </p>\n              <div aria-hidden=\"true\" className=\"art:mt-4 art:flex art:h-14 art:items-center art:justify-center art:gap-1\">\n                <motion.span className=\"art:w-1 art:rounded-full art:bg-foreground\" style={{ height: \"6.959999999999999px\" }} animate={reduce ? undefined : { transform: BAR_SCALE }} transition={barTransition(0)}/>\n                <motion.span className=\"art:w-1 art:rounded-full art:bg-foreground\" style={{ height: \"13.919999999999998px\" }} animate={reduce ? undefined : { transform: BAR_SCALE }} transition={barTransition(1)}/>\n                <motion.span className=\"art:w-1 art:rounded-full art:bg-foreground\" style={{ height: \"22.04px\" }} animate={reduce ? undefined : { transform: BAR_SCALE }} transition={barTransition(2)}/>\n                <motion.span className=\"art:w-1 art:rounded-full art:bg-foreground\" style={{ height: \"11.6px\" }} animate={reduce ? undefined : { transform: BAR_SCALE }} transition={barTransition(3)}/>\n                <motion.span className=\"art:w-1 art:rounded-full art:bg-foreground\" style={{ height: \"26.68px\" }} animate={reduce ? undefined : { transform: BAR_SCALE }} transition={barTransition(4)}/>\n                <motion.span className=\"art:w-1 art:rounded-full art:bg-foreground\" style={{ height: \"17.4px\" }} animate={reduce ? undefined : { transform: BAR_SCALE }} transition={barTransition(5)}/>\n                <motion.span className=\"art:w-1 art:rounded-full art:bg-foreground\" style={{ height: \"30.159999999999997px\" }} animate={reduce ? undefined : { transform: BAR_SCALE }} transition={barTransition(6)}/>\n                <motion.span className=\"art:w-1 art:rounded-full art:bg-foreground\" style={{ height: \"20.88px\" }} animate={reduce ? undefined : { transform: BAR_SCALE }} transition={barTransition(7)}/>\n                <motion.span className=\"art:w-1 art:rounded-full art:bg-foreground\" style={{ height: \"12.76px\" }} animate={reduce ? undefined : { transform: BAR_SCALE }} transition={barTransition(8)}/>\n                <motion.span className=\"art:w-1 art:rounded-full art:bg-foreground\" style={{ height: \"24.36px\" }} animate={reduce ? undefined : { transform: BAR_SCALE }} transition={barTransition(9)}/>\n                <motion.span className=\"art:w-1 art:rounded-full art:bg-foreground\" style={{ height: \"16.24px\" }} animate={reduce ? undefined : { transform: BAR_SCALE }} transition={barTransition(10)}/>\n                <motion.span className=\"art:w-1 art:rounded-full art:bg-foreground\" style={{ height: \"9.28px\" }} animate={reduce ? undefined : { transform: BAR_SCALE }} transition={barTransition(11)}/>\n              </div>\n            </div>\n            <div className=\"art:mt-4 art:flex art:justify-center\">\n              <span className=\"art:grid art:size-10 art:place-items-center art:rounded-full art:bg-foreground art:text-background\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-phone-off art:size-4\" aria-hidden=\"true\">\n                  <path d=\"M10.1 13.9a14 14 0 0 0 3.732 2.668 1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2 18 18 0 0 1-12.728-5.272\"/>\n                  <path d=\"M22 2 2 22\"/>\n                  <path d=\"M4.76 13.582A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 .244.473\"/>\n                </svg>\n              </span>\n            </div>\n          </div>\n          <motion.div className=\"art:absolute art:right-28 art:bottom-12 art:flex art:min-w-52 art:items-center art:gap-3 art:rounded-full art:border art:border-border art:bg-background art:px-3 art:py-2.5 art:@min-[640px]/artemis:right-40\" animate={reduce ? undefined : { transform: [\"translateY(0px)\", \"translateY(-5px)\", \"translateY(0px)\"] }} transition={{ duration: 4.2, repeat: Infinity, ease: ARTEMIS_EASE_IN_OUT }}>\n            <span className=\"art:grid art:size-8 art:place-items-center art:rounded-full art:bg-muted art:text-foreground\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-audio-lines art:size-4\" aria-hidden=\"true\">\n                <path d=\"M2 10v3\"/>\n                <path d=\"M6 6v11\"/>\n                <path d=\"M10 3v18\"/>\n                <path d=\"M14 8v7\"/>\n                <path d=\"M18 5v13\"/>\n                <path d=\"M22 10v3\"/>\n              </svg>\n            </span>\n            <div>\n              <p className=\"art:font-medium art:text-foreground art:text-xs\">\n                {\"Live call\"}\n              </p>\n              <p className=\"art:text-muted-foreground art:text-xs\">\n                {\"00:18 \\u00B7 low latency\"}\n              </p>\n            </div>\n          </motion.div>\n        </div>\n      </div>\n    </Reveal>);\n}\nfunction TranscriptCard({ item, index, reduce }: CardProps) {\n    return (<Reveal index={index} reduce={reduce} className=\"art:relative art:overflow-hidden art:rounded-3xl art:border art:border-border art:p-6 art:@min-[640px]/artemis:p-8 art:min-h-[24rem] art:bg-muted/50 art:@min-[1024px]/artemis:col-span-6\">\n      <div className=\"art:flex art:h-full art:min-h-[20rem] art:flex-col\">\n        <div>\n          <h3 className=\"art:font-medium art:text-foreground art:text-xl\">\n            {item.title}\n          </h3>\n          <p className=\"art:mt-2 art:max-w-md art:text-muted-foreground art:text-sm art:leading-6\">\n            {item.description}\n          </p>\n        </div>\n        <div className=\"art:mt-8 art:flex-1 art:rounded-2xl art:border art:border-border art:bg-background art:p-4 art:@min-[640px]/artemis:p-5\">\n          <div className=\"art:flex art:items-center art:justify-between art:border-border art:border-b art:pb-3\">\n            <div className=\"art:flex art:items-center art:gap-2 art:text-foreground art:text-xs\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-message-square-text art:size-4\" aria-hidden=\"true\">\n                <path d=\"M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z\"/>\n                <path d=\"M7 11h10\"/>\n                <path d=\"M7 15h6\"/>\n                <path d=\"M7 7h8\"/>\n              </svg>\n              {\"Call transcript\"}\n            </div>\n            <span className=\"art:font-mono art:text-muted-foreground art:text-xs\">\n              {\"00:18\"}\n            </span>\n          </div>\n          <div className=\"art:divide-y art:divide-border\">\n            <motion.div className=\"art:grid art:grid-cols-[3.5rem_1fr_auto] art:gap-3 art:py-3 art:text-xs\" animate={reduce ? { opacity: 0.7 } : { opacity: [0.55, 1, 0.55] }} transition={reduce ? { duration: 0 } : { duration: 4, repeat: Infinity, ease: ARTEMIS_EASE_IN_OUT, delay: 0 }}>\n              <span className=\"art:text-muted-foreground\">\n                {\"Caller\"}\n              </span>\n              <span className=\"art:text-foreground art:leading-5\">\n                {\"Can I move tomorrow\\u2019s delivery to Friday morning?\"}\n              </span>\n              <span className=\"art:font-mono art:text-muted-foreground\">\n                {\"00:08\"}\n              </span>\n            </motion.div>\n            <motion.div className=\"art:grid art:grid-cols-[3.5rem_1fr_auto] art:gap-3 art:py-3 art:text-xs\" animate={reduce ? { opacity: 1 } : { opacity: [0.55, 1, 0.55] }} transition={reduce ? { duration: 0 } : { duration: 4, repeat: Infinity, ease: ARTEMIS_EASE_IN_OUT, delay: 1.5 }}>\n              <span className=\"art:text-muted-foreground\">\n                {\"Assistant\"}\n              </span>\n              <span className=\"art:text-foreground art:leading-5\">\n                {\"Friday morning is available. I can update it now.\"}\n              </span>\n              <span className=\"art:font-mono art:text-muted-foreground\">\n                {\"00:11\"}\n              </span>\n            </motion.div>\n          </div>\n          <div className=\"art:mt-3 art:flex art:items-center art:justify-between art:rounded-xl art:bg-background art:px-3 art:py-2.5 art:text-xs\">\n            <span className=\"art:text-foreground\">\n              {\"Delivery moved to Friday\"}\n            </span>\n            <span className=\"art:text-muted-foreground\">\n              {\"ready\"}\n            </span>\n          </div>\n        </div>\n      </div>\n    </Reveal>);\n}\nfunction ActionsCard({ item, index, reduce }: CardProps) {\n    return (<Reveal index={index} reduce={reduce} className=\"art:relative art:overflow-hidden art:rounded-3xl art:border art:border-border art:p-6 art:@min-[640px]/artemis:p-8 art:min-h-[24rem] art:bg-muted/70 art:@min-[1024px]/artemis:col-span-6\">\n      <div className=\"art:flex art:h-full art:min-h-[20rem] art:flex-col\">\n        <div>\n          <h3 className=\"art:font-medium art:text-foreground art:text-xl\">\n            {item.title}\n          </h3>\n          <p className=\"art:mt-2 art:max-w-md art:text-muted-foreground art:text-sm art:leading-6\">\n            {item.description}\n          </p>\n        </div>\n        <div className=\"art:relative art:mt-8 art:flex art:flex-1 art:items-center art:justify-center\">\n          <div className=\"art:absolute art:inset-x-[14%] art:top-1/2 art:h-px art:bg-border\"/>\n          <motion.div className=\"art:absolute art:z-10 art:flex art:flex-col art:items-center art:gap-2 art:top-0 art:left-[13%]\" animate={reduce ? undefined : { transform: [\"translateY(0px)\", \"translateY(-4px)\", \"translateY(0px)\"] }} transition={{ duration: 4.6, repeat: Infinity, ease: ARTEMIS_EASE_IN_OUT, delay: 0 }}>\n            <span className=\"art:grid art:size-11 art:place-items-center art:rounded-full art:border art:border-border art:bg-background art:text-foreground\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-calendar-days art:size-4\" aria-hidden=\"true\">\n                <path d=\"M8 2v3