tion={{ duration: 4.6, repeat: Infinity, ease: ARTEMIS_EASE_IN_OUT, delay: 0.8 }}>\n            <span className=\"art:grid art:size-11 art:place-items-center art:rounded-full art:border art:border-border art:bg-background art:text-foreground\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-headphones art:size-4\" aria-hidden=\"true\">\n                <path d=\"M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3\"/>\n              </svg>\n            </span>\n            <span className=\"art:text-muted-foreground art:text-xs\">\n              {\"Support\"}\n            </span>\n          </motion.div>\n          <div className=\"art:relative art:z-20 art:w-56 art:rounded-2xl art:bg-foreground art:p-5 art:text-background\">\n            <div className=\"art:flex art:items-center art:justify-between\">\n              <span className=\"art:grid art:size-9 art:place-items-center art:rounded-full art:bg-background/10\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-user-round art:size-4\" aria-hidden=\"true\">\n                  <circle cx=\"12\" cy=\"8\" r=\"5\"/>\n                  <path d=\"M20 21a8 8 0 0 0-16 0\"/>\n                </svg>\n              </span>\n              <span className=\"art:font-mono art:text-background/60 art:text-xs\">\n                {\"#1842\"}\n              </span>\n            </div>\n            <p className=\"art:mt-5 art:font-medium art:text-sm\">\n              {\"Call completed\"}\n            </p>\n            <p className=\"art:mt-1 art:text-background/65 art:text-xs art:leading-5\">\n              {\"Delivery updated and confirmation sent.\"}\n            </p>\n          </div>\n        </div>\n      </div>\n    </Reveal>);\n}\nconst CARDS = [AlwaysOnCard, ConversationCard, TranscriptCard, ActionsCard];\nexport default function FeatureSectionsVoiceAi({ content }: { content?: Partial<ArtemisFeatureContent> } = {}) {\n    const copy = { ...DEFAULT, ...content };\n    const accent = content?.headline === undefined ? copy.headlineAccent : content.headlineAccent;\n    const items: ArtemisFeatureItem[] = copy.items;\n    const reduce = useReducedMotion() ?? false;\n    return (<>\n      <div className=\"art:w-full\">\n        <section className=\"art:w-full art:bg-background art:px-4 art:py-20 art:@min-[640px]/artemis:px-8\">\n          <div className=\"art:mx-auto art:w-full art:max-w-6xl\">\n            <header className=\"art:mx-auto art:max-w-2xl art:text-center\">\n              {copy.badge ? (<p className=\"art:text-muted-foreground art:text-sm\">\n                {copy.badge}\n              </p>) : null}\n              <h2 className=\"art:mt-4 art:font-sans art:font-medium art:text-4xl art:text-foreground art:leading-none art:tracking-tight\">\n                <span className=\"art:block\">\n                  {copy.headline}\n                </span>\n                {accent ? (<>\n                {\" \"}\n                <span className=\"art:block\">\n                  {accent}\n                </span>\n                </>) : null}\n              </h2>\n              {copy.subhead ? (<p className=\"art:mx-auto art:mt-5 art:max-w-xl art:text-pretty art:text-muted-foreground art:text-sm art:leading-7\">\n                {copy.subhead}\n              </p>) : null}\n            </header>\n            <div className=\"art:mt-12 art:grid art:gap-4 art:@min-[1024px]/artemis:grid-cols-12\">\n              {items.map((item, i) => {\n            const Card = CARDS[i % CARDS.length];\n            return <Card key={i} item={item} index={i} reduce={reduce}/>;\n        })}\n            </div>\n          </div>\n        </section>\n      </div>\n    </>);\n}\n"
    }
