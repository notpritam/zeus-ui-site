  "files": [
    {
      "path": "application/artemis/artemis-cta-sections.tsx",
      "type": "registry:component",
      "target": "@components/application/artemis/artemis-cta-sections.tsx",
      "content": "\"use client\";\nimport {ArtemisScope} from \"./artemis-scope\";\nimport type { ArtemisCtaContent } from \"./components/cta-sections/content\";\nimport View3 from \"./components/cta-sections/variants/04-product-window\";\nconst views={\"product-window\":View3};\nexport type { ArtemisCtaContent, ArtemisCtaImage, ArtemisCtaLink, ArtemisCtaQuestion, ArtemisCtaStat } from \"./components/cta-sections/content\";\nexport interface ArtemisCtaSectionsProps{className?:string;variant?:\"product-window\"; /** The words on the CTA section; anything left out keeps the layout's own copy. */ content?: Partial<ArtemisCtaContent>; }\nexport function ArtemisCtaSections({className,variant=\"product-window\",content}:ArtemisCtaSectionsProps){const View=views[variant];return <ArtemisScope className={className}><View content={content}/></ArtemisScope>;}\n"
    },
    {
      "path": "application/artemis/components/cta-sections/content.ts",
      "type": "registry:component",
      "target": "@components/application/artemis/components/cta-sections/content.ts",
      "content": "// @zeus-internal\n\n/** The words on a button or link, and where it goes. */\nexport interface ArtemisCtaLink {\n  label: string;\n  href: string;\n}\n\n/** A picture, and the words that describe it. */\nexport interface ArtemisCtaImage {\n  src: string;\n  /** What the picture shows; empty for a purely decorative one. */\n  alt: string;\n}\n\n/** A figure with a short label under it. */\nexport interface ArtemisCtaStat {\n  /** The figure as text, such as \"120\" or \"4.9\". Its digits roll into place. */\n  value: string;\n  /** Shown right after the figure, such as \"K+\" or \"/5\". */\n  suffix?: string;\n  /** What the figure counts. */\n  label: string;\n}\n\n/** A question and its answer. */\nexport interface ArtemisCtaQuestion {\n  question: string;\n  answer: string;\n  /** A short id, unique in the list, used in the row's element ids. Defaults to the row's position. */\n  id?: string;\n}\n\n/** The words on an Artemis CTA section. Every layout reads this shape, so you can switch layouts and keep them. */\nexport interface ArtemisCtaContent {\n  /** The short line above the heading. sunflower, product-window, proof-orbit, shade-panel, glow and terminal. */\n  badge?: string;\n  /** The heading. All layouts. */\n  headline: string;\n  /** The heading's second part. glow shows it on a line of its own in a muted tone; faq, terminal and split start a new line for it; the other layouts run it on after `headline`. Left out, it keeps the layout's own only when `headline` is left out too. */\n  headlineAccent?: string;\n  /** The paragraph under the heading. All layouts. */\n  subhead: string;\n  /** The main button. All layouts. */\n  cta: ArtemisCtaLink;\n  /** A second button. floating-gallery, portrait-frame, glow, terminal and split. */\n  secondaryCta?: ArtemisCtaLink;\n  /** A quiet text link under the buttons. split. */\n  link?: ArtemisCtaLink;\n  /** A short line near the buttons. sunflower, portrait-frame, proof-orbit and glow. */\n  note?: string;\n  /** The picture beside the words. portrait-frame, which also blurs it behind the panel, and glow. */\n  image?: ArtemisCtaImage;\n  /** Photos floating at the sides. floating-gallery: up to six, in pairs from the top, left then right; under 768px wide only the first two show. */\n  images?: ArtemisCtaImage[];\n  /** Faces in a row above the words. proof-orbit: up to five, from the left; the third is the largest. */\n  avatars?: ArtemisCtaImage[];\n  /** What the row of faces shows, read by screen readers. proof-orbit. Left out, it keeps the layout's own only when `avatars` is left out too. */\n  avatarsLabel?: string;\n  /** Figures under the buttons. floating-gallery; four look best. */\n  stats?: ArtemisCtaStat[];\n  /** Short facts along the foot of the panel. glow. */\n  highlights?: string[];\n  /** An install command with a copy button. terminal types it out; split shows it on its button. */\n  command?: string;\n  /** The lines the terminal prints after `command`. terminal. Left out, it keeps the layout's own lines only when `command` is left out too. */\n  commandOutput?: string[];\n  /** Questions with answers that open one at a time; the first starts open. faq. */\n  questions?: ArtemisCtaQuestion[];\n}\n"
    },
    {
      "path": "application/artemis/components/cta-sections/variants/04-product-window.tsx",
      "type": "registry:component",
      "target": "@components/application/artemis/components/cta-sections/variants/04-product-window.tsx",
      "content": "\"use client\";\n// @zeus-internal\nimport { StaticMeshGradient } from \"@paper-design/shaders-react\";\nimport { motion, useReducedMotion } from \"motion/react\";\nimport { ARTEMIS_SPRING_PRESS } from \"../../../lib/ease\";\nimport type { ArtemisCtaContent } from \"../content\";\nconst DEFAULT = {\n    badge: \"AI support, ready on day one\",\n    headline: \"Give your team their focus back.\",\n    subhead: \"Connect your customer workspace and let AI prepare every handoff, follow-up, and next step\\u2014without rebuilding your workflow.\",\n    cta: { label: \"Start building free\", href: \"#\" },\n} satisfies ArtemisCtaContent;\nconst SHADER_COLORS = [\"#f4dfbd\", \"#e69a78\", \"#91c8b8\", \"#315f63\"];\nexport default function CtaSectionsProductWindow({ content }: { content?: Partial<ArtemisCtaContent> } = {}) {\n    const copy = { ...DEFAULT, ...content };\n    const reduce = useReducedMotion();\n    return (<>\n      <div className=\"art:w-full\">\n        <section className=\"art:w-full art:px-4 art:py-16 art:@min-[640px]/artemis:px-8\">\n          <div className=\"art:mx-auto art:grid art:w-full art:max-w-6xl art:rounded-3xl art:border art:border-border art:bg-background art:p-2 art:@min-[1024px]/artemis:grid-cols-[0.9fr_1.1fr]\">\n            <div className=\"art:flex art:min-h-[28rem] art:items-center art:px-7 art:py-14 art:@min-[640px]/artemis:px-12 art:@min-[1024px]/artemis:min-h-[34rem] art:@min-[1024px]/artemis:px-14\">\n              <div className=\"art:max-w-lg art:font-sans\">\n                <p className=\"art:font-medium art:text-muted-foreground art:text-xs art:uppercase art:tracking-widest\">\n                  {copy.badge}\n                </p>\n                <h2 className=\"art:mt-6 art:text-balance art:text-4xl art:font-medium art:leading-tight art:tracking-tight art:text-foreground\">\n                  {copy.headlineAccent ? `${copy.headline} ${copy.headlineAccent}` : copy.headline}\n                </h2>\n                <p className=\"art:mt-5 art:max-w-md art:text-pretty art:text-base art:leading-7 art:text-muted-foreground\">\n                  {copy.subhead}\n                </p>\n                <motion.a whileHover={reduce ? undefined : { scale: 1.01 }} whileTap={reduce ? undefined : { scale: 0.99 }} transition={ARTEMIS_SPRING_PRESS} className=\"art:inline-flex art:items-center art:justify-center art:font-medium art:select-none art:transition-colors art:disabled:pointer-events-none art:disabled:opacity-50 art:bg-primary art:text-primary-foreground art:hover:bg-primary/90 art:gap-2 art:px-6 art:text-base art:mt-8 art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-ring art:focus-visible:ring-offset-2 art:focus-visible:ring-offset-background art:h-9 art:rounded-full\" href={copy.cta.href} tabIndex={0}>\n                  {copy.cta.label}\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-arrow-up-right art:size-4\" aria-hidden=\"true\">\n                    <path d=\"M7 7h10v10\"/>\n                    <path d=\"M7 17 17 7\"/>\n                  </svg>\n                </motion.a>\n              </div>\n            </div>\n            <div className=\"art:relative art:isolate art:min-h-[31rem] art:overflow-hidden art:rounded-2xl art:contain-paint art:@min-[1024px]/artemis:min-h-[34rem]\">\n              <div aria-hidden=\"true\" className=\"art:absolute art:inset-0 art:bg-[linear-gradient(135deg,rgba(244,221,181,0.92),rgba(82,145,141,0.92))]\">\n                <StaticMeshGradient className=\"art:h-full art:w-full\" colors={SHADER_COLORS} positions={18} waveX={0.72} waveXShift={0.18} waveY={0.88} waveYShift={0.62} mixing={0.68} grainMixer={0.08} grainOverlay={0.06} rotation={0} speed={0} frame={0} fit=\"contain\"/>\n              </div>\n              <div aria-hidden=\"true\" className=\"art:absolute art:inset-0 art:opacity-25 art:[background-image:radial-gradient(circle_at_center,rgba(255,255,255,0.75)_0.75px,transparent_0.75px)] art:[background-size:8px_8px]\"/>\n              <div aria-hidden=\"true\" className=\"art:absolute art:-right-4 art:-bottom-4 art:left-2 art:h-[28rem] art:rounded-tl-3xl art:border art:border-border/50 art:bg-background/30 art:backdrop-blur-lg art:@min-[640px]/artemis:left-5 art:@min-[1024px]/artemis:left-8\"/>\n              <div aria-hidden=\"true\" className=\"art:absolute art:-right-6 art:-bottom-6 art:left-4 art:overflow-hidden art:rounded-tl-2xl art:border art:border-border/70 art:bg-background art:@min-[640px]/artemis:left-7 art:@min-[1024px]/artemis:left-10\">\n                <div className=\"art:flex art:h-12 art:items-center art:justify-between art:border-border/70 art:border-b art:px-4\">\n                  <div className=\"art:flex art:items-center art:gap-2.5\">\n                    <span className=\"art:grid art:size-7 art:place-items-center art:rounded-full art:bg-primary art:text-primary-foreground\">\n                      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-bot art:size-3.5\" aria-hidden=\"true\">\n                        <path d=\"M12 8V4H8\"/>\n                        <rect width=\"16\" height=\"12\" x=\"4\" y=\"8\" rx=\"2\"/>\n                        <path d=\"M2 14h2\"/>\n                        <path d=\"M20 14h2\"/>\n                        <path d=\"M15 13v2\"/>\n                        <path d=\"M9 13v2\"/>\n                      </svg>\n                    </span>\n                    <span className=\"art:font-medium art:text-sm\">\n                      {\"Group A\"}\n                    </span>\n                  </div>\n                  <div className=\"art:flex art:items-center art:gap-2 art:text-muted-foreground art:text-xs\">\n                    <span className=\"art:size-1.5 art:rounded-full art:bg-foreground\"/>\n                    {\"All systems ready\"}\n                  </div>\n                </div>\n                <div className=\"art:grid art:min-h-[25rem] art:@min-[640px]/artemis:grid-cols-[8.5rem_1fr]\">\n                  <aside className=\"art:hidden art:border-border/70 art:border-r art:bg-background/70 art:p-3 art:@min-[640px]/artemis:flex art:@min-[640px]/artemis:flex-col\">\n                    <nav aria-label=\"Product preview\" className=\"art:space-y-1 art:text-xs\">\n                      <span className=\"art:flex art:items-center art:gap-2 art:rounded-lg art:bg-muted art:px-3 art:py-2.5 art:font-medium art:text-foreground\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-inbox art:size-3.5\" aria-hidden=\"true\">\n                          <polyline points=\"22 12 16 12 14 15 10 15 8 12 2 12\"/>\n                          <path d=\"M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\"/>\n                        </svg>\n                        {\" Inbox\"}\n                      </span>\n                      <span className=\"art:flex art:items-center art:gap-2 art:rounded-lg art:px-3 art:py-2.5 art:text-muted-foreground\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-workflow art:size-3.5\" aria-hidden=\"true\">\n                          <rect width=\"8\" height=\"8\" x=\"3\" y=\"3\" rx=\"2\"/>\n                          <path d=\"M7 11v4a2 2 0 0 0 2 2h4\"/>\n                          <rect width=\"8\" height=\"8\" x=\"13\" y=\"13\" rx=\"2\"/>\n                        </svg>\n                        {\" Automations\"}\n                      </span>\n                      <span className=\"art:flex art:items-center art:gap-2 art:rounded-lg art:px-3 art:py-2.5 art:text-muted-foreground\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-layout-grid art:size-3.5\" aria-hidden=\"true\">\n                          <rect width=\"7\" height=\"7\" x=\"3\" y=\"3\" rx=\"1\"/>\n                          <rect width=\"7\" height=\"7\" x=\"14\" y=\"3\" rx=\"1\"/>\n                          <rect width=\"7\" height=\"7\" x=\"14\" y=\"14\" rx=\"1\"/>\n                          <rect width=\"7\" height=\"7\" x=\"3\" y=\"14\" rx=\"1\"/>\n                        </svg>\n                        {\" Workspaces\"}\n                      </span>\n                    </nav>\n                    <div className=\"art:mt-auto art:rounded-xl art:border art:border-border/70 art:bg-background/70 art:p-3\">\n                      <div className=\"art:flex art:items-center art:gap-2 art:text-xs\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-activity art:size-3.5\" aria-hidden=\"true\">\n                          <path d=\"M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2\"/>\n                        </svg>\n                        {\" 82% automated\"}\n                      </div>\n                      <div className=\"art:mt-3 art:h-1.5 art:overflow-hidden art:rounded-full art:bg-muted\">\n                        <div className=\"art:h-full art:w-4/5 art:rounded-full art:bg-primary\"/>\n                      </div>\n                    </div>\n                  </aside>\n                  <div className=\"art:min-w-0\">\n                    <div className=\"art:flex art:h-14 art:items-center art:justify-between art:gap-3 art:border-border/70 art:border-b art:px-4\">\n                      <div>\n                        <p className=\"art:font-medium art:text-sm\">\n                          {\"Priority queue\"}\n                        </p>\n                        <p className=\"art:text-muted-foreground art:text-xs\">\n                          {\"Updated just now\"}\n                        </p>\n                      </div>\n                      <span className=\"art:grid art:size-9 art:place-items-center art:rounded-full art:border art:border-border art:bg-background art:text-muted-foreground\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-search art:size-4\" aria-hidden=\"true\">\n                          <path d=\"m21 21-4.34-4.34\"/>\n                          <circle cx=\"11\" cy=\"11\" r=\"8\"/>\n                        </svg>\n                      </span>\n                    </div>\n                    <div className=\"art:grid art:@min-[768px]/artemis:grid-cols-[minmax(0,1fr)_13rem]\">\n                      <div className=\"art:space-y-2 art:p-3\">\n                        <div className=\"art:rounded-xl art:p-3 art:bg-muted art:text-foreground\">\n                          <div className=\"art:flex art:items-start art:justify-between art:gap-4\">\n                            <div className=\"art:min-w-0\">\n                              <p className=\"art:truncate art:font-medium art:text-sm\">\n                                {\"Enterprise onboarding\"}\n                              </p>\n                              <p className=\"art:mt-1 art:truncate art:text-muted-foreground art:text-xs\">\n                                {\"AI drafted the rollout plan\"}\n                              </p>\n                            </div>\n                            <span className=\"art:shrink-0 art:text-muted-foreground art:text-xs\">\n                              {\"Now\"}\n                            </span>\n                          </div>\n                        </div>\n                        <div className=\"art:rounded-xl art:p-3 art:border art:border-border/70 art:bg-background/70\">\n                          <div className=\"art:flex art:items-start art:justify-between art:gap-4\">\n                            <div className=\"art:min-w-0\">\n                              <p className=\"art:truncate art:font-medium art:text-sm\">\n                                {\"Usage alert review\"}\n                              </p>\n                              <p className=\"art:mt-1 art:truncate art:text-muted-foreground art:text-xs\">\n                                {\"Three accounts need attention\"}\n                              </p>\n                            </div>\n                            <span className=\"art:shrink-0 art:text-muted-foreground art:text-xs\">\n                              {\"4m\"}\n                            </span>\n                          </div>\n                        </div>\n                        <div className=\"art:rounded-xl art:p-3 art:border art:border-border/70 art:bg-background/70\">\n                          <div className=\"art:flex art:items-start art:justify-between art:gap-4\">\n                            <div className=\"art:min-w-0\">\n                              <p className=\"art:truncate art:font-medium art:text-sm\">\n                                {\"Renewal preparation\"}\n                              </p>\n                              <p className=\"art:mt-1 art:truncate art:text-muted-foreground art:text-xs\">\n                                {\"Brief ready for the account team\"}\n                              </p>\n                            </div>\n                            <span className=\"art:shrink-0 art:text-muted-foreground art:text-xs\">\n                              {\"12m\"}\n                            </span>\n                          </div>\n                        </div>\n                      </div>\n                      <div className=\"art:hidden art:border-border/70 art:border-l art:p-3 art:@min-[768px]/artemis:block\">\n                        <div className=\"art:rounded-xl art:border art:border-border/70 art:bg-background/70 art:p-3\">\n                          <div className=\"art:flex art:items-center art:justify-between art:gap-2\">\n                            <span className=\"art:grid art:size-8 art:place-items-center art:rounded-full art:bg-muted art:text-foreground\">\n                              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-message-square-text art:size-4\" aria-hidden=\"true\">\n                                <path d=\"M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z\"/>\n                                <path d=\"M7 11h10\"/>\n                                <path d=\"M7 15h6\"/>\n                                <path d=\"M7 7h8\"/>\n                              </svg>\n                            </span>\n                            <span className=\"art:rounded-full art:border art:border-border art:px-2 art:py-1 art:text-muted-foreground art:text-xs\">\n                              {\"Live\"}\n                            </span>\n                          </div>\n                          <p className=\"art:mt-6 art:font-medium art:text-sm\">\n                            {\"AI handoff ready\"}\n                          </p>\n                          <p className=\"art:mt-2 art:text-pretty art:text-muted-foreground art:text-xs art:leading-5\">\n                            {\"Group A prepared the context, next steps, and owner notes.\"}\n                          </p>\n                          <div className=\"art:mt-5 art:space-y-2 art:border-border/70 art:border-t art:pt-3 art:text-xs\">\n                            <p className=\"art:flex art:items-center art:gap-2\">\n                              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-circle-check art:size-3.5\" aria-hidden=\"true\">\n                                <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                                <path d=\"m9 12 2 2 4-4\"/>\n                              </svg>\n                              {\" Context added\"}\n                            </p>\n                            <p className=\"art:flex art:items-center art:gap-2 art:text-muted-foreground\">\n                              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-clock3 art:lucide-clock-3 art:size-3.5\" aria-hidden=\"true\">\n                                <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                                <path d=\"M12 6v6h4\"/>\n                              </svg>\n                              {\" Saved 18 minutes\"}\n                            </p>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </section>\n      </div>\n    </>);\n}\n"
    }
