      "content": "\"use client\";\nimport { ArtemisScope } from \"./artemis-scope\";\nimport View0 from \"./components/blog-pages/variants/03-article\";\nexport interface ArtemisBlogArticleProps { className?: string;  }\nexport function ArtemisBlogArticle({ className }: ArtemisBlogArticleProps) {return <ArtemisScope className={className}><div className=\"art:flex art:w-full art:min-w-0 art:flex-col art:items-center\"><View0/></div></ArtemisScope>;}\n"
    },
    {
      "path": "application/artemis/components/blog-pages/variants/03-article.tsx",
      "type": "registry:component",
      "target": "@components/application/artemis/components/blog-pages/variants/03-article.tsx",
      "content": "\"use client\";\n// @zeus-internal\nimport { motion, useReducedMotion } from \"motion/react\";\nimport { ArtemisButtonLink } from \"../../../foundations/button\";\nimport { ARTEMIS_EASE_OUT } from \"../../../lib/ease\";\nexport default function BlogPagesArticle() {\n    const reduce = useReducedMotion();\n    const reveal = { initial: { opacity: 0, y: 14 }, whileInView: { opacity: 1, y: 0 }, viewport: { once: true, margin: \"-70px\" }, transition: { duration: reduce ? 0 : 0.45, ease: ARTEMIS_EASE_OUT } };\n    return (<>\n      <div className=\"art:min-h-screen art:w-full art:bg-background art:font-sans art:text-foreground\">\n        <header className=\"art:border-border art:border-b\">\n          <div className=\"art:mx-auto art:flex art:min-h-16 art:w-full art:max-w-6xl art:items-center art:justify-between art:px-4 art:@min-[640px]/artemis:px-8\">\n            <a href=\"#article-top\" className=\"art:font-semibold art:text-base art:tracking-[-0.025em] art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-foreground art:focus-visible:ring-offset-4 art:focus-visible:ring-offset-background\">\n              {\"Journal\"}\n            </a>\n            <ArtemisButtonLink variant=\"tertiary\" size=\"sm\" href=\"#article-newsletter\">\n              {\"Subscribe\"}\n            </ArtemisButtonLink>\n          </div>\n        </header>\n        <main id=\"article-top\">\n          <article>\n            <header className=\"art:mx-auto art:w-full art:max-w-5xl art:px-4 art:pt-12 art:pb-10 art:@min-[640px]/artemis:px-8 art:@min-[640px]/artemis:pt-20 art:@min-[640px]/artemis:pb-14\">\n              <motion.a href=\"#article-top\" className=\"art:inline-flex art:min-h-10 art:items-center art:gap-2 art:text-muted-foreground art:text-sm art:transition-colors art:hover:text-foreground art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-foreground\" initial={{ opacity: 0 }} whileInView={{ opacity: 1 }} viewport={{ once: true }} transition={{ duration: reduce ? 0 : 0.35, ease: ARTEMIS_EASE_OUT }}>\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-arrow-left art:size-4\" aria-hidden=\"true\">\n                  <path d=\"m12 19-7-7 7-7\"/>\n                  <path d=\"M19 12H5\"/>\n                </svg>\n                {\"All stories\"}\n              </motion.a>\n              <motion.div className=\"art:mt-10\" {...reveal} initial={{ opacity: 0, y: 16 }} transition={{ duration: reduce ? 0 : 0.5, ease: ARTEMIS_EASE_OUT }}>\n                <p className=\"art:font-medium art:text-muted-foreground art:text-xs art:uppercase art:tracking-[0.14em]\">\n                  {\"Places\"}\n                  {\" / \"}\n                  {\"7 min read\"}\n                </p>\n                <h1 className=\"art:mt-5 art:max-w-4xl art:text-balance art:tracking-[-0.035em] art:text-4xl art:@min-[768px]/artemis:text-5xl art:font-medium\">\n                  {\"A week without an itinerary\"}\n                </h1>\n                <p className=\"art:mt-6 art:max-w-2xl art:text-pretty art:text-sm art:text-muted-foreground art:leading-7 art:@min-[640px]/artemis:text-base\">\n                  {\"What changed when we stopped collecting recommendations and started following the shape of each day.\"}\n                </p>\n                <div className=\"art:mt-8 art:flex art:items-center art:gap-3 art:text-sm\">\n                  <span className=\"art:grid art:size-10 art:place-items-center art:rounded-full art:bg-muted art:font-semibold\">\n                    {\"CE\"}\n                  </span>\n                  <div>\n                    <p className=\"art:font-medium\">\n                      {\"Casey Ellis\"}\n                    </p>\n                    <p className=\"art:text-muted-foreground\">\n                      {\"Writer and wanderer\"}\n                    </p>\n                  </div>\n                </div>\n              </motion.div>\n            </header>\n            <motion.div className=\"art:mx-auto art:w-full art:max-w-6xl art:px-4 art:@min-[640px]/artemis:px-8\" {...reveal}>\n              <img src=\"/assets/artemis/16585090b4f1acf6efb9.avif\" alt=\"A quiet cafe interior lit by tall windows\" width=\"1800\" height=\"1125\" className=\"art:aspect-[16/10] art:max-h-[44rem] art:w-full art:rounded-2xl art:object-cover art:outline-1 art:-outline-offset-1 art:outline-black/10 art:outline art:dark:outline-white/10\"/>\n            </motion.div>\n            <div className=\"art:mx-auto art:grid art:w-full art:min-w-0 art:grid-cols-1 art:max-w-5xl art:gap-12 art:px-4 art:py-14 art:@min-[640px]/artemis:px-8 art:@min-[640px]/artemis:py-20 art:@min-[1024px]/artemis:grid-cols-[11rem_minmax(0,42rem)] art:@min-[1024px]/artemis:justify-between\">\n              <aside className=\"art:hidden art:@min-[1024px]/artemis:block\">\n                <div className=\"art:sticky art:top-8 art:rounded-2xl art:border art:border-border art:p-5\">\n                  <p className=\"art:font-medium art:text-xs art:uppercase art:tracking-[0.13em]\">\n                    {\"In this story\"}\n                  </p>\n                  <nav className=\"art:mt-4 art:flex art:flex-col art:gap-3 art:text-muted-foreground art:text-sm\">\n                    <a href=\"#arrival\" className=\"art:transition-colors art:hover:text-foreground\">\n                      {\"Arrival\"}\n                    </a>\n                    <a href=\"#unplanned\" className=\"art:transition-colors art:hover:text-foreground\">\n                      {\"Leaving space\"}\n                    </a>\n                    <a href=\"#home\" className=\"art:transition-colors art:hover:text-foreground\">\n                      {\"What came home\"}\n                    </a>\n                  </nav>\n                </div>\n              </aside>\n              <div className=\"art:min-w-0 art:text-base art:leading-8 art:@min-[640px]/artemis:text-lg\">\n                <motion.section id=\"arrival\" {...reveal}>\n                  <p className=\"art:text-muted-foreground art:text-sm\">\n                    {\"01 / Arrival\"}\n                  </p>\n                  <h2 className=\"art:mt-3 art:font-medium art:text-4xl art:tracking-[-0.04em]\">\n                    {\"We arrived with one reservation\"}\n                  </h2>\n                  <p className=\"art:mt-6\">\n                    {\"The room was above a bakery and across from a square that became louder at dinner, then completely still by midnight. We had booked the first night and written down the address of a market. That was the entire plan.\"}\n                  </p>\n                  <p className=\"art:mt-6\">\n                    {\"At first, the empty days felt irresponsible. By the second morning, they felt generous. Breakfast could last until the cups were cold. A street could be followed because the light looked good at the end of it.\"}\n                  </p>\n                </motion.section>\n                <motion.blockquote className=\"art:my-12 art:rounded-2xl art:border art:border-border art:p-8 art:text-balance art:font-medium art:text-2xl art:leading-9 art:tracking-[-0.025em] art:@min-[640px]/artemis:text-3xl art:@min-[640px]/artemis:leading-10\" {...reveal} transition={reduce ? { duration: 0, opacity: { duration: 0, delay: 0.05 } } : { duration: 0.45, delay: 0.05, ease: ARTEMIS_EASE_OUT }}>\n                  {\"\\u201CThe day became less about finding the best thing and more about noticing the thing already in front of us.\\u201D\"}\n                </motion.blockquote>\n                <motion.section id=\"unplanned\" {...reveal}>\n                  <p className=\"art:text-muted-foreground art:text-sm\">\n                    {\"02 / Leaving space\"}\n                  </p>\n                  <h2 className=\"art:mt-3 art:font-medium art:text-4xl art:tracking-[-0.04em]\">\n                    {\"A good day can remain unfinished\"}\n                  </h2>\n                  <p className=\"art:mt-6\">\n                    {\"We returned to the same lunch counter three times. The owner stopped offering us the menu and brought whatever had just come out of the kitchen. We learned the route home by the sound of chairs being stacked in the square.\"}\n                  </p>\n                  <p className=\"art:mt-6\">\n                    {\"None of it would have made a useful checklist. Together, it gave the week a shape: repeated places, familiar faces, and enough room for each day to change its mind.\"}\n                  </p>\n                </motion.section>\n                <motion.section id=\"home\" className=\"art:mt-12\" {...reveal}>\n                  <p className=\"art:text-muted-foreground art:text-sm\">\n                    {\"03 / What came home\"}\n                  </p>\n                  <h2 className=\"art:mt-3 art:font-medium art:text-4xl art:tracking-[-0.04em]\">\n                    {\"Fewer recommendations, better memories\"}\n                  </h2>\n                  <p className=\"art:mt-6\">\n                    {\"We brought back a paper bag from the bakery, a receipt from the lunch counter, and the name of a song someone played from an upstairs window. Small evidence of a week we had not tried to optimize.\"}\n                  </p>\n                </motion.section>\n              </div>\n            </div>\n          </article>\n          <section>\n            <div className=\"art:mx-auto art:w-full art:max-w-6xl art:px-4 art:py-14 art:@min-[640px]/artemis:px-8 art:@min-[640px]/artemis:py-20\">\n              <div className=\"art:flex art:items-end art:justify-between art:gap-6\">\n                <div>\n                  <p className=\"art:text-muted-foreground art:text-sm\">\n                    {\"Keep reading\"}\n                  </p>\n                  <h2 className=\"art:mt-1 art:font-medium art:text-4xl art:tracking-[-0.035em]\">\n                    {\"More from the journal\"}\n                  </h2>\n                </div>\n                <a href=\"#article-top\" className=\"art:hidden art:min-h-10 art:items-center art:gap-2 art:font-medium art:text-sm art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-foreground art:@min-[640px]/artemis:inline-flex\">\n                  {\"All stories\"}\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-arrow-right art:size-4\" aria-hidden=\"true\">\n                    <path d=\"M5 12h14\"/>\n                    <path d=\"m12 5 7 7-7 7\"/>\n                  </svg>\n                </a>\n              </div>\n              <div className=\"art:mt-8 art:grid art:gap-8 art:@min-[640px]/artemis:grid-cols-2\">\n                <a href=\"#article-top\" className=\"art:group art:grid art:gap-5 art:rounded-2xl art:border art:border-border art:bg-background art:p-2 art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-foreground art:@min-[640px]/artemis:grid-cols-[9rem_1fr]\">\n                  <div className=\"art:aspect-square art:overflow-hidden art:rounded-lg\">\n                    <img src=\"/assets/artemis/ef091272f545f02933c6.avif\" alt=\"A warm oak kitchen prepared for afternoon service\" width=\"600\" height=\"600\" loading=\"lazy\" className=\"art:h-full art:w-full art:object-cover\"/>\n                  </div>\n                  <div className=\"art:p-3 art:@min-[640px]/artemis:pl-0\">\n                    <p className=\"art:text-muted-foreground art:text-xs art:uppercase art:tracking-[0.13em]\">\n                      {\"Food\"}\n                      {\" / \"}\n                      {\"5 min read\"}\n                    </p>\n                    <h3 className=\"art:mt-3 art:text-balance art:font-medium art:text-xl art:leading-tight art:tracking-[-0.03em]\">\n                      {\"The kitchen at four in the afternoon\"}\n                    </h3>\n                    <p className=\"art:mt-4 art:flex art:items-center art:gap-2 art:font-medium art:text-sm\">\n                      {\"Read next\"}\n                      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-arrow-right art:size-4 art:transition-transform art:group-hover:translate-x-1\" aria-hidden=\"true\">\n                        <path d=\"M5 12h14\"/>\n                        <path d=\"m12 5 7 7-7 7\"/>\n                      </svg>\n                    </p>\n                  </div>\n                </a>\n                <a href=\"#article-top\" className=\"art:group art:grid art:gap-5 art:rounded-2xl art:border art:border-border art:bg-background art:p-2 art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-foreground art:@min-[640px]/artemis:grid-cols-[9rem_1fr]\">\n                  <div className=\"art:aspect-square art:overflow-hidden art:rounded-lg\">\n                    <img src=\"/assets/artemis/37d6ad7de3fdb7597cd1.avif\" alt=\"A warmly lit independent bookstore\" width=\"600\" height=\"600\" loading=\"lazy\" className=\"art:h-full art:w-full art:object-cover\"/>\n                  </div>\n                  <div className=\"art:p-3 art:@min-[640px]/artemis:pl-0\">\n                    <p className=\"art:text-muted-foreground art:text-xs art:uppercase art:tracking-[0.13em]\">\n                      {\"People\"}\n                      {\" / \"}\n                      {\"6 min read\"}\n                    </p>\n                    <h3 className=\"art:mt-3 art:text-balance art:font-medium art:text-xl art:leading-tight art:tracking-[-0.03em]\">\n                      {\"Keeping a small shop\"}\n                    </h3>\n                    <p className=\"art:mt-4 art:flex art:items-center art:gap-2 art:font-medium art:text-sm\">\n                      {\"Read next\"}\n                      <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-arrow-right art:size-4 art:transition-transform art:group-hover:translate-x-1\" aria-hidden=\"true\">\n                        <path d=\"M5 12h14\"/>\n                        <path d=\"m12 5 7 7-7 7\"/>\n                      </svg>\n                    </p>\n                  </div>\n                </a>\n              </div>\n            </div>\n          </section>\n          <section id=\"article-newsletter\" className=\"art:px-4 art:pb-16 art:@min-[640px]/artemis:px-8 art:@min-[640px]/artemis:pb-20\">\n            <div className=\"art:mx-auto art:flex art:w-full art:max-w-6xl art:flex-col art:items-start art:justify-between art:gap-7 art:rounded-2xl art:border art:border-border art:bg-background art:p-6 art:@min-[640px]/artemis:p-9 art:@min-[768px]/artemis:flex-row art:@min-[768px]/artemis:items-center\">\n              <div>\n                <p className=\"art:text-muted-foreground art:text-sm\">\n                  {\"The Sunday letter\"}\n                </p>\n                <h2 className=\"art:mt-2 art:font-medium art:text-4xl art:tracking-[-0.035em]\">\n                  {\"New stories, no busy inbox.\"}\n                </h2>\n              </div>\n              <ArtemisButtonLink size=\"lg\" href=\"#article-top\">\n                {\"Subscribe\"}\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-mail art:size-4\" aria-hidden=\"true\">\n                  <path d=\"m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7\"/>\n                  <rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"/>\n                </svg>\n              </ArtemisButtonLink>\n            </div>\n          </section>\n        </main>\n      </div>\n    </>);\n}\n"
    }
