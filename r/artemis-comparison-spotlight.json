{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "artemis-comparison-spotlight",
  "type": "registry:block",
  "title": "Comparison spotlight",
  "variants": [
    {
      "name": "spotlight",
      "title": "Spotlight comparison"
    }
  ],
  "description": "A clean multi-product table with a continuous rounded frame around the featured product.",
  "dependencies": [
    "motion@^12.42.2"
  ],
  "registryDependencies": [
    "https://myzeusui.com/r/artemis-controls.json",
    "https://myzeusui.com/r/artemis-tokens.json"
  ],
  "files": [
    {
      "path": "application/artemis/artemis-comparison-spotlight.tsx",
      "type": "registry:component",
      "target": "@components/application/artemis/artemis-comparison-spotlight.tsx",
      "content": "\"use client\";\nimport { ArtemisScope } from \"./artemis-scope\";\nimport View0 from \"./components/comparison/variants/07-spotlight\";\nexport interface ArtemisComparisonSpotlightProps { className?: string;  }\nexport function ArtemisComparisonSpotlight({ className }: ArtemisComparisonSpotlightProps) {return <ArtemisScope className={className}><div className=\"art:flex art:w-full art:min-w-0 art:flex-col art:items-center\"><View0/></div></ArtemisScope>;}\n"
    },
    {
      "path": "application/artemis/components/comparison/variants/07-spotlight.tsx",
      "type": "registry:component",
      "target": "@components/application/artemis/components/comparison/variants/07-spotlight.tsx",
      "content": "\"use client\";\n// @zeus-internal\nimport { useId as useArtemisInstanceId } from \"react\";\nimport { motion, useReducedMotion, type Transition } from \"motion/react\";\nimport { ARTEMIS_EASE_OUT } from \"../../../lib/ease\";\nconst INSTANT: Transition = { duration: 0 };\nconst BLOCK_TRANSITION: Transition = { duration: 0.4, ease: ARTEMIS_EASE_OUT };\nconst CELL_DURATION = 0.25;\nconst CELL_STAGGER = 0.035;\ntype Product = \"workspace\" | \"layer\" | \"canvas\" | \"orbit\";\nconst PRODUCTS: readonly Product[] = [\"workspace\", \"layer\", \"canvas\", \"orbit\"];\ntype Feature = {\n    name: string;\n} & Record<Product, boolean>;\nconst FEATURES: readonly Feature[] = [\n    { name: \"Quick workspace setup\", workspace: true, layer: true, canvas: true, orbit: false },\n    { name: \"Unlimited projects\", workspace: true, layer: false, canvas: false, orbit: true },\n    { name: \"Guest collaboration\", workspace: true, layer: true, canvas: false, orbit: false },\n    { name: \"Files alongside your work\", workspace: true, layer: true, canvas: true, orbit: false },\n    { name: \"Search across projects\", workspace: true, layer: false, canvas: true, orbit: true },\n    { name: \"Complete version history\", workspace: true, layer: false, canvas: false, orbit: true },\n    { name: \"Export your data\", workspace: true, layer: true, canvas: true, orbit: true },\n];\nconst FEATURED: Product = \"workspace\";\nfunction Mark({ included, featured }: {\n    included: boolean;\n    featured: boolean;\n}) {\n    return (<span className={`art:inline-flex art:size-7 art:items-center art:justify-center art:rounded-full art:text-foreground ${featured ? \"art:bg-accent/25\" : \"art:bg-muted\"}`}>\n      {included ? (<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-check art:size-3.5\" aria-hidden=\"true\">\n          <path d=\"M20 6 9 17l-5-5\"/>\n        </svg>) : (<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-minus art:size-3.5 art:text-muted-foreground\" aria-hidden=\"true\">\n          <path d=\"M5 12h14\"/>\n        </svg>)}\n      <span className=\"art:sr-only\">\n        {included ? \"Included\" : \"Not included\"}\n      </span>\n    </span>);\n}\nexport default function ComparisonSpotlight() {\nconst artemisInstanceId = useArtemisInstanceId();\n\n\n    const reduce = useReducedMotion();\n    return (<>\n      <section className=\"art:w-full art:bg-background art:px-4 art:py-20 art:text-foreground art:@min-[640px]/artemis:px-8 art:@min-[640px]/artemis:py-24\">\n        <div className=\"art:mx-auto art:max-w-6xl\">\n          <div className=\"art:mx-auto art:max-w-2xl art:text-center\">\n            <p className=\"art:text-sm art:font-medium art:text-muted-foreground\">\n              {\"Compare the possibilities\"}\n            </p>\n            <h2 id={`${artemisInstanceId}-R_9bsnpfdb_`} className=\"art:mt-4 art:text-balance art:text-4xl art:font-medium art:tracking-tight\">\n              {\"Built for the way your team works.\"}\n            </h2>\n            <p className=\"art:mx-auto art:mt-5 art:max-w-xl art:text-pretty art:text-sm art:leading-6 art:text-muted-foreground art:@min-[640px]/artemis:text-base\">\n              {\"All the essentials, together. See how Workspace compares with other ways to organize your work.\"}\n            </p>\n          </div>\n          <motion.div className=\"art:mt-12 art:bg-background\" initial={{ opacity: 0, y: 12 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true, amount: 0.1 }} transition={reduce ? INSTANT : BLOCK_TRANSITION}>\n            <section className=\"art:overflow-x-auto art:rounded-2xl art:focus-visible:outline-none art:focus-visible:ring-2 art:focus-visible:ring-ring\" aria-labelledby={`${artemisInstanceId}-R_9bsnpfdb_`} tabIndex={0}>\n              <table className=\"art:w-full art:table-fixed art:border-separate art:border-spacing-0\" style={{ minWidth: \"768px\" }}>\n                <caption className=\"art:sr-only\">\n                  {\"Product capabilities with\"}\n                  {\" \"}\n                  {\"Workspace\"}\n                  {\" \"}\n                  {\"featured\"}\n                </caption>\n                <colgroup>\n                  <col style={{ width: \"192px\" }}/>\n                  <col />\n                  <col />\n                  <col />\n                  <col />\n                </colgroup>\n                <thead>\n                  <tr>\n                    <th scope=\"col\" className=\"art:sticky art:left-0 art:z-10 art:bg-background art:px-4 art:pb-6 art:pt-8 art:text-left art:align-bottom art:text-sm art:font-medium art:text-muted-foreground\">\n                      {\"Features\"}\n                    </th>\n                    <th scope=\"col\" className=\"art:px-4 art:pb-6 art:pt-4 art:text-center art:align-top art:rounded-t-2xl art:bg-accent/10\">\n                      <div className=\"art:mb-4 art:flex art:h-6 art:items-center art:justify-center\">\n                        <span className=\"art:rounded-full art:px-2.5 art:py-1 art:text-xs art:font-medium art:bg-accent/20 art:text-foreground\">\n                          {\"Our pick\"}\n                        </span>\n                      </div>\n                      <div className=\"art:flex art:flex-col art:items-center art:gap-3\">\n                        <span className=\"art:flex art:size-10 art:items-center art:justify-center art:rounded-full art:bg-muted\">\n                          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-boxes art:size-5\" aria-hidden=\"true\">\n                            <path d=\"M2.97 12.92A2 2 0 0 0 2 14.63v3.24a2 2 0 0 0 .97 1.71l3 1.8a2 2 0 0 0 2.06 0L12 19v-5.5l-5-3-4.03 2.42Z\"/>\n                            <path d=\"m7 16.5-4.74-2.85\"/>\n                            <path d=\"m7 16.5 5-3\"/>\n                            <path d=\"M7 16.5v5.17\"/>\n                            <path d=\"M12 13.5V19l3.97 2.38a2 2 0 0 0 2.06 0l3-1.8a2 2 0 0 0 .97-1.71v-3.24a2 2 0 0 0-.97-1.71L17 10.5l-5 3Z\"/>\n                            <path d=\"m17 16.5-5-3\"/>\n                            <path d=\"m17 16.5 4.74-2.85\"/>\n                            <path d=\"M17 16.5v5.17\"/>\n                            <path d=\"M7.97 4.42A2 2 0 0 0 7 6.13v4.37l5 3 5-3V6.13a2 2 0 0 0-.97-1.71l-3-1.8a2 2 0 0 0-2.06 0l-3 1.8Z\"/>\n                            <path d=\"M12 8 7.26 5.15\"/>\n                            <path d=\"m12 8 4.74-2.85\"/>\n                            <path d=\"M12 13.5V8\"/>\n                          </svg>\n                        </span>\n                        <span className=\"art:break-words art:text-xl art:font-medium\">\n                          {\"Workspace\"}\n                        </span>\n                      </div>\n                    </th>\n                    <th scope=\"col\" className=\"art:px-4 art:pb-6 art:pt-4 art:text-center art:align-top\">\n                      <div className=\"art:mb-4 art:flex art:h-6 art:items-center art:justify-center\">\n                        <span className=\"art:rounded-full art:px-2.5 art:py-1 art:text-xs art:font-medium art:text-muted-foreground\">\n                          {\"Alternative\"}\n                        </span>\n                      </div>\n                      <div className=\"art:flex art:flex-col art:items-center art:gap-3\">\n                        <span className=\"art:flex art:size-10 art:items-center art:justify-center art:rounded-full art:bg-muted\">\n                          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-layers art:size-5\" aria-hidden=\"true\">\n                            <path d=\"M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z\"/>\n                            <path d=\"M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12\"/>\n                            <path d=\"M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17\"/>\n                          </svg>\n                        </span>\n                        <span className=\"art:break-words art:text-xl art:font-medium\">\n                          {\"Option A\"}\n                        </span>\n                      </div>\n                    </th>\n                    <th scope=\"col\" className=\"art:px-4 art:pb-6 art:pt-4 art:text-center art:align-top\">\n                      <div className=\"art:mb-4 art:flex art:h-6 art:items-center art:justify-center\">\n                        <span className=\"art:rounded-full art:px-2.5 art:py-1 art:text-xs art:font-medium art:text-muted-foreground\">\n                          {\"Alternative\"}\n                        </span>\n                      </div>\n                      <div className=\"art:flex art:flex-col art:items-center art:gap-3\">\n                        <span className=\"art:flex art:size-10 art:items-center art:justify-center art:rounded-full art:bg-muted\">\n                          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-panels-top-left art:size-5\" aria-hidden=\"true\">\n                            <rect width=\"18\" height=\"18\" x=\"3\" y=\"3\" rx=\"2\"/>\n                            <path d=\"M3 9h18\"/>\n                            <path d=\"M9 21V9\"/>\n                          </svg>\n                        </span>\n                        <span className=\"art:break-words art:text-xl art:font-medium\">\n                          {\"Option C\"}\n                        </span>\n                      </div>\n                    </th>\n                    <th scope=\"col\" className=\"art:px-4 art:pb-6 art:pt-4 art:text-center art:align-top\">\n                      <div className=\"art:mb-4 art:flex art:h-6 art:items-center art:justify-center\">\n                        <span className=\"art:rounded-full art:px-2.5 art:py-1 art:text-xs art:font-medium art:text-muted-foreground\">\n                          {\"Alternative\"}\n                        </span>\n                      </div>\n                      <div className=\"art:flex art:flex-col art:items-center art:gap-3\">\n                        <span className=\"art:flex art:size-10 art:items-center art:justify-center art:rounded-full art:bg-muted\">\n                          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-circle-dot art:size-5\" aria-hidden=\"true\">\n                            <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n                            <circle cx=\"12\" cy=\"12\" r=\"1\"/>\n                          </svg>\n                        </span>\n                        <span className=\"art:break-words art:text-xl art:font-medium\">\n                          {\"Option B\"}\n                        </span>\n                      </div>\n                    </th>\n                  </tr>\n                </thead>\n                <tbody>\n                  {FEATURES.map((feature, rowIndex) => (<tr key={feature.name}>\n                      <th scope=\"row\" className=\"art:sticky art:left-0 art:z-10 art:border-t art:border-border/60 art:bg-background art:px-4 art:py-4 art:text-left art:text-sm art:font-medium art:leading-6\">\n                        {feature.name}\n                      </th>\n                      {PRODUCTS.map((product) => {\n                const featured = product === FEATURED;\n                return (<td key={product} className={`art:px-4 art:py-4 art:text-center ${featured ? \"art:bg-accent/10\" : \"art:border-t art:border-border/60\"}`}>\n                            <motion.div initial={{ opacity: 0, scale: 0.9 }} whileInView={{ opacity: 1, scale: 1 }} viewport={{ once: true, amount: 0.5 }} transition={reduce ? INSTANT : { duration: CELL_DURATION, ease: ARTEMIS_EASE_OUT, delay: rowIndex * CELL_STAGGER }}>\n                              <Mark included={feature[product]} featured={featured}/>\n                            </motion.div>\n                          </td>);\n            })}\n                    </tr>))}\n                </tbody>\n                <tfoot>\n                  <tr>\n                    <th scope=\"row\" className=\"art:sticky art:left-0 art:z-10 art:border-t art:border-border/60 art:bg-background art:px-4 art:py-6 art:text-left art:text-xs art:font-medium art:text-muted-foreground\">\n                      {\"Features marked included\"}\n                    </th>\n                    {PRODUCTS.map((product) => (<td key={product} className={`art:px-4 art:py-6 art:text-center ${product === FEATURED ? \"art:rounded-b-2xl art:bg-accent/10\" : \"art:border-t art:border-border/60\"}`}>\n                        <span className=\"art:text-xl art:font-medium art:tabular-nums\">\n                          {FEATURES.filter((feature) => feature[product]).length}\n                        </span>\n                      </td>))}\n                  </tr>\n                </tfoot>\n              </table>\n            </section>\n            <p className=\"art:mt-6 art:inline-flex art:items-center art:gap-2 art:text-xs art:text-muted-foreground art:@min-[1024px]/artemis:hidden\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-arrow-left-right art:size-3.5\" aria-hidden=\"true\">\n                <path d=\"M8 3 4 7l4 4\"/>\n                <path d=\"M4 7h16\"/>\n                <path d=\"m16 21 4-4-4-4\"/>\n                <path d=\"M20 17H4\"/>\n              </svg>\n              {\"Scroll to compare all options\"}\n            </p>\n          </motion.div>\n          <p className=\"art:mt-5 art:text-center art:text-xs art:leading-5 art:text-muted-foreground\">\n            {\"Example comparison using illustrative products and features.\"}\n          </p>\n        </div>\n      </section>\n    </>);\n}\n"
    }
  ],
