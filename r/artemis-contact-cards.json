      "content": "\"use client\";\n// @zeus-internal\nimport { motion } from \"motion/react\";\nimport { inView as observeInView } from \"motion\";\nimport { useCallback, useEffect, useRef, type ReactNode } from \"react\";\nexport function Avatar({ active, delay, reduce, children }: {\n    active: boolean;\n    delay: number;\n    reduce: boolean | null;\n    children: ReactNode;\n}) {\n    const element = useRef<SVGGElement>(null);\n    const inView = useRef(false);\n    const currentScale = useRef(1);\n    const renderScale = useCallback(() => {\n        if (element.current) {\n            element.current.style.transform = currentScale.current === 1 ? \"none\" : `scale(${currentScale.current})`;\n        }\n    }, []);\n    useEffect(() => {\n        const illustration = element.current?.ownerSVGElement;\n        if (!illustration)\n            return;\n        return observeInView(illustration, () => {\n            inView.current = true;\n            return () => {\n                inView.current = false;\n                renderScale();\n            };\n        });\n    }, [renderScale]);\n    const updateScale = (scale: number) => {\n        currentScale.current = scale;\n        if (!inView.current)\n            renderScale();\n    };\n    return (<motion.g ref={element} initial={false} animate={{ scale: active ? [1, 1.12, 1] : 1 }} transition={reduce ? { duration: 0, onUpdate: updateScale } : active\n            ? { duration: 1.6, delay, ease: \"easeOut\", repeat: Infinity, onUpdate: updateScale }\n            : { type: \"spring\", stiffness: 480, damping: 24, mass: 0.7, onUpdate: updateScale }} style={{ transformBox: \"fill-box\", transformOrigin: \"50% 50%\" }}>\n      {children}\n    </motion.g>);\n}\n"
