font-medium art:text-sm\">\n                    {\"Open a ticket\"}\n                    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\" className=\"art:lucide art:lucide-arrow-up-right art:size-4 art:transition-transform art:group-hover:-translate-y-0.5 art:group-hover:translate-x-0.5\" aria-hidden=\"true\">\n                      <path d=\"M7 7h10v10\"/>\n                      <path d=\"M7 17 17 7\"/>\n                    </svg>\n                  </span>\n                </div>\n              </motion.a>\n              <motion.a onPointerEnter={() => activateCard(2, true)} onPointerLeave={() => activateCard(2, false)} onFocus={() => activateCard(2, true)} onBlur={() => activateCard(2, false)} className=\"art:group art:flex art:flex-col art:rounded-3xl art:border art:border-border art:bg-background art:p-2 art:outline-none art:transition-colors art:hover:border-foreground/20 art:focus-visible:ring-2 art:focus-visible:ring-ring\" href=\"#\" initial={reduce ? false : { opacity: 0, y: 14 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true }} transition={{ duration: reduce ? 0 : 0.5, ease: ARTEMIS_EASE_OUT, delay: reduce ? 0 : 0.16 }}>\n                <div className=\"art:grid art:h-40 art:place-items-center art:rounded-2xl art:bg-muted\">\n                  <svg aria-hidden=\"true\" className=\"art:h-full art:w-full\" fill=\"none\" viewBox=\"0 0 300 140\">\n                    <defs>\n                      <clipPath id={`${artemisInstanceId}-R_1n9bsnpfdb_-0`}>\n                        <circle cx=\"70\" cy=\"40\" r=\"13\"/>\n                      </clipPath>\n                      <clipPath id={`${artemisInstanceId}-R_1n9bsnpfdb_-1`}>\n                        <circle cx=\"230\" cy=\"34\" r=\"13\"/>\n                      </clipPath>\n                      <clipPath id={`${artemisInstanceId}-R_1n9bsnpfdb_-2`}>\n  