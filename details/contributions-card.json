\"2026-10-13\", 4],\n  [\"2026-10-23\", 6],\n  [\"2026-11-02\", 12],\n  [\"2026-11-12\", 3],\n  [\"2026-11-21\", 3],\n  [\"2026-12-01\", 10],\n  [\"2026-12-11\", 15],\n  [\"2026-12-21\", 0],\n  [\"2026-12-31\", 2],\n];\nexport const CONTRIBUTIONS_DATA: ContributionDay[] = DEMO_CELLS.map(([date, value]) => ({\n  date,\n  value,\n}));\nconst RANGES: ContributionsRange[] = [\n  { id: \"weekly\", label: \"Weekly\", data: CONTRIBUTIONS_DATA, headline: 958, delta: 0.148 },\n  {\n    id: \"monthly\",\n    label: \"Monthly\",\n    data: CONTRIBUTIONS_DATA,\n    headline: 958,\n    delta: 0.148,\n  },\n  {\n    id: \"yearly\",\n    label: \"Yearly\",\n    data: CONTRIBUTIONS_DATA,\n    headline: 958,\n    delta: 0.148,\n  },\n];\nconst STATS: ContributionStat[] = [\n  { label: \"Lifetime tokens\", value: \"9B\" },\n  { label: \"Peak tokens\", value: \"562.7M\" },\n  { label: \"Longest task\", value: \"12h 54m\" },\n  { label: \"Top streak\", value: \"62 days\" },\n];\nexport function ContributionsCard({\n  variant = \"card\",\n  title = \"Contributions this year\",\n  data,\n  ranges: supplied,\n  defaultRange,\n  onRangeChange,\n  stats = STATS,\n  color,\n  className,\n  headline,\n  delta,\n}: ContributionsCardProps = {}) {\n  const profile = variant === \"profile\";\n  const ranges = supplied ?? (data ? undefined : RANGES),\n    period = useChartRange(ranges, defaultRange, onRangeChange),\n    items = period.current?.data ?? data ?? CONTRIBUTIONS_DATA,\n    max = Math.max(1, ...items.map((d) => d.value)),\n    cols = Math.max(1, Math.ceil(items.length / 7));\n  return (\n    <ChartFrame\n      mountDuration={profile ? 1560 : undefined}\n      surface={!profile}\n      deltaColor={profile ? \"purple\" : undefined}\n      format={profile ? (n) => `$${Math.round(n).toLocaleString(\"en-US\")}` : undefined}\n      title={title}\n      value={period.current?.headline ?? headline ?? sum(items.map((d) => d.value))}\n      delta={period.current?.delta ?? delta}\n      padding=\"uniform\"\n      tabular={profile}\n      className={cx(\n        profile ? \"flex-none gap-2\" : \"h-auto flex-1 overflow-hidden sm:h-[337px]\",\n        className,\n      )}\n    >\n      <SummaryTiles items={stats} variant={profile ? \"profile\" : \"chart\"} />\n      <div className={profile ? \"contents\" : \"-mt-2 flex min-h-0 w-full flex-1 flex-col gap-1\"}>\n        <div className={cx(\"flex w-full items-center justify-between\", profile && \"pt-1.5 ps-0.5\")}>\n          <p\n            className={cx(\n              \"text-text-secondary\",\n              profile ? \"text-body-2-medium\" : \"text-body-medium\",\n            )}\n          >\n            Activity\n          </p>\n          {ranges && (\n            <PeriodTabs ranges={ranges} selected={period.id} onChange={period.select} plain />\n          )}\n        </div>\n        <div\n          className={\n            profile\n              ? \"flex w-full overflow-x-auto sm:overflow-visible\"\n              : \"flex min-h-0 w-full flex-1 flex-col gap-1.5 overflow-x-auto sm:overflow-visible\"\n          }\n        >\n          <div className=\"flex w-max flex-col gap-1.5 sm:w-full\">\n            <div\n              data-accent={profile ? \"violet\" : undefined}\n              className={cx(\n                \"grid grid-cols-[repeat(var(--contribution-columns),13px)] gap-1 sm:grid-cols-[repeat(var(--contribution-columns),minmax(0,1fr))]\",\n                profile && \"contributions-grid w-max sm:w-full\",\n              )}\n              style={{ \"--contribution-columns\": cols } as CSSProperties}\n            >\n              {items.map((day) => {\n                const tier =\n                  day.value <= 0\n                    ? 0\n                    : day.value <= 4\n                      ? 1\n                      : day.value <= 9\n                        ? 2\n                        : day.value <= 15\n                          ? 3\n                          : day.value <= 24\n                            ? 4\n                            : 5;\n                const date = new Date(day.date + \"T00:00:00Z\");\n                const label = Number.isNaN(date.getTime())\n                  ? day.date\n                  : date.toLocaleDateString(\"en-US\", {\n                      month: \"short\",\n                      day: \"numeric\",\n                      timeZone: \"UTC\",\n                    });\n                const message = `${day.value === 0 ? \"No contributions\" : `${day.value} contribution${day.value === 1 ? \"\" : \"s\"}`} on ${label}`;\n                return (\n                  <ChartCell\n                    key={day.date}\n                    aria-label={message}\n                    tooltip={message}\n                    excludeFromTabOrder\n                    data-tier={tier}\n                    className={cx(\n                      \"aspect-square w-full rounded-[3px]\",\n                      profile && \"contribution-cell\",\n                      profile && day.value > 0 && \"animate-cell-pop\",\n                    )}\n                    style={{\n                      animationDelay:\n                        profile && day.value > 0 ? `${day.delayMs ?? 0}ms` : undefined,\n                      background: profile\n                        ? undefined\n                        : day.value > 0 && color\n                          ? `color-mix(in srgb, ${color} ${20 + safeRatio(day.value, max) * 80}%, var(--color-background-inner-default))`\n                          : CONTRIBUTION_COLORS[tier],\n                    }}\n                  />\n                );\n              })}\n            </div>\n            {!profile && (\n              <div className=\"flex w-full justify-between text-body-2-medium text-text-tertiary\">\n                {MONTHS.map((month) => (\n                  <span key={month}>{month}</span>\n                ))}\n              </div>\n            )}\n          </div>\n        </div>\n      </div>\n    </ChartFrame>\n  );\n}\n"}],"controls":null,"hint":null,"component":null}