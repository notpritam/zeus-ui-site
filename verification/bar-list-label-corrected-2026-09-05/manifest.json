[
  {
    "id": "bar-list-card",
    "title": "Bar List",
    "category": "charts",
    "tier": "pro",
    "reference": {
      "url": "https://www.boardui.com/components/bar-list-card",
      "root": {
        "selector": "#preview > div > div:last-child > div > section",
        "nth": 0
      },
      "setup": [
        {
          "type": "click",
          "target": {
            "role": "button",
            "name": "Decline"
          },
          "scope": "page",
          "optional": true,
          "optionalTimeoutMs": 2500,
          "reason": "Dismiss the documentation cookie banner through its Decline control before capture; it may mount after hydration."
        }
      ]
    },
    "local": {
      "url": "/components/bar-list-card",
      "root": {
        "selector": "#preview [role=\"tabpanel\"] > div > div > div > section",
        "nth": 0
      }
    },
    "frame": {
      "width": 448
    },
    "states": [
      {
        "id": "initial",
        "actions": [],
        "assertions": [
          {
            "type": "visible"
          }
        ]
      },
      {
        "id": "tab-browsers",
        "actions": [
          {
            "type": "click",
            "target": {
              "role": "tab",
              "name": "Browsers"
            }
          }
        ],
        "assertions": [
          {
            "type": "attribute",
            "target": {
              "role": "tab",
              "name": "Browsers"
            },
            "name": "aria-selected",
            "value": "true"
          },
          {
            "type": "text",
            "pattern": "Chrome\\s*53%\\s*Safari\\s*27%\\s*Firefox\\s*9%\\s*Edge\\s*6%\\s*Samsung\\s*Internet\\s*2%",
